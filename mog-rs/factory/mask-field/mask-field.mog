{
  "name": "Mask a delimited field",
  "summary": "Hide the middle of a field, keeping the last 4",
  "description": "Mask the middle of one delimited field, keeping a few leading and trailing characters. This mog masks the 2nd comma-field keeping its last 4 characters, for redacting a card or account number in a CSV column.",
  "tags": [
    "data",
    "redact",
    "pii",
    "csv"
  ],
  "steps": [
    {
      "action": "mask_field",
      "description": "Mask field 2, keep last 4",
      "options": {
        "field": 2,
        "delimiter": ",",
        "keep_end": 4
      }
    }
  ]
}
