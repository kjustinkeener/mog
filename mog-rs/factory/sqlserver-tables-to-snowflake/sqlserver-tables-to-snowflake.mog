{
  "name": "SQL Server (SSMS) to Snowflake table DDL",
  "summary": "Convert SQL Server table DDL to Snowflake",
  "description": "Convert a SQL Server SSMS 'Generate Scripts' / mssql-scripter table export to runnable Snowflake DDL. Turns sp_addextendedproperty 'MS_Description' into COMMENT ON TABLE / COLUMN, strips the SSMS server/session/DROP scaffolding, drops T-SQL [bracket] quoting and the dbo. qualifier, and keeps IDENTITY(seed,step) and PRIMARY KEY as real DDL. Function map: newid/newsequentialid->UUID_STRING, sysdatetime/getdate->CURRENT_TIMESTAMP, *utc*->SYSDATE. Type map: NVARCHAR(MAX)/VARCHAR(MAX)->VARCHAR, NVARCHAR(n)->VARCHAR(n), BIT->BOOLEAN, MONEY->NUMBER(19,4), DECIMAL/NUMERIC->NUMBER, UNIQUEIDENTIFIER->VARCHAR(36), VARBINARY/BINARY/IMAGE->BINARY, DATETIME2(n)/DATETIME/SMALLDATETIME->TIMESTAMP_NTZ, DATETIMEOFFSET(n)->TIMESTAMP_TZ. Flags constructs with no runnable Snowflake form as -- TODO(mog): PERSISTED computed columns, separate DEFAULT constraints, CHECK constraints, UNIQUE via ALTER, and secondary CREATE INDEX. Not a semantic transpiler.",
  "tags": [
    "sql",
    "mssql",
    "snowflake",
    "warehouse",
    "convert",
    "migration"
  ],
  "dependencies": [
    "mssql-strip-server-noise",
    "sql-finalize-whitespace"
  ],
  "steps": [
    {
      "section": "Normalize",
      "description": "Normalize to LF first so every later newline-sensitive regex is reliable. Output stays LF (standard for SQL scripts).",
      "action": "eol_lf"
    },
    {
      "section": "Extended Properties To Comment",
      "description": "sp_addextendedproperty 'MS_Description' on a COLUMN -> Snowflake COMMENT ON COLUMN table.column. Runs BEFORE the strip fragment (which would otherwise delete the extended-property calls) and before the TABLE rule so a column property is not mis-read as a table property. Leaves the trailing GO for the finalize pass to turn into ';'.",
      "action": "replace_regex",
      "options": {
        "find": "EXEC(?:UTE)?\\s+sys\\.sp_addextendedproperty\\s+@name\\s*=\\s*N'MS_Description'\\s*,\\s*@value\\s*=\\s*N'((?:[^']|'')*)'\\s*,[\\s\\S]*?@level1type\\s*=\\s*N'\\w+'\\s*,\\s*@level1name\\s*=\\s*N'([^']+)'\\s*,\\s*@level2type\\s*=\\s*N'COLUMN'\\s*,\\s*@level2name\\s*=\\s*N'([^']+)'",
        "replace_with": "COMMENT ON COLUMN ${2}.${3} IS '${1}'",
        "ignore_case": true
      }
    },
    {
      "description": "sp_addextendedproperty 'MS_Description' on a TABLE or VIEW -> Snowflake COMMENT ON TABLE object.",
      "action": "replace_regex",
      "options": {
        "find": "EXEC(?:UTE)?\\s+sys\\.sp_addextendedproperty\\s+@name\\s*=\\s*N'MS_Description'\\s*,\\s*@value\\s*=\\s*N'((?:[^']|'')*)'\\s*,[\\s\\S]*?@level1type\\s*=\\s*N'(?:TABLE|VIEW)'\\s*,\\s*@level1name\\s*=\\s*N'([^']+)'",
        "replace_with": "COMMENT ON TABLE ${2} IS '${1}'",
        "ignore_case": true
      }
    },
    {
      "section": "Strip Export Noise",
      "description": "Remove SSMS server/session/DROP scaffolding (object banners, SET options, CREATE/ALTER DATABASE, the guarded DROP phase, ALTER TABLE CHECK CONSTRAINT re-enables). Shared fragment; runs on the raw SSMS text while GO batches are intact. The extended-property step above already rewrote MS_Description, so nothing is lost here.",
      "action": "run_mog",
      "options": {
        "file": "mssql-strip-server-noise.mog"
      }
    },
    {
      "section": "Unsupported Objects",
      "description": "Snowflake has no secondary indexes: replace the whole CREATE [NON]CLUSTERED INDEX ... GO batch with a TODO. Runs before bracket-stripping so it can consume the full multi-line INCLUDE/WITH/ON PRIMARY batch in one match.",
      "action": "replace_regex",
      "options": {
        "find": "CREATE (?:UNIQUE )?(?:NONCLUSTERED |CLUSTERED )?INDEX \\[?(\\w+)\\]?[\\s\\S]*?\\nGO\\n",
        "replace_with": "-- TODO(mog): Snowflake has no secondary indexes; CREATE INDEX ${1} was dropped (define a clustering key on the table if the access pattern needs it).\n\n",
        "ignore_case": true
      }
    },
    {
      "section": "Quoting And Schema",
      "description": "Strip T-SQL square-bracket quoting: opening bracket.",
      "action": "replace",
      "options": {
        "find": "[",
        "replace_with": ""
      }
    },
    {
      "description": "Strip T-SQL square-bracket quoting: closing bracket.",
      "action": "replace",
      "options": {
        "find": "]",
        "replace_with": ""
      }
    },
    {
      "description": "Drop the dbo. schema qualifier so objects resolve in the active Snowflake schema.",
      "action": "replace",
      "options": {
        "find": "dbo.",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "description": "USE <db> + its GO -> a documenting comment (Snowflake selects a database/schema on the session, not with USE <db> in a DDL script).",
      "action": "replace_regex",
      "options": {
        "find": "USE (\\w+)\\nGO\\n",
        "replace_with": "-- Database: ${1}\n\n",
        "ignore_case": true
      }
    },
    {
      "section": "Functions",
      "description": "Map T-SQL builtins to Snowflake. Runs before the type maps so a sys*datetime* function name is never corrupted, and before the DEFAULT-constraint TODO so the flagged default text is already Snowflake-flavored. None of these keys is a substring of another (the trailing () differ), so replace_map is order-safe.",
      "action": "replace_map",
      "options": {
        "ignore_case": true,
        "map": {
          "newsequentialid()": "UUID_STRING()",
          "newid()": "UUID_STRING()",
          "sysdatetimeoffset()": "CURRENT_TIMESTAMP()",
          "sysutcdatetime()": "SYSDATE()",
          "sysdatetime()": "CURRENT_TIMESTAMP()",
          "getutcdate()": "SYSDATE()",
          "getdate()": "CURRENT_TIMESTAMP()"
        }
      }
    },
    {
      "section": "Types",
      "description": "datetimeoffset(n) -> TIMESTAMP_TZ(n) (keeps fractional-second precision). Run before datetime2/datetime.",
      "action": "replace_regex",
      "options": {
        "find": "datetimeoffset\\((\\d+)\\)",
        "replace_with": "TIMESTAMP_TZ(${1})",
        "ignore_case": true
      }
    },
    {
      "description": "bare datetimeoffset -> TIMESTAMP_TZ.",
      "action": "replace",
      "options": {
        "find": "datetimeoffset",
        "replace_with": "TIMESTAMP_TZ",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "datetime2(n) -> TIMESTAMP_NTZ(n).",
      "action": "replace_regex",
      "options": {
        "find": "datetime2\\((\\d+)\\)",
        "replace_with": "TIMESTAMP_NTZ(${1})",
        "ignore_case": true
      }
    },
    {
      "description": "bare datetime2 -> TIMESTAMP_NTZ.",
      "action": "replace",
      "options": {
        "find": "datetime2",
        "replace_with": "TIMESTAMP_NTZ",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "smalldatetime -> TIMESTAMP_NTZ (run before datetime; it contains 'datetime').",
      "action": "replace",
      "options": {
        "find": "smalldatetime",
        "replace_with": "TIMESTAMP_NTZ",
        "ignore_case": true
      }
    },
    {
      "description": "datetime (wall-clock) -> TIMESTAMP_NTZ (whole word, so it never bites an identifier or a residual function name). Produces TIMESTAMP_NTZ, which has no bare 'datetime' left to re-match.",
      "action": "replace",
      "options": {
        "find": "datetime",
        "replace_with": "TIMESTAMP_NTZ",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "uniqueidentifier -> VARCHAR(36) (Snowflake has no native GUID type; store the canonical 36-char string).",
      "action": "replace",
      "options": {
        "find": "uniqueidentifier",
        "replace_with": "VARCHAR(36)",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "bit -> BOOLEAN (whole word). Any 0/1 default is carried in the DEFAULT-constraint TODO below.",
      "action": "replace",
      "options": {
        "find": "bit",
        "replace_with": "BOOLEAN",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "nvarchar(max) -> VARCHAR (run before varchar(max), which it contains).",
      "action": "replace",
      "options": {
        "find": "nvarchar(max)",
        "replace_with": "VARCHAR",
        "ignore_case": true
      }
    },
    {
      "description": "varchar(max) -> VARCHAR (Snowflake VARCHAR defaults to the 16 MB max).",
      "action": "replace",
      "options": {
        "find": "varchar(max)",
        "replace_with": "VARCHAR",
        "ignore_case": true
      }
    },
    {
      "description": "nvarchar(n) -> VARCHAR(n) (Snowflake VARCHAR is already Unicode; no national type).",
      "action": "replace",
      "options": {
        "find": "nvarchar",
        "replace_with": "VARCHAR",
        "ignore_case": true
      }
    },
    {
      "description": "nchar -> CHAR.",
      "action": "replace",
      "options": {
        "find": "nchar",
        "replace_with": "CHAR",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "ntext -> VARCHAR (LOB text type).",
      "action": "replace",
      "options": {
        "find": "ntext",
        "replace_with": "VARCHAR",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "text -> VARCHAR.",
      "action": "replace",
      "options": {
        "find": "text",
        "replace_with": "VARCHAR",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "smallmoney -> NUMBER(10,4) (run before money).",
      "action": "replace",
      "options": {
        "find": "smallmoney",
        "replace_with": "NUMBER(10,4)",
        "ignore_case": true
      }
    },
    {
      "description": "money -> NUMBER(19,4).",
      "action": "replace",
      "options": {
        "find": "money",
        "replace_with": "NUMBER(19,4)",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "decimal -> NUMBER (Snowflake's canonical fixed-point type; precision/scale preserved).",
      "action": "replace",
      "options": {
        "find": "decimal",
        "replace_with": "NUMBER",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "numeric -> NUMBER.",
      "action": "replace",
      "options": {
        "find": "numeric",
        "replace_with": "NUMBER",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "varbinary(max) -> BINARY (run before varbinary(n)/binary).",
      "action": "replace",
      "options": {
        "find": "varbinary(max)",
        "replace_with": "BINARY",
        "ignore_case": true
      }
    },
    {
      "description": "varbinary(n) / bare varbinary -> BINARY.",
      "action": "replace_regex",
      "options": {
        "find": "\\bvarbinary(\\(\\d+\\))?",
        "replace_with": "BINARY",
        "ignore_case": true
      }
    },
    {
      "description": "binary(n) / bare binary -> BINARY.",
      "action": "replace_regex",
      "options": {
        "find": "\\bbinary(\\(\\d+\\))?",
        "replace_with": "BINARY",
        "ignore_case": true
      }
    },
    {
      "description": "image -> BINARY (legacy LOB).",
      "action": "replace",
      "options": {
        "find": "image",
        "replace_with": "BINARY",
        "whole_word": true,
        "ignore_case": true
      }
    },
    {
      "description": "Remaining scalar/spatial/semi-structured type renames: float/real -> FLOAT, xml/hierarchyid -> VARCHAR (no native type; flag for review), sql_variant -> VARIANT, geography/geometry -> GEOGRAPHY/GEOMETRY.",
      "action": "replace_map",
      "options": {
        "whole_word": true,
        "ignore_case": true,
        "map": {
          "float": "FLOAT",
          "real": "FLOAT",
          "xml": "VARCHAR",
          "hierarchyid": "VARCHAR",
          "sql_variant": "VARIANT",
          "geography": "GEOGRAPHY",
          "geometry": "GEOMETRY"
        }
      }
    },
    {
      "section": "Computed Columns",
      "description": "A T-SQL computed/PERSISTED column has no runnable Snowflake column form: drop the column and leave a TODO in its place (the trailing comma goes with it; the preceding column keeps its own comma).",
      "action": "replace_regex",
      "options": {
        "find": "(?m)^(\\s*)(\\w+)\\s+AS \\((.+?)\\)\\s+PERSISTED,?\\s*$",
        "replace_with": "${1}-- TODO(mog): computed column ${2} = (${3}) [PERSISTED] has no Snowflake column form; recreate it as a view or a downstream derived column.",
        "ignore_case": true
      }
    },
    {
      "section": "Drop Storage Markers",
      "description": "Drop any index/constraint storage-option clause: WITH (PAD_INDEX = ...).",
      "action": "replace_regex",
      "options": {
        "find": "WITH \\(PAD_INDEX[^)]*\\)",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "description": "Drop the CREATE TABLE filegroup placement 'ON PRIMARY TEXTIMAGE_ON PRIMARY'.",
      "action": "replace",
      "options": {
        "find": "ON PRIMARY TEXTIMAGE_ON PRIMARY",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "description": "Drop remaining ' ON PRIMARY' filegroup placement.",
      "action": "replace",
      "options": {
        "find": " ON PRIMARY",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "description": "Drop ' ASC' from inline key-column lists (Snowflake default; invalid inside a PRIMARY KEY column list).",
      "action": "replace",
      "options": {
        "find": " ASC",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "description": "Drop ' NONCLUSTERED' (no Snowflake equivalent).",
      "action": "replace",
      "options": {
        "find": " NONCLUSTERED",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "description": "Drop ' CLUSTERED' (Snowflake has no clustered-index syntax on a constraint).",
      "action": "replace",
      "options": {
        "find": " CLUSTERED",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "section": "Constraints",
      "description": "UNIQUE constraints added via ALTER TABLE are metadata-only in Snowflake and are not accepted by every target; flag the whole batch (fold UNIQUE inline into the CREATE TABLE if you want the metadata constraint). Runs after the storage/CLUSTERED cleanup so the batch is already tidy.",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+ ADD\\s+CONSTRAINT (\\w+) UNIQUE\\s*\\(\\s*(\\w+)\\s*\\)\\s*\\nGO\\n",
        "replace_with": "-- TODO(mog): Snowflake keys are metadata-only and ALTER ADD UNIQUE is not portable here; fold UNIQUE (${2}) into the CREATE TABLE for constraint ${1}.\n\n",
        "ignore_case": true
      }
    },
    {
      "description": "CHECK constraints are unsupported in Snowflake: flag the ALTER ... WITH CHECK ADD CONSTRAINT ... CHECK batch (enforce the rule in ELT or a view instead).",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+\\s+WITH CHECK ADD\\s+CONSTRAINT (\\w+) CHECK\\s+(\\(.+\\))\\nGO\\n",
        "replace_with": "-- TODO(mog): Snowflake does not support CHECK constraints; enforce ${1} ${2} in ELT or a view (dropped).\n\n",
        "ignore_case": true
      }
    },
    {
      "description": "SSMS scripts column defaults as separate ALTER TABLE ADD CONSTRAINT DEFAULT batches. Snowflake ALTER COLUMN SET DEFAULT accepts only a sequence, so flag each with the (already Snowflake-flavored) default expression to fold inline into the CREATE TABLE.",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+ ADD\\s+CONSTRAINT \\w+\\s+DEFAULT \\((.+)\\) FOR (\\w+)\\nGO\\n",
        "replace_with": "-- TODO(mog): set DEFAULT ${1} inline on column ${2} in the CREATE TABLE (Snowflake ALTER COLUMN SET DEFAULT accepts only sequences).\n\n",
        "ignore_case": true
      }
    },
    {
      "section": "Finalize",
      "description": "Snowflake export idiom: CREATE TABLE -> CREATE OR REPLACE TABLE (idempotent redeploys).",
      "action": "replace",
      "options": {
        "find": "CREATE TABLE ",
        "replace_with": "CREATE OR REPLACE TABLE ",
        "ignore_case": true
      }
    },
    {
      "description": "Turn each remaining GO batch separator into a statement terminator plus a blank line (CREATE TABLE, the PRIMARY KEY ALTER, and the COMMENT ON statements).",
      "action": "replace_regex",
      "options": {
        "find": "\\nGO\\n",
        "replace_with": ";\n\n",
        "ignore_case": true
      }
    },
    {
      "description": "Canonical whitespace finalize via the shared fragment: collapse the double spaces left by dropped markers, tidy spaces before ';', strip trailing whitespace, and collapse blank-line runs.",
      "action": "run_mog",
      "options": {
        "file": "sql-finalize-whitespace.mog",
        "with": {
          "tidy_chars": ";"
        }
      }
    }
  ]
}
