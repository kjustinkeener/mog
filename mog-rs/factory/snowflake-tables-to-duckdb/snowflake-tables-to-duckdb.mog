{
  "name": "Snowflake GET_DDL to DuckDB",
  "summary": "Convert a Snowflake GET_DDL table export to DuckDB DDL",
  "description": "Convert Snowflake GET_DDL('TABLE', ...) output to DuckDB DDL. Drops the trailing semicolon and the Snowflake-only cluster-by (flagged), table-comment, column-comment, and autoincrement renderings, maps types to DuckDB (NUMBER(38,0)->BIGINT, NUMBER(p,s)->DECIMAL(p,s), VARIANT/OBJECT/ARRAY->JSON, TIMESTAMP_NTZ->TIMESTAMP, TIMESTAMP_TZ/LTZ->TIMESTAMPTZ), and normalizes the create-or-replace verb. Expects one table's GET_DDL output. Not a semantic transpiler; leaves TODO(mog) markers where a construct needs manual review.",
  "tags": [
    "sql",
    "snowflake",
    "duckdb",
    "warehouse",
    "convert",
    "migration"
  ],
  "steps": [
    { "action": "eol_lf", "description": "Normalize to LF." },
    { "action": "replace", "description": "Drop statement terminators (single-statement export).",
      "options": { "find": ";", "replace_with": "" } },
    { "section": "Physical clauses", "action": "replace_regex",
      "description": "Snowflake cluster by -> TODO (DuckDB has no clustering).",
      "options": { "find": "(?mi)^cluster by \\(([^)]*)\\)", "replace_with": "-- TODO(mog): dropped Snowflake CLUSTER BY ($1) (DuckDB has no clustering)" } },
    { "section": "Columns", "action": "replace_regex",
      "description": "Drop Snowflake autoincrement rendering (set identity via a DuckDB sequence if needed).",
      "options": { "find": " autoincrement start \\d+ increment \\d+", "replace_with": "" } },
    { "section": "Columns", "action": "replace_regex",
      "description": "Drop inline column COMMENT 'x' (DuckDB uses COMMENT ON).",
      "options": { "find": " COMMENT '[^']*'", "replace_with": "" } },
    { "section": "Columns", "action": "replace_regex",
      "description": "Drop the glued table )COMMENT='x'.",
      "options": { "find": "\\)COMMENT='[^']*'", "replace_with": ")" } },
    { "section": "Types", "action": "replace_map",
      "description": "Snowflake semi-structured types -> DuckDB JSON.",
      "options": { "whole_word": true, "map": { "VARIANT": "JSON", "OBJECT": "JSON", "ARRAY": "JSON" } } },
    { "section": "Types", "action": "replace_regex",
      "description": "NUMBER(38,0) (Snowflake default integer) -> BIGINT.",
      "options": { "find": "\\bNUMBER\\(38,\\s*0\\)", "replace_with": "BIGINT" } },
    { "section": "Types", "action": "replace_regex",
      "description": "NUMBER(p,s) -> DECIMAL(p,s).",
      "options": { "find": "\\bNUMBER\\(", "replace_with": "DECIMAL(" } },
    { "section": "Types", "action": "replace_regex",
      "description": "Bare NUMBER -> BIGINT.",
      "options": { "find": "\\bNUMBER\\b", "replace_with": "BIGINT" } },
    { "section": "Types", "action": "replace_regex",
      "description": "TIMESTAMP_NTZ(n) -> TIMESTAMP (wall-clock).",
      "options": { "find": "\\bTIMESTAMP_NTZ(\\(\\d+\\))?", "replace_with": "TIMESTAMP" } },
    { "section": "Types", "action": "replace_regex",
      "description": "TIMESTAMP_TZ / TIMESTAMP_LTZ -> TIMESTAMPTZ (instant).",
      "options": { "find": "\\bTIMESTAMP_(?:LTZ|TZ)(\\(\\d+\\))?", "replace_with": "TIMESTAMPTZ" } },
    { "section": "Statement", "action": "replace",
      "description": "Normalize the mixed-case verb.",
      "options": { "find": "create or replace TABLE ", "replace_with": "CREATE OR REPLACE TABLE " } }
  ]
}
