{
  "name": "Case-preserving find/replace",
  "summary": "Rename a word while matching the surrounding case",
  "description": "Literal find/replace that casts the replacement to match the case of each occurrence: 'color' -> 'colour', 'Color' -> 'Colour', 'COLOR' -> 'COLOUR'. Handy for renaming an identifier or spelling variant without a separate pass per casing.",
  "tags": [
    "case",
    "replace",
    "codemod",
    "single-action"
  ],
  "steps": [
    {
      "action": "smart_case_replace",
      "description": "Replace 'color' with 'colour', preserving case",
      "options": {
        "find": "color",
        "replace_with": "colour"
      }
    }
  ]
}
