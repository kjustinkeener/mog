{
  "name": "Avro schema to JSON Schema",
  "description": "Convert an Avro record schema (.avsc) into a draft-07 JSON Schema object. Maps scalar Avro types (long/int -> integer, float/double -> number, boolean -> boolean, bytes/string -> string) and turns a nullable union (['null', T] or [T, 'null']) into a ['type', 'null'] union. Line/regex based, not an Avro parser: assumes one field object per line and does not handle nested records, arrays, maps, enums, fixed, logical types, defaults, doc, aliases, or namespaces.",
  "summary": "Convert Avro schema to draft-07 JSON Schema",
  "tags": [
    "convert",
    "schema",
    "avro",
    "json"
  ],
  "steps": [
    {
      "section": "Normalize",
      "description": "Normalize line endings to LF so the per-line field regexes are reliable.",
      "action": "eol_lf"
    },
    {
      "section": "Fields to properties",
      "description": "Nullable union field ['null', T]: emit a JSON Schema property with a [type, 'null'] union. The scalar type is tagged @T@ for the type map below.",
      "action": "replace_regex_multiline",
      "options": {
        "find": "^\\s*\\{\\s*\"name\":\\s*\"([A-Za-z0-9_]+)\",\\s*\"type\":\\s*\\[\\s*\"null\",\\s*\"([a-z]+)\"\\s*\\]\\s*\\},?\\s*$",
        "replace_with": "    \"$1\": { \"type\": [\"@$2@\", \"null\"] },"
      }
    },
    {
      "description": "Nullable union field [T, 'null']: same result, other order.",
      "action": "replace_regex_multiline",
      "options": {
        "find": "^\\s*\\{\\s*\"name\":\\s*\"([A-Za-z0-9_]+)\",\\s*\"type\":\\s*\\[\\s*\"([a-z]+)\",\\s*\"null\"\\s*\\]\\s*\\},?\\s*$",
        "replace_with": "    \"$1\": { \"type\": [\"@$2@\", \"null\"] },"
      }
    },
    {
      "description": "Plain scalar field: emit a JSON Schema property with a single tagged @T@ type.",
      "action": "replace_regex_multiline",
      "options": {
        "find": "^\\s*\\{\\s*\"name\":\\s*\"([A-Za-z0-9_]+)\",\\s*\"type\":\\s*\"([a-z]+)\"\\s*\\},?\\s*$",
        "replace_with": "    \"$1\": { \"type\": \"@$2@\" },"
      }
    },
    {
      "section": "Type map",
      "description": "Map the tagged Avro scalar types to JSON Schema types (longest key wins, so @int@ and @bytes@ are safe).",
      "action": "replace_map",
      "options": {
        "map": {
          "@boolean@": "boolean",
          "@int@": "integer",
          "@long@": "integer",
          "@float@": "number",
          "@double@": "number",
          "@bytes@": "string",
          "@string@": "string"
        }
      }
    },
    {
      "section": "Reshape header",
      "description": "Avro record type -> JSON Schema object type.",
      "action": "replace",
      "options": {
        "find": "\"type\": \"record\",",
        "replace_with": "\"type\": \"object\","
      }
    },
    {
      "description": "Record name -> schema title (field 'name' lines are already converted, so only the record name remains).",
      "action": "replace_regex_multiline",
      "options": {
        "find": "^\\s*\"name\":\\s*\"([^\"]+)\",\\s*$",
        "replace_with": "  \"title\": \"$1\","
      }
    },
    {
      "description": "Open the properties object in place of the fields array.",
      "action": "replace",
      "options": {
        "find": "\"fields\": [",
        "replace_with": "\"properties\": {"
      }
    },
    {
      "description": "Close the properties object in place of the fields array bracket.",
      "action": "replace_regex_multiline",
      "options": {
        "find": "^  \\]\\s*$",
        "replace_with": "  }"
      }
    },
    {
      "section": "Finalize JSON",
      "description": "Drop the trailing comma after the last property so the output is valid JSON.",
      "action": "replace_regex",
      "options": {
        "find": ",(\\n\\s*\\})",
        "replace_with": "$1"
      }
    }
  ]
}
