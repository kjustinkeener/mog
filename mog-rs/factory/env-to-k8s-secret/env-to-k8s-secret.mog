{
  "name": ".env to k8s Secret",
  "description": "Turn a .env file into a Kubernetes Secret manifest (YAML) with each value base64-encoded under data, as a Secret requires (the ConfigMap sibling keeps values plain). Set the name with -D name=... (default app-secret). Comments (# lines) and blank lines are dropped; optional `export ` and surrounding quotes are stripped from each value; the first = splits key from value so values that themselves contain = are encoded whole.",
  "summary": "Convert .env to a base64 Kubernetes Secret",
  "tags": [
    "convert",
    "env",
    "dotenv",
    "k8s",
    "secrets",
    "base64",
    "yaml"
  ],
  "constants": {
    "name": "app-secret"
  },
  "steps": [
    {
      "section": "Keep only KEY=VALUE lines",
      "action": "remove_lines_matching",
      "description": "Drop comment lines (# ...).",
      "options": {
        "pattern": "^\\s*#"
      }
    },
    {
      "action": "remove_empty_lines",
      "description": "Drop blank lines."
    },
    {
      "section": "Split key from value on the first =",
      "action": "replace_regex_multiline",
      "description": "Normalize to KEY<tab>VALUE: strip optional `export ` and whitespace around the first =.",
      "options": {
        "find": "^\\s*(?:export\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(.*)$",
        "replace_with": "$1\t$2"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Strip a matching pair of surrounding double or single quotes from the value.",
      "options": {
        "find": "\t\"(.*)\"$",
        "replace_with": "\t$1"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Strip a matching pair of surrounding single quotes from the value.",
      "options": {
        "find": "\t'(.*)'$",
        "replace_with": "\t$1"
      }
    },
    {
      "section": "Base64-encode each value",
      "action": "base64_encode",
      "description": "Encode only the value field (right of the tab); keys stay plain.",
      "scope": {
        "field": {
          "index": 2,
          "delimiter": "\t"
        }
      }
    },
    {
      "section": "Render the Secret manifest",
      "action": "replace_regex_multiline",
      "description": "Indent each KEY<tab>VALUE two spaces under data as KEY: VALUE.",
      "options": {
        "find": "^([A-Za-z_][A-Za-z0-9_]*)\t(.*)$",
        "replace_with": "  $1: $2"
      }
    },
    {
      "action": "prepend",
      "description": "Add the Secret envelope above the data block.",
      "options": {
        "text": "apiVersion: v1\nkind: Secret\nmetadata:\n  name: {{name}}\ntype: Opaque\ndata:\n"
      }
    }
  ]
}
