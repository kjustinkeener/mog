{
  "name": "Strip ClickHouse SHOW CREATE TABLE noise",
  "summary": "Remove ClickHouse engine, physical, and identifier noise from SHOW CREATE",
  "description": "Strip the ClickHouse-specific rendering that SHOW CREATE TABLE adds, so a downstream dialect converter sees a clean CREATE TABLE column list. Normalizes to LF, drops backtick identifier quoting, unqualifies the CREATE TABLE database prefix (default.table -> table), turns the closing engine paren into a statement terminator, and removes the physical/storage clauses that have no portable target-DDL equivalent: ENGINE=..., PRIMARY KEY (ClickHouse sparse index), SAMPLE BY, TTL, SETTINGS, and any table-level COMMENT. The layout-encoding ORDER BY (sort key) and PARTITION BY clauses are preserved as -- TODO(mog): comments rather than silently dropped. Target-agnostic; run it first. Leaves ClickHouse column TYPES intact for the downstream type map.",
  "tags": ["sql", "clickhouse", "strip", "migration", "fragment"],
  "steps": [
    { "action": "eol_lf", "description": "Normalize to LF so every later regex is reliable." },
    { "action": "replace", "description": "Drop backtick identifier quoting (ClickHouse quotes every column name).",
      "options": { "find": "`", "replace_with": "" } },
    { "action": "replace_regex", "description": "Unqualify the CREATE TABLE database prefix (e.g. default.orders -> orders); resolves via search_path in the target.",
      "options": { "find": "(?im)^(CREATE TABLE )[A-Za-z0-9_]+\\.", "replace_with": "${1}" } },
    { "action": "replace_regex", "description": "Preserve the ClickHouse ORDER BY (sort / sparse-primary key) as a TODO comment; it encodes physical layout with no Postgres table-DDL equivalent.",
      "options": { "find": "(?im)^ORDER BY (.*)$", "replace_with": "-- TODO(mog): ClickHouse ORDER BY (sort key) has no Postgres table-DDL equivalent; original ORDER BY ${1}" } },
    { "action": "replace_regex", "description": "Preserve the ClickHouse PARTITION BY expression as a TODO comment (physical partitioning is not part of a Postgres CREATE TABLE).",
      "options": { "find": "(?im)^PARTITION BY (.*)$", "replace_with": "-- TODO(mog): ClickHouse PARTITION BY not represented in Postgres table DDL; original PARTITION BY ${1}" } },
    { "action": "replace_regex", "description": "Drop the ENGINE = ... clause (MergeTree/ReplacingMergeTree/Log/etc); no Postgres equivalent.",
      "options": { "find": "(?im)^ENGINE = [^\\n]*\\n?", "replace_with": "" } },
    { "action": "replace_regex", "description": "Drop the ClickHouse table-level PRIMARY KEY (a sparse index, not a uniqueness constraint).",
      "options": { "find": "(?im)^PRIMARY KEY [^\\n]*\\n?", "replace_with": "" } },
    { "action": "replace_regex", "description": "Drop SAMPLE BY (sampling expression; no Postgres equivalent).",
      "options": { "find": "(?im)^SAMPLE BY [^\\n]*\\n?", "replace_with": "" } },
    { "action": "replace_regex", "description": "Drop table-level TTL (data-expiry policy; use a Postgres job/partition drop instead).",
      "options": { "find": "(?im)^TTL [^\\n]*\\n?", "replace_with": "" } },
    { "action": "replace_regex", "description": "Drop the SETTINGS clause (index_granularity, etc; engine tuning with no Postgres analog).",
      "options": { "find": "(?im)^SETTINGS [^\\n]*\\n?", "replace_with": "" } },
    { "action": "replace_regex", "description": "Drop a trailing table-level COMMENT clause (kept runnable; re-add via COMMENT ON TABLE by hand if desired).",
      "options": { "find": "(?im)^COMMENT '[^']*'\\s*\\n?", "replace_with": "" } },
    { "action": "replace_regex", "description": "Turn the closing engine paren into a statement terminator.",
      "options": { "find": "(?m)^\\)$", "replace_with": ");" } },
    { "action": "replace_regex", "description": "Collapse blank-line runs left by removed clauses to a single blank line.",
      "options": { "find": "\\n{3,}", "replace_with": "\n\n" } },
    { "action": "trim_whitespace_right", "description": "Tidy any trailing spaces the removals left." }
  ]
}
