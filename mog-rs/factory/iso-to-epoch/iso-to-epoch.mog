{
  "name": "Convert ISO dates to epoch",
  "description": "Rewrite the ISO date/datetime in a delimited log/CSV to a Unix-epoch number (seconds, UTC), leaving the other columns alone. Defaults to column 1; set field for a different column, or unit to millis. Values that do not parse and empty cells pass through. The inverse of log-epoch-to-iso.",
  "summary": "Convert ISO dates to Unix epoch",
  "tags": [
    "data",
    "time",
    "date",
    "csv"
  ],
  "steps": [
    {
      "action": "iso_to_epoch",
      "description": "Column 1 ISO datetime -> epoch seconds",
      "options": { "field": 1, "unit": "seconds" }
    }
  ]
}
