{
  "name": "MySQL SHOW CREATE TABLE to Snowflake",
  "summary": "Convert a MySQL table export to Snowflake DDL",
  "description": "Convert MySQL 'SHOW CREATE TABLE' output to Snowflake. Strips MySQL storage noise (ENGINE/CHARSET/COLLATE, backticks, DEFAULT NULL, ON UPDATE), then maps MySQL types to Snowflake: tinyint(1)->BOOLEAN, datetime->TIMESTAMP_NTZ, timestamp->TIMESTAMP_LTZ, text->VARCHAR, json->VARIANT, enum(...)->VARCHAR (value set flagged), and AUTO_INCREMENT->AUTOINCREMENT. Minimal-diff, NOT a semantic transpiler. Validated by executing the result in a real Snowflake engine (fakesnow).",
  "tags": ["sql", "mysql", "snowflake", "warehouse", "convert", "migration"],
  "dependencies": ["strip-mysql-ddl-noise"],
  "steps": [
    { "section": "Strip export noise", "action": "run_mog",
      "options": { "file": "strip-mysql-ddl-noise.mog" } },
    { "section": "Types", "action": "replace_regex", "description": "tinyint(1) is MySQL's boolean -> BOOLEAN.",
      "options": { "find": "(?i)\\btinyint\\(1\\)", "replace_with": "BOOLEAN" } },
    { "section": "Types", "action": "replace_regex", "description": "datetime (wall-clock) -> TIMESTAMP_NTZ.",
      "options": { "find": "(?i)\\bdatetime\\b", "replace_with": "TIMESTAMP_NTZ" } },
    { "section": "Types", "action": "replace_regex", "description": "timestamp (instant) -> TIMESTAMP_LTZ.",
      "options": { "find": "(?i)\\btimestamp\\b", "replace_with": "TIMESTAMP_LTZ" } },
    { "section": "Types", "action": "replace_regex", "description": "text -> VARCHAR.",
      "options": { "find": "(?i)\\btext\\b", "replace_with": "VARCHAR" } },
    { "section": "Types", "action": "replace_regex", "description": "json -> VARIANT.",
      "options": { "find": "(?i)\\bjson\\b", "replace_with": "VARIANT" } },
    { "section": "Types", "action": "flag_matching", "description": "Flag ENUM (Snowflake has none; value constraint is lost).",
      "options": { "pattern": "(?i)enum\\(", "message": "MySQL ENUM converted to VARCHAR; the allowed-value constraint was lost (add a CHECK if needed)", "comment": "--", "tag": "TODO", "position": "inline" } },
    { "section": "Types", "action": "replace_regex", "description": "enum(...) -> VARCHAR.",
      "options": { "find": "(?i)\\benum\\([^)]*\\)", "replace_with": "VARCHAR" } },
    { "section": "Columns", "action": "replace", "description": "MySQL AUTO_INCREMENT -> Snowflake AUTOINCREMENT.",
      "options": { "find": "AUTO_INCREMENT", "replace_with": "AUTOINCREMENT" } }
  ]
}
