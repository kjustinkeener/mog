{
  "name": "Snowflake tables to C# classes",
  "summary": "Generate C# POCO classes from a Snowflake GET_DDL export",
  "description": "Generate idiomatic C# POCO classes from a Snowflake table export (SELECT GET_DDL('TABLE', ...) or a Snowsight DDL copy), one class per table with an auto-property per column. Strips the Snowflake-only rendering (statement terminators, inline COMMENT 'x', the glued )COMMENT='x', cluster by, autoincrement, DEFAULT and table-level constraint lines), then rewrites each 'create or replace TABLE' into a 'public class'. Snowflake types map to C# types (NUMBER(p,0) p<=9 -> int, wider -> long, NUMBER(p,s) s>0 -> decimal, FLOAT/DOUBLE/REAL -> double, BOOLEAN -> bool, VARCHAR/STRING/TEXT/CHAR -> string, DATE -> DateOnly, TIME -> TimeOnly, TIMESTAMP_NTZ -> DateTime, TIMESTAMP_TZ/TIMESTAMP_LTZ -> DateTimeOffset, BINARY/VARBINARY -> byte[], VARIANT/OBJECT/ARRAY -> string holding raw JSON). Nullable columns (no NOT NULL) get a nullable type ('?'). Table and column identifiers are PascalCased from Snowflake's UPPER_SNAKE_CASE. Lossy mappings are flagged with a // TODO(mog): comment: semi-structured columns and NUMBER(p,0) wide enough to overflow long. Assumes LF.",
  "tags": [
    "sql",
    "snowflake",
    "csharp",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-snowflake-getddl-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove the Snowflake GET_DDL rendering: statement terminators, inline column COMMENT 'x', the glued table )COMMENT='x', and the cluster by clause.",
      "options": {
        "file": "strip-snowflake-getddl-noise.mog"
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop the SQL comment lines the strip fragment leaves behind (the CLUSTER BY note).",
      "options": {
        "find": "(?m)^--[^\\n]*\\n?",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop table-level constraint lines (primary key, foreign key, unique, constraint).",
      "options": {
        "find": "(?mi)^[ \\t]*(?:primary key|foreign key|unique|constraint)\\b[^\\n]*\\n?",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Convert the tab indent GET_DDL emits to four spaces, so column lines have a fixed shape.",
      "options": {
        "find": "(?m)^\\t",
        "replace_with": "    "
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each 'create or replace TABLE <tbl> (' header.",
      "options": {
        "find": "(?mi)^create or replace (?:transient |temporary |volatile )?table (?:\\w+\\.)*(\\w+) \\($",
        "replace_with": "public class ${1}\n{"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ')' into a closing brace.",
      "options": {
        "find": "(?m)^\\)$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop the Snowflake autoincrement / identity clause.",
      "options": {
        "find": "(?i)\\s+(?:autoincrement|identity)(?:\\s+start\\s+-?\\d+\\s+increment\\s+-?\\d+)?(?:\\s+(?:no)?order)?",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop COLLATE clauses.",
      "options": {
        "find": "(?i)\\s+COLLATE\\s+'[^']*'",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses (sequences, CURRENT_TIMESTAMP(), literals).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag semi-structured VARIANT / OBJECT columns: mapped to string.",
      "options": {
        "pattern": "\\b(?:VARIANT|OBJECT)\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake semi-structured column; carried as raw JSON -- deserialize it if you know the shape.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag ARRAY columns: Snowflake arrays are untyped.",
      "options": {
        "pattern": "\\bARRAY\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake list column has no declared element type; deserialize it into a typed collection yourself.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag wide integers (NUMBER(p,0) with p >= 19): they can overflow long.",
      "options": {
        "pattern": "\\bNUMBER\\((?:19|2\\d|3\\d)\\s*,\\s*0\\)",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake column can exceed the signed 64-bit range; use System.Numerics.BigInteger if values can pass 9.2e18.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP_NTZ / DATETIME (wall-clock, no zone) -> DateTime.",
      "options": {
        "find": "(?i)\\b(?:TIMESTAMP_NTZ|DATETIME)(?:\\(\\d+\\))?",
        "replace_with": "DateTime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP_TZ / TIMESTAMP_LTZ (zone-aware) -> DateTimeOffset.",
      "options": {
        "find": "(?i)\\bTIMESTAMP_(?:L?TZ)(?:\\(\\d+\\))?",
        "replace_with": "DateTimeOffset"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare TIMESTAMP (the session default, normally NTZ) -> DateTime.",
      "options": {
        "find": "(?i)\\bTIMESTAMP(?:\\(\\d+\\))?",
        "replace_with": "DateTime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIME -> TimeOnly.",
      "options": {
        "find": "(?i)\\bTIME(?:\\(\\d+\\))?",
        "replace_with": "TimeOnly"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "DATE -> DateOnly.",
      "options": {
        "find": "(?i)\\bDATE\\b",
        "replace_with": "DateOnly"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,s) / DECIMAL(p,s) with s > 0 -> decimal (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\s*,\\s*[1-9]\\d*\\)",
        "replace_with": "@@NUMS@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p <= 9 -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\([1-9]\\s*,\\s*0\\)",
        "replace_with": "@@NUMI@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p between 10 and 18 -> long (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(1[0-8]\\s*,\\s*0\\)",
        "replace_with": "@@NUMM@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p >= 19, including Snowflake's NUMBER(38,0) default -> long (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\s*,\\s*0\\)",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p) with no scale -> long (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\)",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare NUMBER / DECIMAL / NUMERIC (defaults to NUMBER(38,0)) -> long (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BIGINT / INT / INTEGER (all aliases of NUMBER(38,0) in Snowflake) -> long (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:BIGINT|INTEGER|INT)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "SMALLINT / TINYINT / BYTEINT (also NUMBER(38,0) in Snowflake) -> long (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:SMALLINT|TINYINT|BYTEINT)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "FLOAT / FLOAT4 / FLOAT8 / DOUBLE PRECISION / DOUBLE / REAL -> double.",
      "options": {
        "find": "(?i)\\b(?:DOUBLE PRECISION|FLOAT8|FLOAT4|FLOAT|DOUBLE|REAL)\\b",
        "replace_with": "double"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BOOLEAN -> bool.",
      "options": {
        "find": "(?i)\\bBOOLEAN\\b",
        "replace_with": "bool"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "VARCHAR(n) / CHAR(n) / CHARACTER(n) -> string.",
      "options": {
        "find": "(?i)\\b(?:VARCHAR|CHARACTER VARYING|CHARACTER|NVARCHAR2|NVARCHAR|CHAR)\\(\\d+\\)",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare VARCHAR / STRING / TEXT / CHAR -> string.",
      "options": {
        "find": "(?i)\\b(?:VARCHAR|CHARACTER VARYING|CHARACTER|STRING|TEXT|CHAR)\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "VARIANT -> string (flagged above).",
      "options": {
        "find": "(?i)\\bVARIANT\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "OBJECT -> string (flagged above).",
      "options": {
        "find": "(?i)\\bOBJECT\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "ARRAY -> string (flagged above).",
      "options": {
        "find": "(?i)\\bARRAY\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "GEOGRAPHY / GEOMETRY -> string (carry the GeoJSON/WKT text through).",
      "options": {
        "find": "(?i)\\b(?:GEOGRAPHY|GEOMETRY)\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BINARY(n) / VARBINARY -> byte[] (last, so it cannot be re-matched by an earlier rule).",
      "options": {
        "find": "(?i)\\b(?:VARBINARY|BINARY)(?:\\(\\d+\\))?",
        "replace_with": "byte[]"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the fixed-point sentinel to decimal.",
      "options": {
        "find": "@@NUMS@@",
        "replace_with": "decimal"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the small-integer sentinel to int.",
      "options": {
        "find": "@@NUMI@@",
        "replace_with": "int"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the mid-integer sentinel to long.",
      "options": {
        "find": "@@NUMM@@",
        "replace_with": "long"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the wide-integer sentinel to long.",
      "options": {
        "find": "@@NUMB@@",
        "replace_with": "long"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a nullable C# auto-property.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "${1}public ${3}? ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a C# auto-property.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)( // .*)?$",
        "replace_with": "${1}public ${3} ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": {
        "find": "@@N@@",
        "replace_with": ""
      }
    },
    {
      "section": "Naming",
      "action": "to_pascal",
      "description": "PascalCase each class name (the Snowflake table identifier).",
      "only_lines_matching": "^public class ",
      "scope": {
        "field": {
          "index": 3,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Naming",
      "action": "to_pascal",
      "description": "PascalCase each property name; Snowflake returns UPPER_SNAKE_CASE identifiers.",
      "only_lines_matching": "^    public ",
      "scope": {
        "field": {
          "index": 7,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between classes.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": {
        "find": "\\A\\n+",
        "replace_with": ""
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": {
        "find": "\\n\\s*\\z",
        "replace_with": "\n"
      }
    },
    {
      "section": "Header",
      "action": "replace_regex",
      "description": "Prepend the using directives the generated types need (System for DateTime, DateOnly and DateTimeOffset). Last, so the type-map regexes never touch the header.",
      "options": {
        "find": "\\A",
        "replace_with": "using System;\n\n"
      }
    }
  ]
}
