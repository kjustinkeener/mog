{
  "name": ".env to Java properties",
  "description": "Convert a .env body to Java .properties style: on each KEY=VALUE line, lowercase the key and turn underscores into dots (APP_SERVER_PORT=8080 -> app.server.port=8080). The value (right of the first =) is left as written. Comment (#) and blank lines are untouched. The inverse of properties-to-env.",
  "summary": "Convert .env keys to Java properties style",
  "tags": [
    "env",
    "dotenv",
    "config",
    "convert",
    "java"
  ],
  "steps": [
    {
      "action": "to_lower",
      "description": "Lowercase the key (left of =)",
      "only_lines_matching": "^[A-Za-z0-9].*=",
      "scope": { "field": { "index": 1, "delimiter": "=" } }
    },
    {
      "action": "replace",
      "description": "Underscores to dots in the key",
      "only_lines_matching": "^[A-Za-z0-9].*=",
      "scope": { "field": { "index": 1, "delimiter": "=" } },
      "options": { "find": "_", "replace_with": "." }
    }
  ]
}
