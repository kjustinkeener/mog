{
  "name": "Collapse adjacent duplicate lines",
  "summary": "uniq: collapse runs of identical adjacent lines to one",
  "description": "Collapse runs of identical adjacent lines to a single line (the classic uniq behavior). Non-adjacent duplicates are left alone. Useful for squashing repeated log lines.",
