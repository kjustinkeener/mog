{
  "name": "BigQuery tables to C# classes",
  "summary": "Generate C# POCO classes from a BigQuery DDL export",
  "description": "Generate idiomatic C# POCO classes from a BigQuery DDL export (INFORMATION_SCHEMA.TABLES.ddl or 'bq show'), one class per table. Discards every non-table statement (CREATE SCHEMA, views, ALTERs) and BigQuery's physical-layout trailers (PARTITION BY, CLUSTER BY, table and column OPTIONS), then rewrites each CREATE TABLE into a 'public class' with one auto-property per column. BigQuery types map to C# types (INT64 -> long, FLOAT64 -> double, NUMERIC/BIGNUMERIC -> decimal, BOOL -> bool, STRING -> string, BYTES -> byte[], DATE -> DateOnly, TIME -> TimeOnly, DATETIME/TIMESTAMP -> DateTime, JSON -> string, STRUCT<...> -> Dictionary<string,object>, ARRAY<T> -> List<T>). BigQuery columns are NULLABLE by default -- only an explicit NOT NULL makes a column required -- so the nullable '?' suffix is driven by the ABSENCE of NOT NULL; ARRAY columns are never null. Table and column identifiers are PascalCased. Semi-structured and lossy types (JSON, STRUCT, BIGNUMERIC) are flagged with a // TODO(mog): comment. Assumes LF.",
  "tags": [
    "sql",
    "bigquery",
    "csharp",
    "codegen",
    "convert",
    "migration"
  ],
  "steps": [
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop the export's leading '--' comment banners and per-table headers.",
      "options": {
        "find": "(?m)^--.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE SCHEMA / CREATE DATASET statements.",
      "options": {
        "find": "(?im)^CREATE (?:SCHEMA|DATASET)\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop DROP TABLE / DROP VIEW statements.",
      "options": {
        "find": "(?im)^DROP (?:TABLE|VIEW)\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE VIEW / MATERIALIZED VIEW statements (multi-line, to the first ';').",
      "options": {
        "find": "(?ims)^CREATE (?:OR REPLACE )?(?:MATERIALIZED )?VIEW\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER TABLE statements (SET OPTIONS, ADD COLUMN, drops).",
      "options": {
        "find": "(?ims)^ALTER TABLE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop the table-level OPTIONS(...) trailer (description, labels, expiration).",
      "options": {
        "find": "(?ims)^OPTIONS\\(.*?\\);[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop PARTITION BY trailers (BigQuery physical layout, not part of the row type).",
      "options": {
        "find": "(?im)^PARTITION BY\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CLUSTER BY trailers (BigQuery physical layout, not part of the row type).",
      "options": {
        "find": "(?im)^CLUSTER BY\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Strip the backtick quoting BigQuery puts around table and column identifiers.",
      "options": {
        "find": "`",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE OR REPLACE TABLE <project>.<dataset>.<tbl>' plus its own-line '(' into the type header.",
      "options": {
        "find": "(?m)^CREATE (?:OR REPLACE )?TABLE (?:IF NOT EXISTS )?(?:[\\w-]+\\.)*(\\w+)\\n\\($",
        "replace_with": "public class ${1}\n{"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ')' (with or without a trailing ';') into the closing form.",
      "options": {
        "find": "(?m)^\\)[ \\t]*;?[ \\t]*$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop per-column OPTIONS(...) clauses (column descriptions and policy tags).",
      "options": {
        "find": "(?im)\\s+OPTIONS\\([^)]*\\)(?=,?[ \\t]*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines (literals, CURRENT_TIMESTAMP(), GENERATE_UUID()).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "BigQuery ARRAY columns are never NULL (an absent value is the empty array), so mark them NOT NULL before the nullability pass.",
      "options": {
        "find": "(?m)^(    \\w+ ARRAY<[^\\n]*>)(?! NOT NULL)$",
        "replace_with": "${1} NOT NULL"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns with a sentinel: in BigQuery a column is NULLABLE unless it explicitly says NOT NULL, so nullability is driven by the ABSENCE of the constraint.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag BigQuery JSON columns: mapped to string.",
      "options": {
        "pattern": "\\bJSON\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "BigQuery semi-structured column; carried in raw form -- deserialize it where you need field access.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag BigQuery STRUCT columns: mapped to a dictionary.",
      "options": {
        "pattern": "\\bSTRUCT<",
        "comment": "//",
        "tag": "TODO",
        "message": "BigQuery record type; flattened to a dictionary -- declare a nested class for typed field access.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag BigQuery ARRAY columns: mapped to a C# list.",
      "options": {
        "pattern": "\\bARRAY<",
        "comment": "//",
        "tag": "TODO",
        "message": "BigQuery repeated column; never null (an absent value is the empty list) -- verify the element mapping.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag BigQuery BIGNUMERIC columns: mapped to decimal.",
      "options": {
        "pattern": "\\bBIGNUMERIC\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "BigQuery 76-digit exact numbers overflow the built-in 28-29 digit exact-number type; use a big-number library if exactness matters.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "STRUCT<...> -> Dictionary<string,object> (flagged above).",
      "options": {
        "find": "(?i)\\bSTRUCT<[^>]*>",
        "replace_with": "Dictionary<string,object>"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BIGNUMERIC(p,s) -> decimal (flagged above).",
      "options": {
        "find": "(?i)\\bBIGNUMERIC\\(\\d+,\\s*\\d+\\)",
        "replace_with": "decimal"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare BIGNUMERIC -> decimal (flagged above).",
      "options": {
        "find": "(?i)\\bBIGNUMERIC\\b",
        "replace_with": "decimal"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMERIC(p,s) / DECIMAL(p,s) -> decimal.",
      "options": {
        "find": "(?i)\\b(?:NUMERIC|DECIMAL)\\(\\d+,\\s*\\d+\\)",
        "replace_with": "decimal"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare NUMERIC / DECIMAL -> decimal.",
      "options": {
        "find": "(?i)\\b(?:NUMERIC|DECIMAL)\\b",
        "replace_with": "decimal"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "INT64 / INT / INTEGER -> long.",
      "options": {
        "find": "(?i)\\b(?:INT64|INTEGER|INT)\\b",
        "replace_with": "long"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "FLOAT64 / FLOAT -> double.",
      "options": {
        "find": "(?i)\\b(?:FLOAT64|FLOAT)\\b",
        "replace_with": "double"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BOOL / BOOLEAN -> bool.",
      "options": {
        "find": "(?i)\\b(?:BOOLEAN|BOOL)\\b",
        "replace_with": "bool"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "STRING(n) -> string.",
      "options": {
        "find": "(?i)\\bSTRING\\(\\d+\\)",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare STRING -> string.",
      "options": {
        "find": "(?i)\\bSTRING\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BYTES(n) / BYTES -> byte[].",
      "options": {
        "find": "(?i)\\bBYTES(?:\\(\\d+\\))?",
        "replace_with": "byte[]"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP -> DateTime.",
      "options": {
        "find": "(?i)\\bTIMESTAMP\\b",
        "replace_with": "DateTime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "DATETIME -> DateTime.",
      "options": {
        "find": "(?i)\\bDATETIME\\b",
        "replace_with": "DateTime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "DATE -> DateOnly.",
      "options": {
        "find": "(?i)\\bDATE\\b",
        "replace_with": "DateOnly"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIME -> TimeOnly.",
      "options": {
        "find": "(?i)\\bTIME\\b",
        "replace_with": "TimeOnly"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "JSON -> string (flagged above).",
      "options": {
        "find": "(?i)\\bJSON\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "ARRAY<T> -> List<T> (flagged above).",
      "options": {
        "find": "(?i)\\bARRAY<([^<>]+)>",
        "replace_with": "List<${1}>"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a C# auto-property with a nullable type.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "${1}public ${3}? ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a C# auto-property.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)( // .*)?$",
        "replace_with": "${1}public ${3} ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": {
        "find": "@@N@@",
        "replace_with": ""
      }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each class name (the table identifier).",
      "only_lines_matching": "^public class ",
      "scope": {
        "field": {
          "index": 3,
          "delimiter": " "
        }
      }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each property name (the column identifier).",
      "only_lines_matching": "^    public ",
      "scope": {
        "field": {
          "index": 7,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between declarations.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": {
        "find": "\\A\\n+",
        "replace_with": ""
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": {
        "find": "\\n\\s*\\z",
        "replace_with": "\n"
      }
    },
    {
      "section": "Header",
      "action": "replace_regex",
      "description": "Prepend the using directives the generated types need (System for the date and time kinds, System.Collections.Generic for the mapped repeated and record columns). Last, so the type-map regexes never touch the header.",
      "options": {
        "find": "\\A",
        "replace_with": "using System;\nusing System.Collections.Generic;\n\n"
      }
    }
  ]
}
