{
  "name": "MySQL SHOW CREATE TABLE to Postgres",
  "summary": "Convert a MySQL table export to PostgreSQL DDL",
  "description": "Convert MySQL 'SHOW CREATE TABLE' output to PostgreSQL. Strips MySQL storage noise (ENGINE/CHARSET/COLLATE, backticks, DEFAULT NULL, ON UPDATE), then maps MySQL types to Postgres: tinyint(1)->BOOLEAN, datetime->TIMESTAMP, timestamp->TIMESTAMPTZ, json->JSONB, enum(...)->TEXT (value set flagged), and AUTO_INCREMENT->GENERATED BY DEFAULT AS IDENTITY. Minimal-diff. Validated by a live round-trip against a real PostgreSQL engine.",
  "tags": ["sql", "mysql", "postgres", "convert", "migration"],
  "dependencies": ["strip-mysql-ddl-noise"],
  "steps": [
    { "section": "Strip export noise", "action": "run_mog",
      "options": { "file": "strip-mysql-ddl-noise.mog" } },
    { "section": "Types", "action": "replace_regex", "description": "tinyint(1) is MySQL's boolean -> BOOLEAN.",
      "options": { "find": "(?i)\\btinyint\\(1\\)", "replace_with": "BOOLEAN" } },
    { "section": "Types", "action": "replace_regex", "description": "timestamp (instant) -> TIMESTAMPTZ. Runs before datetime so it does not re-match.",
      "options": { "find": "(?i)\\btimestamp\\b", "replace_with": "TIMESTAMPTZ" } },
    { "section": "Types", "action": "replace_regex", "description": "datetime (wall-clock) -> TIMESTAMP.",
      "options": { "find": "(?i)\\bdatetime\\b", "replace_with": "TIMESTAMP" } },
    { "section": "Types", "action": "replace_regex", "description": "json -> JSONB (Postgres binary JSON).",
      "options": { "find": "(?i)\\bjson\\b", "replace_with": "JSONB" } },
    { "section": "Types", "action": "flag_matching", "description": "Flag ENUM (mapped to TEXT; value constraint lost).",
      "options": { "pattern": "(?i)enum\\(", "message": "MySQL ENUM mapped to TEXT; the allowed-value constraint was lost (use a CHECK or a Postgres ENUM type)", "comment": "--", "tag": "TODO", "position": "inline" } },
    { "section": "Types", "action": "replace_regex", "description": "enum(...) -> TEXT.",
      "options": { "find": "(?i)\\benum\\([^)]*\\)", "replace_with": "TEXT" } },
    { "section": "Columns", "action": "replace", "description": "MySQL AUTO_INCREMENT -> Postgres identity column.",
      "options": { "find": "AUTO_INCREMENT", "replace_with": "GENERATED BY DEFAULT AS IDENTITY" } }
  ]
}
