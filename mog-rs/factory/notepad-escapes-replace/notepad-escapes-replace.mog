{
  "name": "Literal replace with \\t \\n escapes",
  "summary": "Find/replace that decodes Notepad++ escapes",
  "description": "Literal find/replace that first decodes Notepad++-style escapes ( \\t \\n \\r ) in both the find and replacement. This mog turns tabs into a single space. Use it for escape-aware literal replacements without writing a regex.",
  "tags": [
    "replace",
    "escape",
    "whitespace",
    "eol",
    "single-action"
  ],
  "steps": [
    {
      "action": "replace_extended",
      "description": "Replace each tab with a space",
      "options": {
        "find": "\\t",
        "replace_with": " "
      }
    }
  ]
}
