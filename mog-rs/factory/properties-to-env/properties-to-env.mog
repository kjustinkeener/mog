{
  "name": "Java properties to .env",
  "description": "Convert a Java .properties body to .env style: on each key=value line, uppercase the key and turn dots into underscores (app.server.port=8080 -> APP_SERVER_PORT=8080). The value (right of the first =) is left exactly as written. Only the key is changed; comment (# / !) and blank lines are left untouched.",
  "summary": "Convert Java .properties to .env format",
  "tags": [
    "config",
    "env",
    "dotenv",
    "convert",
    "java"
  ],
  "steps": [
    {
      "action": "to_upper",
      "description": "Uppercase the key (left of =)",
      "only_lines_matching": "^[A-Za-z0-9].*=",
      "scope": { "field": { "index": 1, "delimiter": "=" } }
    },
    {
      "action": "replace",
      "description": "Dots to underscores in the key",
      "only_lines_matching": "^[A-Za-z0-9].*=",
      "scope": { "field": { "index": 1, "delimiter": "=" } },
      "options": { "find": ".", "replace_with": "_" }
    }
  ]
}
