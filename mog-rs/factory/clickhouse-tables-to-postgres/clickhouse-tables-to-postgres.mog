{
  "name": "ClickHouse SHOW CREATE TABLE to Postgres",
  "summary": "Convert a ClickHouse table export to runnable PostgreSQL DDL",
  "description": "Convert the output of ClickHouse 'SHOW CREATE TABLE' to PostgreSQL (e.g. mirroring an analytics table into a serving/OLTP database, or migrating off ClickHouse). Strips the ClickHouse engine/physical noise (ENGINE, PARTITION BY, ORDER BY, PRIMARY KEY, SAMPLE BY, TTL, SETTINGS, backticks, database qualifier), applies ClickHouse nullability (columns are NOT NULL unless wrapped in Nullable(); LowCardinality() is unwrapped), and maps types to Postgres: String->text, FixedString(n)->varchar(n), Int8/16->smallint, Int32->integer, Int64->bigint, UInt8->smallint, UInt16->integer, UInt32->bigint, UInt64->numeric(20,0), Decimal(p,s)->numeric(p,s), Float32->real, Float64->double precision, DateTime64(n,'tz')->timestamptz, DateTime64(n)/DateTime->timestamp, Date->date, UUID->uuid. Non-portable constructs are flagged with -- TODO(mog): Enum8/16->text (value set lost), Array(T)->T[], Map/Tuple/Nested->jsonb, and dropped ORDER BY/PARTITION BY preserved as comments.",
  "tags": ["sql", "clickhouse", "postgres", "convert", "migration"],
  "dependencies": ["strip-clickhouse-showcreate-noise"],
  "steps": [
    { "section": "Strip export noise", "action": "run_mog", "description": "Remove ClickHouse engine/physical/identifier noise; ORDER BY and PARTITION BY become TODO comments.",
      "options": { "file": "strip-clickhouse-showcreate-noise.mog" } },

    { "section": "Nullability", "action": "replace_regex", "description": "Unwrap LowCardinality(Nullable(T)) -> Nullable(T): LowCardinality is a storage encoding with no Postgres analog; keep the nullability.",
      "options": { "find": "LowCardinality\\(Nullable\\(([^()]+)\\)\\)", "replace_with": "Nullable(${1})" } },
    { "section": "Nullability", "action": "replace_regex", "description": "Unwrap LowCardinality(T) -> T (dictionary-encoding hint dropped).",
      "options": { "find": "LowCardinality\\(([^()]+)\\)", "replace_with": "${1}" } },
    { "section": "Nullability", "action": "replace_regex", "description": "ClickHouse columns are NOT NULL by default: stamp NOT NULL on every column line that is not wrapped in Nullable(). The negative lookahead skips Nullable columns; structural lines (CREATE TABLE, the parens, TODO comments) do not start with the 4-space column indent.",
      "options": { "find": "(?m)^(    (?:(?!Nullable).)*?)(,?)$", "replace_with": "${1} NOT NULL${2}" } },
    { "section": "Nullability", "action": "replace_regex", "description": "Unwrap Nullable(inner(...)) with one level of nested parens (e.g. Nullable(FixedString(12)), Nullable(Decimal(18,2))) -> the inner type; the column is left nullable (Postgres default).",
      "options": { "find": "Nullable\\((\\w+\\([^()]*\\))\\)", "replace_with": "${1}" } },
    { "section": "Nullability", "action": "replace_regex", "description": "Unwrap the remaining simple Nullable(T) -> T.",
      "options": { "find": "Nullable\\(([^()]+)\\)", "replace_with": "${1}" } },

    { "section": "Types", "action": "replace_regex", "description": "FixedString(n) -> varchar(n) (fixed-width text; varchar is the closest runnable Postgres type).",
      "options": { "find": "(?i)\\bFixedString\\((\\d+)\\)", "replace_with": "varchar(${1})" } },
    { "section": "Types", "action": "replace_regex", "description": "String -> text (ClickHouse String is unbounded).",
      "options": { "find": "(?i)\\bString\\b", "replace_with": "text" } },
    { "section": "Types", "action": "replace_regex", "description": "DateTime64(n,'tz') (instant with time zone) -> timestamptz. Runs before the plain DateTime64/DateTime maps so its tz form is not swallowed.",
      "options": { "find": "(?i)\\bDateTime64\\(\\d+,\\s*'[^']*'\\)", "replace_with": "timestamptz" } },
    { "section": "Types", "action": "replace_regex", "description": "DateTime64(n) (sub-second, no tz) -> timestamp.",
      "options": { "find": "(?i)\\bDateTime64\\(\\d+\\)", "replace_with": "timestamp" } },
    { "section": "Types", "action": "replace_regex", "description": "DateTime('tz') -> timestamptz.",
      "options": { "find": "(?i)\\bDateTime\\('[^']*'\\)", "replace_with": "timestamptz" } },
    { "section": "Types", "action": "replace_regex", "description": "DateTime (second precision, no tz) -> timestamp.",
      "options": { "find": "(?i)\\bDateTime\\b", "replace_with": "timestamp" } },
    { "section": "Types", "action": "replace_regex", "description": "Date32/Date -> date.",
      "options": { "find": "(?i)\\bDate(?:32)?\\b", "replace_with": "date" } },
    { "section": "Types", "action": "replace_regex", "description": "Decimal(p,s) -> numeric(p,s) (identical fixed-point semantics).",
      "options": { "find": "(?i)\\bDecimal\\((\\d+),\\s*(\\d+)\\)", "replace_with": "numeric(${1}, ${2})" } },
    { "section": "Types", "action": "replace_regex", "description": "UInt64 -> numeric(20,0): an unsigned 64-bit value overflows Postgres bigint, so use exact numeric.",
      "options": { "find": "(?i)\\bUInt64\\b", "replace_with": "numeric(20, 0)" } },
    { "section": "Types", "action": "replace_regex", "description": "UInt32 -> bigint (unsigned 32-bit exceeds signed integer range).",
      "options": { "find": "(?i)\\bUInt32\\b", "replace_with": "bigint" } },
    { "section": "Types", "action": "replace_regex", "description": "UInt16 -> integer (unsigned 16-bit exceeds signed smallint range).",
      "options": { "find": "(?i)\\bUInt16\\b", "replace_with": "integer" } },
    { "section": "Types", "action": "replace_regex", "description": "UInt8 -> smallint (safe; use boolean by hand if the column is a 0/1 flag).",
      "options": { "find": "(?i)\\bUInt8\\b", "replace_with": "smallint" } },
    { "section": "Types", "action": "replace_regex", "description": "Int64 -> bigint.",
      "options": { "find": "(?i)\\bInt64\\b", "replace_with": "bigint" } },
    { "section": "Types", "action": "replace_regex", "description": "Int32 -> integer.",
      "options": { "find": "(?i)\\bInt32\\b", "replace_with": "integer" } },
    { "section": "Types", "action": "replace_regex", "description": "Int16 -> smallint.",
      "options": { "find": "(?i)\\bInt16\\b", "replace_with": "smallint" } },
    { "section": "Types", "action": "replace_regex", "description": "Int8 -> smallint (Postgres has no 1-byte integer).",
      "options": { "find": "(?i)\\bInt8\\b", "replace_with": "smallint" } },
    { "section": "Types", "action": "replace_regex", "description": "Float32 -> real.",
      "options": { "find": "(?i)\\bFloat32\\b", "replace_with": "real" } },
    { "section": "Types", "action": "replace_regex", "description": "Float64 -> double precision.",
      "options": { "find": "(?i)\\bFloat64\\b", "replace_with": "double precision" } },
    { "section": "Types", "action": "replace_regex", "description": "UUID -> uuid.",
      "options": { "find": "(?i)\\bUUID\\b", "replace_with": "uuid" } },

    { "section": "Flag non-portable", "action": "flag_matching", "description": "Flag Enum8/Enum16 before mapping it to text (the allowed-value constraint is lost; use a CHECK or a Postgres enum type).",
      "options": { "pattern": "\\bEnum(?:8|16)\\(", "message": "ClickHouse Enum mapped to text; the allowed-value set was lost (use a CHECK constraint or a Postgres ENUM type)", "comment": "--", "tag": "TODO", "position": "before" } },
    { "section": "Flag non-portable", "action": "replace_regex", "description": "Enum8/Enum16(...) -> text.",
      "options": { "find": "(?i)\\bEnum(?:8|16)\\([^)]*\\)", "replace_with": "text" } },
    { "section": "Flag non-portable", "action": "flag_matching", "description": "Flag Array columns before mapping to a Postgres array.",
      "options": { "pattern": "\\bArray\\(", "message": "ClickHouse Array mapped to a Postgres array type; verify element type and nullability semantics", "comment": "--", "tag": "TODO", "position": "before" } },
    { "section": "Flag non-portable", "action": "replace_regex", "description": "Array(T) -> T[] (T already mapped to a Postgres scalar above).",
      "options": { "find": "(?i)\\bArray\\(([a-z0-9_ ]+)\\)", "replace_with": "${1}[]" } },
    { "section": "Flag non-portable", "action": "flag_matching", "description": "Flag Map columns before mapping to jsonb.",
      "options": { "pattern": "\\bMap\\(", "message": "ClickHouse Map mapped to jsonb; there is no native Postgres map/dictionary column type", "comment": "--", "tag": "TODO", "position": "before" } },
    { "section": "Flag non-portable", "action": "replace_regex", "description": "Map(K, V) -> jsonb.",
      "options": { "find": "(?i)\\bMap\\([^)]*\\)", "replace_with": "jsonb" } },
    { "section": "Flag non-portable", "action": "flag_matching", "description": "Flag Tuple columns before mapping to jsonb.",
      "options": { "pattern": "\\bTuple\\(", "message": "ClickHouse Tuple mapped to jsonb; Postgres has no anonymous tuple column type (consider a composite type or separate columns)", "comment": "--", "tag": "TODO", "position": "before" } },
    { "section": "Flag non-portable", "action": "replace_regex", "description": "Tuple(...) -> jsonb.",
      "options": { "find": "(?i)\\bTuple\\([^)]*\\)", "replace_with": "jsonb" } },
    { "section": "Flag non-portable", "action": "flag_matching", "description": "Flag Nested columns before mapping to jsonb.",
      "options": { "pattern": "\\bNested\\(", "message": "ClickHouse Nested mapped to jsonb; model it as jsonb or a child table in Postgres", "comment": "--", "tag": "TODO", "position": "before" } },
    { "section": "Flag non-portable", "action": "replace_regex", "description": "Nested(...) -> jsonb.",
      "options": { "find": "(?i)\\bNested\\([^)]*\\)", "replace_with": "jsonb" } }
  ]
}
