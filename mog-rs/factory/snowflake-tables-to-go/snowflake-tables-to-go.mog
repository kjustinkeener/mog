{
  "name": "Snowflake tables to Go structs",
  "summary": "Generate Go structs (with db tags) from a Snowflake GET_DDL export",
  "description": "Generate idiomatic Go type declarations from a Snowflake table export (SELECT GET_DDL('TABLE', ...) or a Snowsight DDL copy), one 'type <Table> struct' per table. Strips the Snowflake-only rendering (statement terminators, inline COMMENT 'x', the glued )COMMENT='x', cluster by, autoincrement, DEFAULT and table-level constraint lines), then rewrites each 'create or replace TABLE' into a struct with one exported field per column. Field names are PascalCased for export, with the exact UPPER_SNAKE_CASE Snowflake column name preserved losslessly in a `db:\"...\"` struct tag (compatible with sqlx / gosnowflake). Snowflake types map to Go types (NUMBER(p,0) p<=9 -> int32, wider -> int64, NUMBER(p,s) s>0 -> string, FLOAT/DOUBLE/REAL -> float64, BOOLEAN -> bool, VARCHAR/STRING/TEXT/CHAR -> string, DATE/TIME/TIMESTAMP_NTZ/TIMESTAMP_TZ/TIMESTAMP_LTZ -> time.Time, BINARY/VARBINARY -> []byte, VARIANT/OBJECT/ARRAY -> json.RawMessage). Nullable columns (no NOT NULL) become pointer types (*T); nilable types (slices, json.RawMessage) stay as-is. Lossy mappings are flagged inline with a // TODO(mog): comment: semi-structured columns, NUMBER(p,s) fixed-point (Go has no native decimal), and NUMBER(p,0) wide enough to overflow int64. Emits the struct declarations only: add your own 'package' clause and imports (time, encoding/json), then run gofmt to align fields. Assumes LF.",
  "tags": [
    "sql",
    "snowflake",
    "go",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-snowflake-getddl-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove the Snowflake GET_DDL rendering: statement terminators, inline column COMMENT 'x', the glued table )COMMENT='x', and the cluster by clause.",
      "options": {
        "file": "strip-snowflake-getddl-noise.mog"
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop the SQL comment lines the strip fragment leaves behind (the CLUSTER BY note).",
      "options": {
        "find": "(?m)^--[^\\n]*\\n?",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop table-level constraint lines (primary key, foreign key, unique, constraint).",
      "options": {
        "find": "(?mi)^[ \\t]*(?:primary key|foreign key|unique|constraint)\\b[^\\n]*\\n?",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Convert the tab indent GET_DDL emits to four spaces, so column lines have a fixed shape.",
      "options": {
        "find": "(?m)^\\t",
        "replace_with": "    "
      }
    },
    {
      "section": "Struct shell",
      "action": "replace_regex",
      "description": "Rewrite each 'create or replace TABLE <tbl> (' header.",
      "options": {
        "find": "(?mi)^create or replace (?:transient |temporary |volatile )?table (?:\\w+\\.)*(\\w+) \\($",
        "replace_with": "type ${1} struct {"
      }
    },
    {
      "section": "Struct shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ')' into a closing brace.",
      "options": {
        "find": "(?m)^\\)$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop the Snowflake autoincrement / identity clause.",
      "options": {
        "find": "(?i)\\s+(?:autoincrement|identity)(?:\\s+start\\s+-?\\d+\\s+increment\\s+-?\\d+)?(?:\\s+(?:no)?order)?",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop COLLATE clauses.",
      "options": {
        "find": "(?i)\\s+COLLATE\\s+'[^']*'",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses (sequences, CURRENT_TIMESTAMP(), literals).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag semi-structured VARIANT / OBJECT columns: mapped to json.RawMessage.",
      "options": {
        "pattern": "\\b(?:VARIANT|OBJECT)\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake semi-structured column; unmarshal it into a concrete struct if you know the shape.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag ARRAY columns: Snowflake arrays are untyped.",
      "options": {
        "pattern": "\\bARRAY\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake list column has no declared element type; unmarshal it into a typed slice yourself.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag fixed-point columns (NUMBER(p,s) with s > 0): Go has no native decimal.",
      "options": {
        "pattern": "\\bNUMBER\\(\\d+\\s*,\\s*[1-9]\\d*\\)",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake fixed-point column; Go has no native exact-scale kind -- parse with an exact-arithmetic library.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag wide integers (NUMBER(p,0) with p >= 19): they can overflow int64.",
      "options": {
        "pattern": "\\bNUMBER\\((?:19|2\\d|3\\d)\\s*,\\s*0\\)",
        "comment": "//",
        "tag": "TODO",
        "message": "Snowflake column can exceed the signed 64-bit range; use math/big if values can pass 9.2e18.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP_NTZ / DATETIME (wall-clock, no zone) -> @@GODT@@.",
      "options": {
        "find": "(?i)\\b(?:TIMESTAMP_NTZ|DATETIME)(?:\\(\\d+\\))?",
        "replace_with": "@@GODT@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP_TZ / TIMESTAMP_LTZ (zone-aware) -> @@GODT@@.",
      "options": {
        "find": "(?i)\\bTIMESTAMP_(?:L?TZ)(?:\\(\\d+\\))?",
        "replace_with": "@@GODT@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare TIMESTAMP (the session default, normally NTZ) -> @@GODT@@.",
      "options": {
        "find": "(?i)\\bTIMESTAMP(?:\\(\\d+\\))?",
        "replace_with": "@@GODT@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIME -> @@GODT@@.",
      "options": {
        "find": "(?i)\\bTIME(?:\\(\\d+\\))?",
        "replace_with": "@@GODT@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "DATE -> @@GODT@@.",
      "options": {
        "find": "(?i)\\bDATE\\b",
        "replace_with": "@@GODT@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,s) / DECIMAL(p,s) with s > 0 -> string (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\s*,\\s*[1-9]\\d*\\)",
        "replace_with": "@@NUMS@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p <= 9 -> int32 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\([1-9]\\s*,\\s*0\\)",
        "replace_with": "@@NUMI@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p between 10 and 18 -> int64 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(1[0-8]\\s*,\\s*0\\)",
        "replace_with": "@@NUMM@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p >= 19, including Snowflake's NUMBER(38,0) default -> int64 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\s*,\\s*0\\)",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p) with no scale -> int64 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\)",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare NUMBER / DECIMAL / NUMERIC (defaults to NUMBER(38,0)) -> int64 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BIGINT / INT / INTEGER (all aliases of NUMBER(38,0) in Snowflake) -> int64 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:BIGINT|INTEGER|INT)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "SMALLINT / TINYINT / BYTEINT (also NUMBER(38,0) in Snowflake) -> int64 (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:SMALLINT|TINYINT|BYTEINT)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "FLOAT / FLOAT4 / FLOAT8 / DOUBLE PRECISION / DOUBLE / REAL -> float64.",
      "options": {
        "find": "(?i)\\b(?:DOUBLE PRECISION|FLOAT8|FLOAT4|FLOAT|DOUBLE|REAL)\\b",
        "replace_with": "float64"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BOOLEAN -> bool.",
      "options": {
        "find": "(?i)\\bBOOLEAN\\b",
        "replace_with": "bool"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "VARCHAR(n) / CHAR(n) / CHARACTER(n) -> string.",
      "options": {
        "find": "(?i)\\b(?:VARCHAR|CHARACTER VARYING|CHARACTER|NVARCHAR2|NVARCHAR|CHAR)\\(\\d+\\)",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare VARCHAR / STRING / TEXT / CHAR -> string.",
      "options": {
        "find": "(?i)\\b(?:VARCHAR|CHARACTER VARYING|CHARACTER|STRING|TEXT|CHAR)\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "VARIANT -> json.RawMessage (flagged above).",
      "options": {
        "find": "(?i)\\bVARIANT\\b",
        "replace_with": "json.RawMessage"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "OBJECT -> json.RawMessage (flagged above).",
      "options": {
        "find": "(?i)\\bOBJECT\\b",
        "replace_with": "json.RawMessage"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "ARRAY -> json.RawMessage (flagged above).",
      "options": {
        "find": "(?i)\\bARRAY\\b",
        "replace_with": "json.RawMessage"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "GEOGRAPHY / GEOMETRY -> string (carry the GeoJSON/WKT text through).",
      "options": {
        "find": "(?i)\\b(?:GEOGRAPHY|GEOMETRY)\\b",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BINARY(n) / VARBINARY -> []byte (last, so it cannot be re-matched by an earlier rule).",
      "options": {
        "find": "(?i)\\b(?:VARBINARY|BINARY)(?:\\(\\d+\\))?",
        "replace_with": "[]byte"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the fixed-point sentinel to string.",
      "options": {
        "find": "@@NUMS@@",
        "replace_with": "string"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the small-integer sentinel to int32.",
      "options": {
        "find": "@@NUMI@@",
        "replace_with": "int32"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the mid-integer sentinel to int64.",
      "options": {
        "find": "@@NUMM@@",
        "replace_with": "int64"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the wide-integer sentinel to int64.",
      "options": {
        "find": "@@NUMB@@",
        "replace_with": "int64"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the time sentinel to time.Time (kept separate so the 'TIME' keyword rule cannot re-match it).",
      "options": {
        "find": "@@GODT@@",
        "replace_with": "time.Time"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a pointer-typed Go field carrying a db tag placeholder.",
      "options": {
        "find": "(?m)^    (\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "    ${1} *${2} @@DB@@${1}@@${3}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a Go field carrying a db tag placeholder.",
      "options": {
        "find": "(?m)^    (\\w+) (\\S+)( // .*)?$",
        "replace_with": "    ${1} ${2} @@DB@@${1}@@${3}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Nilable types (slices, json.RawMessage) don't need a pointer for nullability -- drop it.",
      "options": {
        "find": "\\*(\\[\\]\\w+|json\\.RawMessage)",
        "replace_with": "${1}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": {
        "find": "@@N@@",
        "replace_with": ""
      }
    },
    {
      "section": "Naming",
      "action": "to_pascal",
      "description": "PascalCase each struct name (the Snowflake table identifier).",
      "only_lines_matching": "^type ",
      "scope": {
        "field": {
          "index": 2,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Naming",
      "action": "to_pascal",
      "description": "PascalCase each field name so it is exported; the db tag keeps the exact Snowflake column name.",
      "only_lines_matching": "^    \\w",
      "scope": {
        "field": {
          "index": 5,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Tags",
      "action": "replace_regex",
      "description": "Resolve the db tag placeholder into a real Go struct tag.",
      "options": {
        "find": "@@DB@@(\\w+)@@",
        "replace_with": "`db:\"${1}\"`"
      }
    },
    {
      "section": "Tags",
      "action": "replace_regex",
      "description": "Convert the 4-space column indent to a tab (Go convention).",
      "options": {
        "find": "(?m)^    ",
        "replace_with": "\t"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between structs.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": {
        "find": "\\A\\n+",
        "replace_with": ""
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": {
        "find": "\\n\\s*\\z",
        "replace_with": "\n"
      }
    }
  ]
}
