{
  "name": "MySQL SHOW CREATE TABLE to C# classes",
  "summary": "Generate C# POCO classes from MySQL SHOW CREATE TABLE output",
  "description": "Turn real MySQL 'SHOW CREATE TABLE' output into idiomatic C# POCO classes, one class per table. Strips the MySQL storage rendering (backticks, ENGINE/CHARSET/COLLATE, DEFAULT NULL, ON UPDATE), drops the inline index and constraint lines (PRIMARY KEY, KEY, UNIQUE KEY, CONSTRAINT, FOREIGN KEY), re-indents the column body from MySQL's two-space to four-space, then rewrites each CREATE TABLE into a 'public class' with one auto-property per column. MySQL types map to C# types (bigint->long, int/integer/mediumint->int, smallint->short, tinyint(1)->bool, tinyint->sbyte, bit->bool, varchar/char/text family->string, decimal/numeric->decimal, double/float->double, datetime/timestamp->DateTime, date->DateOnly, time->TimeOnly, year->int, blob/binary/varbinary family->byte[], json->string). Nullability is inferred: MySQL columns are nullable unless declared NOT NULL, so non-NOT-NULL columns get a C# nullable type ('?'); AUTO_INCREMENT, UNSIGNED, ZEROFILL, DEFAULT clauses and per-column CHARACTER SET/COLLATE are dropped. enum(...) and set(...) map to string and are flagged with a // TODO(mog): comment because their value set is lost. Table and column identifiers are PascalCased. The MySQL-source sibling of postgres-tables-to-csharp. Assumes LF.",
  "tags": [
    "sql",
    "mysql",
    "csharp",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-mysql-ddl-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove MySQL storage noise: backticks, ENGINE/CHARSET/COLLATE, DEFAULT NULL, ON UPDATE.",
      "options": {
        "file": "strip-mysql-ddl-noise.mog"
      }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop the SQL-comment TODO the strip fragment stamped for ON UPDATE (not valid C#).",
      "options": {
        "find": "(?m) *-- TODO\\(mog\\):[^\\n]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop per-column CHARACTER SET clause.",
      "options": {
        "find": "(?i) CHARACTER SET \\w+",
        "replace_with": ""
      }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop per-column COLLATE clause.",
      "options": {
        "find": "(?i) COLLATE \\w+",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only columns",
      "action": "replace_regex",
      "description": "Drop the inline PRIMARY KEY / UNIQUE KEY / FULLTEXT KEY / KEY / CONSTRAINT / FOREIGN KEY lines (whole line).",
      "options": {
        "find": "(?im)^\\s*(?:PRIMARY KEY|UNIQUE KEY|FULLTEXT KEY|KEY|CONSTRAINT|FOREIGN KEY)\\b.*\\n",
        "replace_with": ""
      }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Drop the MySQL AUTO_INCREMENT flag (no C# equivalent on a POCO).",
      "options": {
        "find": "(?i) AUTO_INCREMENT\\b",
        "replace_with": ""
      }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Drop UNSIGNED / ZEROFILL numeric modifiers.",
      "options": {
        "find": "(?i) (?:unsigned|zerofill)\\b",
        "replace_with": ""
      }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Drop an explicit NULL nullability marker (leave NOT NULL intact).",
      "options": {
        "find": "(?i)(?<!NOT) NULL\\b",
        "replace_with": ""
      }
    },
    {
      "section": "Reindent",
      "action": "replace_regex",
      "description": "Re-indent the column body from MySQL's two-space to the four-space the codegen expects.",
      "options": {
        "find": "(?m)^  (\\S)",
        "replace_with": "    ${1}"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE TABLE <tbl> (' into a C# class header + opening brace.",
      "options": {
        "find": "(?m)^CREATE TABLE (?:\\w+\\.)?(\\w+) \\($",
        "replace_with": "public class ${1}\n{"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ')' into a closing brace.",
      "options": {
        "find": "(?m)^\\)$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines (literals, CURRENT_TIMESTAMP).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL enum columns (mapped to string; value set lost).",
      "options": {
        "pattern": "(?i)\\benum\\(",
        "comment": "//",
        "tag": "TODO",
        "message": "MySQL enum; values lost, consider a C# enum instead of string.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL set columns (mapped to string; multi-value set lost).",
      "options": {
        "pattern": "(?i)\\bset\\(",
        "comment": "//",
        "tag": "TODO",
        "message": "MySQL set; multi-value set lost, stored as string.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tinyint(1) is MySQL's boolean -> bool.",
      "options": { "find": "(?i)\\btinyint\\(1\\)", "replace_with": "bool" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tinyint(n) -> sbyte.",
      "options": { "find": "(?i)\\btinyint(?:\\(\\d+\\))?", "replace_with": "sbyte" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "smallint -> short.",
      "options": { "find": "(?i)\\bsmallint(?:\\(\\d+\\))?", "replace_with": "short" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "mediumint -> int.",
      "options": { "find": "(?i)\\bmediumint(?:\\(\\d+\\))?", "replace_with": "int" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bigint -> long.",
      "options": { "find": "(?i)\\bbigint(?:\\(\\d+\\))?", "replace_with": "long" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "integer / int -> int.",
      "options": { "find": "(?i)\\b(?:integer|int)(?:\\(\\d+\\))?", "replace_with": "int" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "decimal(p,s) / numeric(p,s) -> decimal.",
      "options": { "find": "(?i)\\b(?:decimal|numeric)\\(\\d+,\\s*\\d+\\)", "replace_with": "decimal" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare decimal / numeric -> decimal.",
      "options": { "find": "(?i)\\b(?:decimal|numeric)(?:\\(\\d+\\))?", "replace_with": "decimal" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "double / double precision -> double.",
      "options": { "find": "(?i)\\bdouble(?:\\s+precision)?(?:\\(\\d+,\\s*\\d+\\))?", "replace_with": "double" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "float -> double.",
      "options": { "find": "(?i)\\bfloat(?:\\(\\d+(?:,\\s*\\d+)?\\))?", "replace_with": "double" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "real -> double.",
      "options": { "find": "(?i)\\breal\\b", "replace_with": "double" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "datetime -> DateTime.",
      "options": { "find": "(?i)\\bdatetime\\b", "replace_with": "DateTime" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamp -> DateTime.",
      "options": { "find": "(?i)\\btimestamp\\b", "replace_with": "DateTime" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "year -> int.",
      "options": { "find": "(?i)\\byear\\b", "replace_with": "int" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "date -> DateOnly (runs after datetime).",
      "options": { "find": "(?i)\\bdate\\b", "replace_with": "DateOnly" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "time -> TimeOnly (runs after datetime/timestamp).",
      "options": { "find": "(?i)\\btime\\b", "replace_with": "TimeOnly" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "enum(...) -> string (flagged above).",
      "options": { "find": "(?i)\\benum\\([^)]*\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "set(...) -> string (flagged above).",
      "options": { "find": "(?i)\\bset\\([^)]*\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "varchar(n) / char(n) -> string.",
      "options": { "find": "(?i)\\b(?:varchar|char)\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare varchar / char -> string.",
      "options": { "find": "(?i)\\b(?:varchar|char)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text family (tinytext/mediumtext/longtext/text) -> string.",
      "options": { "find": "(?i)\\b(?:tinytext|mediumtext|longtext|text)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "blob family (tinyblob/mediumblob/longblob/blob) -> byte[].",
      "options": { "find": "(?i)\\b(?:tinyblob|mediumblob|longblob|blob)\\b", "replace_with": "byte[]" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "varbinary(n) / binary(n) / bare -> byte[].",
      "options": { "find": "(?i)\\b(?:varbinary|binary)(?:\\(\\d+\\))?", "replace_with": "byte[]" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bit -> bool.",
      "options": { "find": "(?i)\\bbit(?:\\(\\d+\\))?", "replace_with": "bool" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "json -> string.",
      "options": { "find": "(?i)\\bjson\\b", "replace_with": "string" }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a C# auto-property with a nullable type.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "${1}public ${3}? ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a C# auto-property.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)( // .*)?$",
        "replace_with": "${1}public ${3} ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": { "find": "@@N@@", "replace_with": "" }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each class name (the table identifier).",
      "only_lines_matching": "^public class ",
      "scope": { "field": { "index": 3, "delimiter": " " } }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each property name (the column identifier).",
      "only_lines_matching": "^    public ",
      "scope": { "field": { "index": 7, "delimiter": " " } }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between classes.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": { "find": "\\A\\n+", "replace_with": "" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": { "find": "\\n\\s*\\z", "replace_with": "\n" }
    }
  ]
}
