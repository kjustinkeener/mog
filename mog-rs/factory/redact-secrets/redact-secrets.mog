{
  "name": "Redact Secrets",
  "description": "Mask common secrets and PII before sharing a log or config: emails, IPv4 addresses, AWS access keys, Stripe-style provider keys (sk_live_/pk_live_/rk_test_ ...), key=value secrets (api_key/secret/password/token/key/access_key), Bearer tokens, and JWTs. A convenience pass for sharing, NOT a security guarantee: it can over-redact (any 4-part dotted number reads as an IP) and under-redact (names, phone numbers, and unknown secret shapes slip through).",
  "summary": "Mask common secrets and PII for sharing",
  "tags": ["redact", "secrets", "pii", "email", "paste", "log"],
  "steps": [
    { "action": "replace_regex", "description": "Emails", "options": { "find": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "replace_with": "[EMAIL]" } },
    { "action": "replace_regex", "description": "IPv4 addresses", "options": { "find": "\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b", "replace_with": "[IP]" } },
    { "action": "replace_regex", "description": "AWS access key IDs", "options": { "find": "\\bAKIA[0-9A-Z]{16}\\b", "replace_with": "[AWS_KEY]" } },
    { "action": "replace_regex", "description": "Provider secret keys (Stripe-style sk/pk/rk live/test)", "options": { "find": "\\b(sk|pk|rk)_(live|test)_[A-Za-z0-9]{6,}", "replace_with": "[REDACTED]" } },
    { "action": "replace_regex", "description": "key=value secrets (keep the key, mask the value)", "options": { "find": "(?i)\\b(api[_-]?key|secret|password|passwd|access[_-]?key|token|key)\\b(\\s*[:=]\\s*)(\"?)[^\\s\"']+", "replace_with": "${1}${2}${3}[REDACTED]" } },
    { "action": "replace_regex", "description": "Bearer tokens (keep the scheme, mask the token)", "options": { "find": "(?i)(bearer\\s+)[A-Za-z0-9._~+/=-]+", "replace_with": "${1}[TOKEN]" } },
    { "action": "replace_regex", "description": "Standalone JWTs", "options": { "find": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b", "replace_with": "[JWT]" } }
  ]
}
