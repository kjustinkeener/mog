{
  "name": "Normalize phone numbers to E.164",
  "description": "Rewrite a messy phone column into E.164 (+15551234567): drop spaces, parentheses, dots, slashes and hyphens, turn a leading 00 international prefix into a plus sign, and give a bare national number the default country code. The default column is the third comma-separated field and the default country is +1 (US/Canada, so a bare number must be 10 digits, or 11 digits starting with 1); edit the scope index or the country code on the steps for another layout. Nothing is guessed: any value that does not end up as a plus sign followed by 8 to 15 digits (a trailing extension, a truncated number, letters such as 555-CALL-NOW) keeps its digits, gets no country code, and is flagged for review.",
  "summary": "Rewrite a phone column to E.164 and flag the rest",
  "tags": [
    "phone",
    "contacts",
    "csv",
    "normalize",
    "data",
    "cleanup"
  ],
  "steps": [
    {
      "action": "replace_regex",
      "description": "Strip separators from the phone column",
      "options": {
        "find": "[\\s()./\\u00a0-]",
        "replace_with": ""
      },
      "scope": {
        "field": {
          "index": 3,
          "delimiter": ","
        }
      }
    },
    {
      "action": "replace_regex",
      "description": "Leading 00 international prefix to a plus sign",
      "options": {
        "find": "\\A00(\\d+)\\z",
        "replace_with": "+${1}"
      },
      "scope": {
        "field": {
          "index": 3,
          "delimiter": ","
        }
      }
    },
    {
      "action": "replace_regex",
      "description": "Eleven-digit national number keeps its country digit",
      "options": {
        "find": "\\A1(\\d{10})\\z",
        "replace_with": "+1${1}"
      },
      "scope": {
        "field": {
          "index": 3,
          "delimiter": ","
        }
      }
    },
    {
      "action": "replace_regex",
      "description": "Bare ten-digit number gets the default country code",
      "options": {
        "find": "\\A(\\d{10})\\z",
        "replace_with": "+1${1}"
      },
      "scope": {
        "field": {
          "index": 3,
          "delimiter": ","
        }
      }
    },
    {
      "action": "flag_matching",
      "description": "Flag values that are not valid E.164",
      "options": {
        "pattern": ",(?!\\+\\d{8,15}$)[^,]*\\d[^,]*$",
        "message": "not a plausible E.164 value; left as written for review",
        "comment": "#",
        "tag": "FIXME"
      }
    }
  ]
}
