{
  "name": "Strip SQL comments",
  "description": "Remove SQL comments: /* block comments */ (including multi-line) and -- line comments (from the marker to end of line, with the preceding spaces/tabs), then trim any trailing whitespace left behind. Mechanical: a -- or /* that appears inside a string literal would also be stripped, so review queries with such literals. Assumes LF text.",
  "summary": "Remove SQL block and line comments",
  "tags": [
    "sql",
    "comment",
    "strip",
    "cleanup",
    "minify"
  ],
  "steps": [
    {
      "action": "replace_regex",
      "description": "Remove /* ... */ block comments (dotall, non-greedy)",
      "options": {
        "find": "(?s)/\\*.*?\\*/",
        "replace_with": ""
      }
    },
    {
      "action": "replace_regex",
      "description": "Remove -- line comments to end of line (with leading spaces/tabs)",
      "options": {
        "find": "[ \\t]*--[^\\n]*",
        "replace_with": ""
      }
    },
    {
      "action": "trim_whitespace_right",
      "description": "Clean up any trailing whitespace the removals left"
    }
  ]
}
