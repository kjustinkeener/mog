{
  "name": "Databricks SHOW CREATE TABLE to Postgres",
  "summary": "Convert a Databricks/Spark table export to PostgreSQL DDL",
  "description": "Convert Databricks 'SHOW CREATE TABLE' output to PostgreSQL. Strips Delta/Spark export noise (USING/LOCATION/TBLPROPERTIES, PARTITIONED BY/CLUSTER BY flagged), reduces catalog.schema.table to schema.table, maps Spark scalar types to Postgres (STRING->TEXT, LONG->BIGINT, SHORT->SMALLINT, BYTE->SMALLINT), collapses nested ARRAY/MAP/STRUCT<...> to JSONB (flagged), maps TIMESTAMP (instant) to TIMESTAMPTZ, and drops the trailing table COMMENT.",
  "tags": ["sql", "databricks", "spark", "postgres", "convert", "migration"],
  "dependencies": ["strip-databricks-export-noise"],
  "steps": [
    { "section": "Strip export noise", "action": "run_mog", "options": { "file": "strip-databricks-export-noise.mog" } },
    { "section": "Identifiers", "action": "replace_regex", "description": "Reduce catalog.schema.table to schema.table (Postgres has no Unity catalog).",
      "options": { "find": "(?im)^(CREATE(?: OR REPLACE)? TABLE )\\w+\\.(\\w+\\.\\w+)", "replace_with": "$1$2" } },
    { "section": "Types", "action": "replace_regex", "description": "Collapse nested ARRAY/MAP/STRUCT<...> to JSONB (flagged separately).",
      "options": { "find": "\\b(?:ARRAY|MAP|STRUCT)\\s*<[^<>]*>", "replace_with": "JSONB" } },
    { "section": "Types", "action": "flag_matching", "description": "Flag JSONB columns collapsed from a Databricks nested type.",
      "options": { "pattern": "\\bJSONB\\b", "message": "collapsed from a Databricks nested type; element/field types were lost", "comment": "--", "tag": "TODO", "position": "inline" } },
    { "section": "Types", "action": "replace_regex", "description": "Spark TIMESTAMP (instant) -> TIMESTAMPTZ.",
      "options": { "find": "\\bTIMESTAMP\\b", "replace_with": "TIMESTAMPTZ" } },
    { "section": "Types", "action": "replace_map", "description": "Map Spark scalar type keywords to Postgres.",
      "options": { "whole_word": true, "map": { "STRING": "TEXT", "LONG": "BIGINT", "SHORT": "SMALLINT", "BYTE": "SMALLINT" } } },
    { "section": "Comments", "action": "replace_regex", "description": "Drop the trailing table COMMENT (Postgres uses COMMENT ON).",
      "options": { "find": "(?m)^COMMENT '[^']*'", "replace_with": "-- TODO(mog): table comment dropped (use COMMENT ON TABLE in Postgres)" } }
  ]
}
