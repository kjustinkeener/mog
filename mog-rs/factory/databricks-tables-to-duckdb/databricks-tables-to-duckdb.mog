{
  "name": "Databricks SHOW CREATE TABLE to DuckDB",
  "summary": "Convert a Databricks/Spark table export to DuckDB DDL",
  "description": "Convert Databricks 'SHOW CREATE TABLE' output to DuckDB. Strips Delta/Spark export noise (USING/LOCATION/TBLPROPERTIES, PARTITIONED BY/CLUSTER BY flagged), maps Spark scalar types to DuckDB (STRING->VARCHAR, LONG->BIGINT, SHORT->SMALLINT, BYTE->TINYINT), collapses nested ARRAY/MAP/STRUCT<...> to JSON (flagged), maps TIMESTAMP (instant) to TIMESTAMPTZ, and drops the trailing table COMMENT (DuckDB has no inline table comment).",
  "tags": ["sql", "databricks", "spark", "duckdb", "warehouse", "convert", "migration"],
  "dependencies": ["strip-databricks-export-noise"],
  "steps": [
    { "section": "Strip export noise", "action": "run_mog",
      "options": { "file": "strip-databricks-export-noise.mog" } },
    { "section": "Identifiers", "action": "replace_regex", "description": "Reduce catalog.schema.table to the bare table (DuckDB has no Unity catalog).",
      "options": { "find": "(?im)^(CREATE(?: OR REPLACE)? TABLE )\\w+\\.\\w+\\.(\\w+)", "replace_with": "$1$2" } },
    { "section": "Types", "action": "replace_regex", "description": "Collapse nested ARRAY/MAP/STRUCT<...> to JSON (flagged separately).",
      "options": { "find": "\\b(?:ARRAY|MAP|STRUCT)\\s*<[^<>]*>", "replace_with": "JSON" } },
    { "section": "Types", "action": "flag_matching", "description": "Flag JSON columns collapsed from a Databricks nested type.",
      "options": { "pattern": "\\bJSON\\b", "message": "collapsed from a Databricks nested type; element/field types were lost", "comment": "--", "tag": "TODO", "position": "inline" } },
    { "section": "Types", "action": "replace_regex", "description": "Spark TIMESTAMP (instant) -> DuckDB TIMESTAMPTZ.",
      "options": { "find": "\\bTIMESTAMP\\b", "replace_with": "TIMESTAMPTZ" } },
    { "section": "Types", "action": "replace_map", "description": "Map Spark scalar type keywords to DuckDB.",
      "options": { "whole_word": true, "map": { "STRING": "VARCHAR", "LONG": "BIGINT", "SHORT": "SMALLINT", "BYTE": "TINYINT" } } },
    { "section": "Comments", "action": "replace_regex", "description": "Drop the trailing table COMMENT (DuckDB has no inline table comment).",
      "options": { "find": "(?m)^COMMENT '[^']*'", "replace_with": "-- TODO(mog): table comment dropped (use COMMENT ON TABLE in DuckDB)" } }
  ]
}
