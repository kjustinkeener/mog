{
  "name": "Allowlist filter (intersect with a list)",
  "description": "Keep only the input lines that appear in an allowlist, dropping everything else. Point the 'allowlist' source at the approved set (permitted hosts, whitelisted emails, supported SKUs) with --source allowlist=<path>. Comparison trims each line and ignores case; input order and duplicates are preserved. This is a keep-what-is-approved filter; use 'new-lines-only' (subtract) for the opposite.",
  "summary": "Keep only lines that appear in an allowlist",
  "tags": [
    "compare",
    "filter"
  ],
  "sources": {
    "allowlist": "allowlist-filter.Allowlist.txt"
  },
  "steps": [
    {
      "action": "intersect",
      "description": "Keep only lines whose text is on the allowlist",
      "options": {
        "ref": "allowlist",
        "trim": true,
        "ignore_case": true
      }
    }
  ]
}
