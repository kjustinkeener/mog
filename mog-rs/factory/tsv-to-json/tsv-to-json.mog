{
  "name": "TSV to JSON",
  "description": "Convert a tab-separated table (first line = header) into a JSON array of objects, one object per data row keyed by the header names. Quote-aware. Values are kept as strings by default.",
  "summary": "Convert TSV to a JSON array of objects",
  "tags": [
