{
  "name": "pg_dump (Postgres) tables to TypeScript interfaces",
  "summary": "Generate TypeScript interfaces from pg_dump --schema-only output",
  "description": "Generate TypeScript 'export interface' declarations from a pg_dump --schema-only export, one interface per table, 2-space indented. Discards non-table statements (sequences, indexes, triggers, ALTERs). Column/member names are kept exactly as in the database (snake_case, matching driver row keys); only the interface name is PascalCased. Postgres types map to TypeScript types (integer/serial/smallint/bigint/numeric/decimal/real/double precision -> number, boolean -> boolean, character varying/varchar/char/bpchar/text/uuid -> string, timestamp/timestamptz/date/time/timetz -> string as ISO-8601 text, bytea -> Uint8Array, json/jsonb -> unknown). Nullable columns get a '<type> | null' union rather than an optional '?' member. Exotic types (enum -> string, text[] -> string[], tsvector -> string) map best-effort and are flagged inline with a // TODO(mog): comment. Assumes LF.",
  "tags": [
    "sql",
    "postgres",
    "typescript",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-pgdump-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove pg_dump banners, SET block, restrict directives and object comments.",
      "options": {
        "file": "strip-pgdump-noise.mog"
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE SEQUENCE statements (multi-line, to the first ';').",
      "options": {
        "find": "(?ms)^CREATE SEQUENCE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER SEQUENCE statements.",
      "options": {
        "find": "(?ms)^ALTER SEQUENCE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER TABLE statements (constraints, defaults, foreign keys).",
      "options": {
        "find": "(?ms)^ALTER TABLE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE INDEX statements.",
      "options": {
        "find": "(?m)^CREATE (?:UNIQUE )?INDEX\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE TRIGGER statements.",
      "options": {
        "find": "(?m)^CREATE TRIGGER\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE VIEW / MATERIALIZED VIEW statements.",
      "options": {
        "find": "(?ms)^CREATE (?:MATERIALIZED )?VIEW\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Interface shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE TABLE public.<tbl> (' into a TypeScript interface header + opening brace.",
      "options": {
        "find": "(?m)^CREATE TABLE (?:public\\.)?(\\w+) \\($",
        "replace_with": "export interface ${1} {"
      }
    },
    {
      "section": "Interface shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ');' into a closing brace.",
      "options": {
        "find": "(?m)^\\);$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines (nextval, now(), literals).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres enum columns (public.<type>): mapped to string.",
      "options": {
        "pattern": "\\bpublic\\.\\w+",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres enum; consider a TypeScript union type instead of string.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres array columns: mapped to a TypeScript array.",
      "options": {
        "pattern": "\\w\\[\\]",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres array; verify element mapping and chosen TypeScript type.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres tsvector columns: mapped to string.",
      "options": {
        "pattern": "\\btsvector\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres full-search vector; stored as string, not searchable in TypeScript.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character varying(n) -> string.",
      "options": { "find": "(?i)\\bcharacter varying\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character varying / varchar -> string.",
      "options": { "find": "(?i)\\b(?:character varying|varchar)(?:\\(\\d+\\))?", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character(n) / char(n) -> string.",
      "options": { "find": "(?i)\\b(?:character|char|bpchar)\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare character / char / bpchar -> string.",
      "options": { "find": "(?i)\\b(?:character|bpchar|char)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamp with/without time zone -> string (ISO-8601 text).",
      "options": { "find": "(?i)\\btimestamp(?: with(?:out)? time zone| without time zone)?\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamptz -> string (ISO-8601 text).",
      "options": { "find": "(?i)\\btimestamptz\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "time with/without time zone / timetz / time -> string (ISO-8601 text).",
      "options": { "find": "(?i)\\b(?:time(?: with(?:out)? time zone)?|timetz)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "double precision -> number.",
      "options": { "find": "(?i)\\bdouble precision\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "numeric(p,s) / decimal(p,s) -> number.",
      "options": { "find": "(?i)\\b(?:numeric|decimal)\\(\\d+,\\s*\\d+\\)", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare numeric / decimal -> number.",
      "options": { "find": "(?i)\\b(?:numeric|decimal)\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bigserial / bigint -> number.",
      "options": { "find": "(?i)\\b(?:bigserial|bigint)\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "smallserial / smallint -> number.",
      "options": { "find": "(?i)\\b(?:smallserial|smallint)\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "serial / integer / int -> number.",
      "options": { "find": "(?i)\\b(?:serial|integer|int)\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "boolean / bool -> boolean.",
      "options": { "find": "(?i)\\b(?:boolean|bool)\\b", "replace_with": "boolean" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "real -> number.",
      "options": { "find": "(?i)\\breal\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare double -> number.",
      "options": { "find": "(?i)\\bdouble\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Postgres enum reference (public.<type>) -> string (flagged above).",
      "options": { "find": "(?i)\\bpublic\\.\\w+", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text[] array -> string[] (flagged above).",
      "options": { "find": "(?i)\\btext\\[\\]", "replace_with": "string[]" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tsvector -> string (flagged above).",
      "options": { "find": "(?i)\\btsvector\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text -> string.",
      "options": { "find": "(?i)\\btext\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "uuid -> string.",
      "options": { "find": "(?i)\\buuid\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bytea -> Uint8Array.",
      "options": { "find": "(?i)\\bbytea\\b", "replace_with": "Uint8Array" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "date -> string (ISO-8601 text).",
      "options": { "find": "(?i)\\bdate\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "jsonb / json -> unknown.",
      "options": { "find": "(?i)\\bjsonb?\\b", "replace_with": "unknown" }
    },
    {
      "section": "Members",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a TypeScript member with a '| null' union (2-space indent).",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "  ${2}: ${3} | null;${4}"
      }
    },
    {
      "section": "Members",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a TypeScript member (2-space indent).",
      "options": {
        "find": "(?m)^    (\\w+) (\\S+)( // .*)?$",
        "replace_with": "  ${1}: ${2};${3}"
      }
    },
    {
      "section": "Members",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": { "find": "@@N@@", "replace_with": "" }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each interface name (the table identifier); column members stay snake_case.",
      "only_lines_matching": "^export interface ",
      "scope": { "field": { "index": 3, "delimiter": " " } }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between interfaces.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": { "find": "\\A\\n+", "replace_with": "" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": { "find": "\\n\\s*\\z", "replace_with": "\n" }
    }
  ]
}
