{
  "name": "pg_dump (Postgres) tables to C# classes",
  "summary": "Generate C# POCO classes from pg_dump --schema-only output",
  "description": "Generate idiomatic C# POCO classes from a real 'pg_dump --schema-only' export, one class per table. Discards every non-table statement (sequences, indexes, triggers, ALTERs), then rewrites each CREATE TABLE into a 'public class' with one auto-property per column. Postgres types map to C# types (integer->int, bigint->long, smallint->short, boolean->bool, numeric->decimal, real->float, double precision->double, character varying/text/char->string, timestamp/timestamptz->DateTime, date->DateOnly, time->TimeOnly, uuid->Guid, bytea->byte[], json/jsonb->string). Nullable columns (no NOT NULL) get a nullable type ('?'); timestamptz maps to DateTime (not DateTimeOffset). Table and column identifiers are PascalCased. Types with no clean C# equivalent (enum, tsvector, array text[]) map to a best-effort type flagged with a // TODO(mog): comment. Assumes LF.",
  "tags": [
    "sql",
    "postgres",
    "csharp",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-pgdump-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove pg_dump banners, SET block, restrict directives and object comments.",
      "options": {
        "file": "strip-pgdump-noise.mog"
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE SEQUENCE statements (multi-line, to the first ';').",
      "options": {
        "find": "(?ms)^CREATE SEQUENCE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER SEQUENCE statements.",
      "options": {
        "find": "(?ms)^ALTER SEQUENCE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER TABLE statements (constraints, defaults, foreign keys).",
      "options": {
        "find": "(?ms)^ALTER TABLE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE INDEX statements.",
      "options": {
        "find": "(?m)^CREATE (?:UNIQUE )?INDEX\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE TRIGGER statements.",
      "options": {
        "find": "(?m)^CREATE TRIGGER\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE VIEW / MATERIALIZED VIEW statements.",
      "options": {
        "find": "(?ms)^CREATE (?:MATERIALIZED )?VIEW\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE TABLE public.<tbl> (' into a C# class header + opening brace.",
      "options": {
        "find": "(?m)^CREATE TABLE (?:public\\.)?(\\w+) \\($",
        "replace_with": "public class ${1}\n{"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ');' into a closing brace.",
      "options": {
        "find": "(?m)^\\);$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines (nextval, now(), literals).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres enum columns (public.<type>): mapped to string.",
      "options": {
        "pattern": "\\bpublic\\.\\w+",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres enum; consider a C# enum instead of string.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres array columns: mapped to a C# array.",
      "options": {
        "pattern": "\\w\\[\\]",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres array; verify element mapping and chosen C# collection.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres tsvector columns: mapped to string.",
      "options": {
        "pattern": "\\btsvector\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres full-search vector; stored as string, not searchable in C#.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character varying(n) -> string.",
      "options": { "find": "(?i)\\bcharacter varying\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character varying / varchar -> string.",
      "options": { "find": "(?i)\\b(?:character varying|varchar)(?:\\(\\d+\\))?", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character(n) / char(n) -> string.",
      "options": { "find": "(?i)\\b(?:character|char|bpchar)\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare character / char / bpchar -> string.",
      "options": { "find": "(?i)\\b(?:character|bpchar|char)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamp with/without time zone -> DateTime (timestamptz maps to DateTime, not DateTimeOffset).",
      "options": { "find": "(?i)\\btimestamp(?: with(?:out)? time zone| without time zone)?\\b", "replace_with": "DateTime" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamptz -> DateTime.",
      "options": { "find": "(?i)\\btimestamptz\\b", "replace_with": "DateTime" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "time with/without time zone / timetz / time -> TimeOnly.",
      "options": { "find": "(?i)\\b(?:time(?: with(?:out)? time zone)?|timetz)\\b", "replace_with": "TimeOnly" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "double precision -> double.",
      "options": { "find": "(?i)\\bdouble precision\\b", "replace_with": "double" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "numeric(p,s) / decimal(p,s) -> decimal.",
      "options": { "find": "(?i)\\b(?:numeric|decimal)\\(\\d+,\\s*\\d+\\)", "replace_with": "decimal" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare numeric / decimal -> decimal.",
      "options": { "find": "(?i)\\b(?:numeric|decimal)\\b", "replace_with": "decimal" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bigserial / bigint -> long.",
      "options": { "find": "(?i)\\b(?:bigserial|bigint)\\b", "replace_with": "long" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "smallserial / smallint -> short.",
      "options": { "find": "(?i)\\b(?:smallserial|smallint)\\b", "replace_with": "short" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "serial / integer / int -> int.",
      "options": { "find": "(?i)\\b(?:serial|integer|int)\\b", "replace_with": "int" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "boolean / bool -> bool.",
      "options": { "find": "(?i)\\b(?:boolean|bool)\\b", "replace_with": "bool" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "real -> float.",
      "options": { "find": "(?i)\\breal\\b", "replace_with": "float" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare double -> double.",
      "options": { "find": "(?i)\\bdouble\\b", "replace_with": "double" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Postgres enum reference (public.<type>) -> string (flagged above).",
      "options": { "find": "(?i)\\bpublic\\.\\w+", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text[] array -> string[] (flagged above).",
      "options": { "find": "(?i)\\btext\\[\\]", "replace_with": "string[]" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tsvector -> string (flagged above).",
      "options": { "find": "(?i)\\btsvector\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text -> string.",
      "options": { "find": "(?i)\\btext\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "uuid -> Guid.",
      "options": { "find": "(?i)\\buuid\\b", "replace_with": "Guid" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bytea -> byte[].",
      "options": { "find": "(?i)\\bbytea\\b", "replace_with": "byte[]" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "date -> DateOnly.",
      "options": { "find": "(?i)\\bdate\\b", "replace_with": "DateOnly" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "jsonb / json -> string.",
      "options": { "find": "(?i)\\bjsonb?\\b", "replace_with": "string" }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a C# auto-property with a nullable type.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "${1}public ${3}? ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a C# auto-property.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)( // .*)?$",
        "replace_with": "${1}public ${3} ${2} { get; set; }${4}"
      }
    },
    {
      "section": "Properties",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": { "find": "@@N@@", "replace_with": "" }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each class name (the table identifier).",
      "only_lines_matching": "^public class ",
      "scope": { "field": { "index": 3, "delimiter": " " } }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each property name (the column identifier).",
      "only_lines_matching": "^    public ",
      "scope": { "field": { "index": 7, "delimiter": " " } }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between classes.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": { "find": "\\A\\n+", "replace_with": "" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": { "find": "\\n\\s*\\z", "replace_with": "\n" }
    }
  ]
}
