{
  "name": "SQLite to Postgres",
  "summary": "Convert a SQLite table definition to PostgreSQL DDL",
  "description": "Convert SQLite .schema output to PostgreSQL DDL: rewrites INTEGER PRIMARY KEY AUTOINCREMENT to a Postgres identity column, and maps SQLite storage classes (REAL->DOUBLE PRECISION, BLOB->BYTEA; TEXT/INTEGER pass through).",
  "tags": [
    "sql",
    "sqlite",
    "postgres",
    "convert",
    "migration"
  ],
  "steps": [
    {
      "section": "Columns",
      "action": "replace_regex",
      "options": {
        "find": "(?i)INTEGER PRIMARY KEY AUTOINCREMENT",
        "replace_with": "BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "options": {
        "find": "(?i)\\bREAL\\b",
        "replace_with": "DOUBLE PRECISION"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "options": {
        "find": "(?i)\\bBLOB\\b",
        "replace_with": "BYTEA"
      }
    }
  ]
}
