{
  "name": "Insert a line after each match",
  "summary": "Add a new line after every line matching a pattern",
  "description": "Insert a fixed line of text immediately after every line matching a regex. This mog stamps a comment after each line beginning with BEGIN; change the pattern/text to annotate any marker.",
  "tags": [
    "line",
    "sql",
    "comment",
    "fragment",
    "single-action"
  ],
  "steps": [
    {
      "action": "insert_after_matching",
      "description": "Insert a comment after each BEGIN line",
      "options": {
        "pattern": "^BEGIN",
        "text": "-- inserted by mog"
      }
    }
  ]
}
