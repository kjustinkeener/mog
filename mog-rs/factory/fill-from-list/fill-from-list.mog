{
  "name": "Fill placeholders from a list",
  "summary": "Replace each marker with the next value from a list",
  "description": "Replace each occurrence of a marker with the next value from a named list source, in order. This recipe fills each <NAME> from a bundled Names list. Use for stitching a column of values back into a template. on_exhausted=leave keeps extra markers if the list runs out.",
  "tags": [
    "data",
    "fill",
    "codegen",
    "docs",
    "redact"
  ],
  "sources": {
    "names": "fill-from-list.Names.txt"
  },
  "steps": [
    {
      "action": "fill_from_list",
      "description": "Fill each <NAME> from the names list",
      "options": {
        "source": "names",
        "find": "<NAME>",
        "on_exhausted": "leave"
      }
    }
  ]
}
