{
  "name": "Append text to every line",
  "summary": "Add a fixed suffix to the end of each line",
  "description": "Append a fixed string to the end of every line. This recipe adds a semicolon; change the suffix via -D or by editing the step (e.g. a trailing comma for a list, or a Markdown line break).",
  "tags": [
    "prefix",
    "line",
    "format",
    "single-action"
  ],
  "steps": [
    {
      "action": "suffix_lines",
      "description": "Append ';' to each line",
      "options": {
        "text": ";"
      }
    }
  ]
}
