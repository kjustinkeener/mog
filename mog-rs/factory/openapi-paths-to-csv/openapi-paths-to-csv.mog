{
  "name": "OpenAPI paths to CSV",
  "description": "Turn an OpenAPI 3.x description into a CSV endpoint table -- one row per path+method, with the columns path,method,operation_id,summary,tags. Input may be JSON or YAML (YAML is a superset of JSON, so the same parse handles both) and is read with the real YAML/JSON parsers, not scraped: the spec is parsed, the paths object is lifted out as a balanced JSON value, and re-serialized as canonical YAML so every key sits at a known indent. The methods are the HTTP verb keys under each path (get, put, post, delete, options, head, patch, trace); anything else at that level -- a path-level $ref, shared parameters, servers, summary/description, x- extensions -- is dropped, and a path that ends up with no operation rows is flagged rather than silently vanishing. Multiple tags are joined with a semicolon. Values are emitted as RFC 4180 CSV, so a summary holding a comma or a quote is quoted and internal quotes are doubled -- sort or filter the result to review an API surface, diff two versions of a spec, or check that every operation has an operationId. Scope: one spec per file, and only operationId, summary and tags are exported (parameters, requestBody, responses, security and deprecated are not). $ref resolution is out of scope: a $ref is not followed, so an operation defined behind one contributes no row and its path is flagged. The webhooks and callbacks sections are not read -- this is the paths object only.",
  "summary": "Convert an OpenAPI 3 spec to a CSV table of endpoints",
  "tags": [
    "openapi",
    "swagger",
    "yaml",
    "json",
    "csv",
    "convert",
    "api"
  ],
  "steps": [
    {
      "section": "Lift the paths object",
      "action": "yaml_to_json",
      "description": "Parse the spec (YAML or JSON) and re-serialize it on a single line.",
      "options": {
        "compact": true
      }
    },
    {
      "action": "replace_regex",
      "description": "Drop everything ahead of the paths object.",
      "options": {
        "find": "^.*?\"paths\"\\s*:\\s*",
        "replace_with": ""
      }
    },
    {
      "action": "extract_json",
      "description": "Take the balanced paths object and discard the rest of the spec."
    },
    {
      "action": "json_to_yaml",
      "description": "Re-emit the paths object as canonical YAML so every key sits at a known indent."
    },
    {
      "section": "Reduce the tree to the operation fields",
      "action": "remove_lines_matching",
      "description": "Drop everything below the operation fields (parameters, responses, schemas).",
      "options": {
        "pattern": "^      "
      }
    },
    {
      "action": "replace_regex",
      "description": "Fold each operation-level list onto its own key line.",
      "options": {
        "find": "\\n    - ",
        "replace_with": "\u001d"
      }
    },
    {
      "action": "remove_lines_matching",
      "description": "Keep only operationId, summary and tags at the operation level.",
      "options": {
        "pattern": "^    (?=\\S)(?!(?:operationId|summary|tags):)"
      }
    },
    {
      "action": "replace_regex",
      "description": "Fold each path-level list onto its own key line.",
      "options": {
        "find": "\\n  - ",
        "replace_with": "\u001d"
      }
    },
    {
      "action": "remove_lines_matching",
      "description": "Keep only the HTTP verb keys at the path level.",
      "options": {
        "pattern": "^  (?=\\S)(?!(?:get|put|post|delete|options|head|patch|trace):)"
      }
    },
    {
      "section": "Unquote the YAML-quoted values",
      "action": "replace_regex_multiline",
      "description": "Strip the single quotes YAML added around an operationId or summary.",
      "options": {
        "find": "(?m)^(    (?:operationId|summary): )'((?:[^']|'')*)'$",
        "replace_with": "${1}\u001c${2}"
      }
    },
    {
      "action": "replace",
      "description": "Undo YAML's doubled apostrophes inside those values.",
      "only_lines_matching": "\u001c",
      "options": {
        "find": "''",
        "replace_with": "'"
      }
    },
    {
      "action": "replace",
      "description": "Remove the unquoting marker.",
      "options": {
        "find": "\u001c",
        "replace_with": ""
      }
    },
    {
      "section": "Collapse each operation to one line",
      "action": "replace_regex",
      "description": "Fold an operation's fields onto its verb line.",
      "options": {
        "find": "\\n    ",
        "replace_with": "\u001e"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Close every operation line so a field value cannot run past its own field.",
      "options": {
        "find": "(?m)^(  \\w+:[^\\n]*)$",
        "replace_with": "${1}\u001e@@Z@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Capture each operation's operationId.",
      "options": {
        "find": "(?m)^(  \\w+:[^\\n]*?\\x1eoperationId: ([^\\x1e\\n]*)[^\\n]*)$",
        "replace_with": "${1}@@O@@${2}@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Give an operation with no operationId an empty one.",
      "options": {
        "find": "(?m)^(  \\w+:(?:(?!@@O@@)[^\\n])*)$",
        "replace_with": "${1}@@O@@@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Capture each operation's summary.",
      "options": {
        "find": "(?m)^(  \\w+:[^\\n]*?\\x1esummary: ([^\\x1e\\n]*)[^\\n]*)$",
        "replace_with": "${1}@@S@@${2}@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Give an operation with no summary an empty one.",
      "options": {
        "find": "(?m)^(  \\w+:(?:(?!@@S@@)[^\\n])*)$",
        "replace_with": "${1}@@S@@@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Capture each operation's tag list.",
      "options": {
        "find": "(?m)^(  \\w+:[^\\n]*?\\x1etags:((?:\\x1d[^\\x1e\\n]*)*)[^\\n]*)$",
        "replace_with": "${1}@@T@@${2}@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Give an operation with no tags an empty list.",
      "options": {
        "find": "(?m)^(  \\w+:(?:(?!@@T@@)[^\\n])*)$",
        "replace_with": "${1}@@T@@@@"
      }
    },
    {
      "section": "Build the rows",
      "action": "replace_regex_multiline",
      "description": "Rewrite each path line as a path row with the other columns blank.",
      "options": {
        "find": "(?m)^([^\\s][^\\n]*):$",
        "replace_with": "${1}\u001f@@PATHROW@@\u001f\u001f\u001f\u001f"
      }
    },
    {
      "action": "replace_regex",
      "description": "Strip the leading separator from a tag list.",
      "options": {
        "find": "@@T@@\u001d",
        "replace_with": "@@T@@"
      }
    },
    {
      "action": "replace_regex_multiline",
      "description": "Rewrite each operation line as a row with a blank path column.",
      "options": {
        "find": "(?m)^  (\\w+):[^\\n]*@@O@@(.*?)@@@@S@@(.*?)@@@@T@@(.*?)@@$",
        "replace_with": "\u001f${1}\u001f${2}\u001f${3}\u001f${4}"
      }
    },
    {
      "action": "replace",
      "description": "Join multiple tags with a semicolon.",
      "options": {
        "find": "\u001d",
        "replace_with": ";"
      }
    },
    {
      "action": "replace_regex",
      "description": "Mark a path row that no operation row follows.",
      "options": {
        "find": "(?m)^(.*@@PATHROW@@.*)\\n(?=.*@@PATHROW@@|\\z)",
        "replace_with": "${1}@@NOOPS@@\n"
      }
    },
    {
      "section": "Flag what did not become a row",
      "action": "flag_matching",
      "description": "Flag any leftover line the shapes above did not turn into a row.",
      "options": {
        "pattern": "^[^\\x1f\\n]+$",
        "message": "line was not recognised as a path or an operation; check the spec shape",
        "comment": "#",
        "tag": "WARN",
        "position": "before"
      }
    },
    {
      "action": "flag_matching",
      "description": "Flag a path that produced no operation rows.",
      "options": {
        "pattern": "@@NOOPS@@",
        "message": "path entry produced no operation rows; it may be a $ref or an extension key",
        "comment": "#",
        "tag": "WARN",
        "position": "before"
      }
    },
    {
      "section": "Carry the path down its operations",
      "action": "replace",
      "description": "Hide the double quotes from the quote-aware fill-down that follows.",
      "options": {
        "find": "\"",
        "replace_with": "@@DQ@@"
      }
    },
    {
      "action": "replace_regex",
      "description": "Mark genuinely empty cells so the fill-down cannot invent a value for them.",
      "options": {
        "find": "(?m)(?<=\\x1f)(?=\\x1f|$)",
        "replace_with": "@@E@@"
      }
    },
    {
      "action": "fill_down",
      "description": "Carry each path down onto its own operations.",
      "options": {
        "delimiter": "\u001f"
      }
    },
    {
      "action": "remove_lines_matching",
      "description": "Drop the path marker rows now that their paths are carried down.",
      "options": {
        "pattern": "@@PATHROW@@"
      }
    },
    {
      "action": "replace",
      "description": "Restore the marked empty cells.",
      "options": {
        "find": "@@E@@",
        "replace_with": ""
      }
    },
    {
      "action": "replace",
      "description": "Bring the double quotes back.",
      "options": {
        "find": "@@DQ@@",
        "replace_with": "\""
      }
    },
    {
      "section": "Emit the CSV table",
      "action": "replace",
      "description": "Double every embedded double quote.",
      "options": {
        "find": "\"",
        "replace_with": "\"\""
      }
    },
    {
      "action": "replace_regex",
      "description": "Wrap any field holding a comma or a quote in double quotes.",
      "options": {
        "find": "(?m)(^|\\x1f)([^\\x1f\\n]*[\",][^\\x1f\\n]*)(?=\\x1f|$)",
        "replace_with": "${1}\"${2}\""
      }
    },
    {
      "action": "replace",
      "description": "Swap each unit separator for a comma.",
      "options": {
        "find": "\u001f",
        "replace_with": ","
      }
    },
    {
      "action": "prepend",
      "description": "Add the CSV header row.",
      "options": {
        "text": "path,method,operation_id,summary,tags\n"
      }
    }
  ]
}
