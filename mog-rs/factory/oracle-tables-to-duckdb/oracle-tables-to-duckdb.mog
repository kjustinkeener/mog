{
  "name": "Oracle GET_DDL to DuckDB",
  "summary": "Convert an Oracle DBMS_METADATA.GET_DDL export to DuckDB DDL",
  "description": "Convert an Oracle DBMS_METADATA.GET_DDL export (storage suppressed) to DuckDB DDL. Flags and drops the inline IDENTITY spec and schema-qualified sequence NEXTVAL default (DuckDB has no inline IDENTITY; use a SEQUENCE + DEFAULT nextval), strips the GET_DDL boilerplate, and maps types: NUMBER(1,0)->SMALLINT, NUMBER(p,0)->BIGINT, NUMBER(p,s)->DECIMAL(p,s), bare NUMBER->DOUBLE, VARCHAR2->VARCHAR, CLOB/NCLOB->VARCHAR, RAW(n)->BLOB, TIMESTAMP(n) WITH TIME ZONE->TIMESTAMPTZ, TIMESTAMP(n)->TIMESTAMP, DATE->TIMESTAMP. Rewrites SYSDATE/SYSTIMESTAMP defaults to current_timestamp; VIRTUAL columns and CHECK/PRIMARY KEY/UNIQUE/NOT NULL constraints pass through. Execution-validated against a real DuckDB engine.",
  "tags": [
    "sql",
    "oracle",
    "duckdb",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-oracle-getddl-noise"
  ],
  "steps": [
    {
      "section": "Identity And Sequences",
      "action": "flag_matching",
      "description": "Flag Oracle inline IDENTITY (dropped below; DuckDB has no inline IDENTITY).",
      "options": {
        "pattern": "GENERATED BY DEFAULT AS IDENTITY",
        "message": "Oracle IDENTITY dropped; create a DuckDB SEQUENCE and set DEFAULT nextval('seq') on this column for auto-increment",
        "comment": "--",
        "tag": "TODO",
        "position": "before"
      }
    },
    {
      "action": "replace_regex",
      "description": "Drop the inline IDENTITY spec (MINVALUE..NOSCALE); keep the trailing NOT NULL. DuckDB has no inline IDENTITY. Runs before the fragment while the clause is intact.",
      "options": {
        "find": " GENERATED BY DEFAULT AS IDENTITY[^,]*NOSCALE",
        "replace_with": ""
      }
    },
    {
      "action": "flag_matching",
      "description": "Flag the Oracle sequence NEXTVAL default (dropped below; the referenced SEQUENCE does not exist in DuckDB).",
      "options": {
        "pattern": "\"NEXTVAL\"",
        "message": "Oracle sequence DEFAULT (seq.NEXTVAL) dropped; create a DuckDB SEQUENCE and set DEFAULT nextval('seq') if you need it",
        "comment": "--",
        "tag": "TODO",
        "position": "before"
      }
    },
    {
      "action": "replace_regex",
      "description": "Drop the schema-qualified sequence NEXTVAL default. Runs before the fragment, which would otherwise strip the quoting and leave a bare NEXTVAL.",
      "options": {
        "find": " DEFAULT \"[^\"]+\"\\.\"[^\"]+\"\\.\"NEXTVAL\"",
        "replace_with": ""
      }
    },
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Strip Oracle GET_DDL boilerplate: schema qualifier, double-quote quoting, ENABLE, CONSTRAINT USING INDEX, TIMESTAMP (n) spacing.",
      "options": {
        "file": "strip-oracle-getddl-noise.mog"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "TIMESTAMP(n) WITH TIME ZONE -> TIMESTAMPTZ (before bare TIMESTAMP, else it re-matches).",
      "options": {
        "find": "\\bTIMESTAMP\\(\\d+\\) WITH TIME ZONE",
        "replace_with": "TIMESTAMPTZ"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "Bare TIMESTAMP WITH TIME ZONE -> TIMESTAMPTZ.",
      "options": {
        "find": "\\bTIMESTAMP WITH TIME ZONE",
        "replace_with": "TIMESTAMPTZ"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "TIMESTAMP(n) -> TIMESTAMP (DuckDB TIMESTAMP is microsecond-precision).",
      "options": {
        "find": "\\bTIMESTAMP\\(\\d+\\)",
        "replace_with": "TIMESTAMP"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "NUMBER(1,0) -> SMALLINT (Oracle boolean-ish flag; DuckDB has no 1-byte int).",
      "options": {
        "find": "\\bNUMBER\\(1,\\s*0\\)",
        "replace_with": "SMALLINT"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "NUMBER(p,0) -> BIGINT (integer columns).",
      "options": {
        "find": "\\bNUMBER\\(\\d+,\\s*0\\)",
        "replace_with": "BIGINT"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "NUMBER(p,s) -> DECIMAL(p,s) (fixed-point; DuckDB DECIMAL max precision is 38).",
      "options": {
        "find": "\\bNUMBER\\((\\d+,\\s*\\d+)\\)",
        "replace_with": "DECIMAL($1)"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "Bare NUMBER (unconstrained Oracle float) -> DOUBLE.",
      "options": {
        "find": "\\bNUMBER\\b",
        "replace_with": "DOUBLE"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "VARCHAR2(n) -> VARCHAR(n) (DuckDB VARCHAR; the length is advisory).",
      "options": {
        "find": "\\bVARCHAR2\\b",
        "replace_with": "VARCHAR"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "CLOB / NCLOB -> VARCHAR (DuckDB has one unbounded string type).",
      "options": {
        "find": "\\bN?CLOB\\b",
        "replace_with": "VARCHAR"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "RAW(n) -> BLOB (DuckDB BLOB is unsized). BLOB passes through unchanged.",
      "options": {
        "find": "\\bRAW\\(\\d+\\)",
        "replace_with": "BLOB"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "DATE -> TIMESTAMP (Oracle DATE carries a time component; DuckDB DATE is date-only). Runs after SYSDATE is safe: \\b will not bite into SYSDATE.",
      "options": {
        "find": "\\bDATE\\b",
        "replace_with": "TIMESTAMP"
      }
    },
    {
      "section": "Defaults",
      "action": "replace_regex",
      "description": "DEFAULT SYSDATE -> current_timestamp.",
      "options": {
        "find": "\\bSYSDATE\\b",
        "replace_with": "current_timestamp"
      }
    },
    {
      "section": "Defaults",
      "action": "replace_regex",
      "description": "DEFAULT SYSTIMESTAMP -> current_timestamp.",
      "options": {
        "find": "\\bSYSTIMESTAMP\\b",
        "replace_with": "current_timestamp"
      }
    }
  ]
}
