{
  "name": "Snowflake tables to Python dataclasses",
  "summary": "Generate Python @dataclass classes from a Snowflake GET_DDL export",
  "description": "Generate Python standard-library @dataclass classes from a Snowflake table export (SELECT GET_DDL('TABLE', ...) or a Snowsight DDL copy), one class per table. Strips the Snowflake-only rendering (statement terminators, inline COMMENT 'x', the glued )COMMENT='x', cluster by, autoincrement, DEFAULT and table-level constraint lines). Snowflake identifiers are UPPER_SNAKE_CASE: the class name is PascalCased and field names are lowercased to snake_case. Snowflake types map to Python types (NUMBER(p,0)/INT/BIGINT -> int, NUMBER(p,s) s>0 -> Decimal, FLOAT/DOUBLE/REAL -> float, BOOLEAN -> bool, VARCHAR/STRING/TEXT/CHAR -> str, DATE -> date, TIME -> time, TIMESTAMP_NTZ/TIMESTAMP_TZ/TIMESTAMP_LTZ -> datetime, BINARY/VARBINARY -> bytes, VARIANT/OBJECT -> dict[str, Any], ARRAY -> list[Any]). Nullable columns become 'type | None'. Emits a fixed stdlib import header with 'from __future__ import annotations' so the module runs on Python 3.7+. Lossy mappings are flagged with a # TODO(mog): comment: semi-structured columns and NUMBER(p,s) fixed-point columns the connector may hand back as float. Assumes LF.",
  "tags": [
    "sql",
    "snowflake",
    "python",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-snowflake-getddl-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove the Snowflake GET_DDL rendering: statement terminators, inline column COMMENT 'x', the glued table )COMMENT='x', and the cluster by clause.",
      "options": {
        "file": "strip-snowflake-getddl-noise.mog"
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop the SQL comment lines the strip fragment leaves behind (the CLUSTER BY note).",
      "options": {
        "find": "(?m)^--[^\\n]*\\n?",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop table-level constraint lines (primary key, foreign key, unique, constraint).",
      "options": {
        "find": "(?mi)^[ \\t]*(?:primary key|foreign key|unique|constraint)\\b[^\\n]*\\n?",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Convert the tab indent GET_DDL emits to four spaces, so column lines have a fixed shape.",
      "options": {
        "find": "(?m)^\\t",
        "replace_with": "    "
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Rewrite each 'create or replace TABLE <tbl> (' header.",
      "options": {
        "find": "(?mi)^create or replace (?:transient |temporary |volatile )?table (?:\\w+\\.)*(\\w+) \\($",
        "replace_with": "@dataclass\nclass ${1}:"
      }
    },
    {
      "section": "Class shell",
      "action": "replace_regex",
      "description": "Drop each table-closing ')' entirely (Python has no closing brace).",
      "options": {
        "find": "(?m)^\\)$",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop the Snowflake autoincrement / identity clause.",
      "options": {
        "find": "(?i)\\s+(?:autoincrement|identity)(?:\\s+start\\s+-?\\d+\\s+increment\\s+-?\\d+)?(?:\\s+(?:no)?order)?",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop COLLATE clauses.",
      "options": {
        "find": "(?i)\\s+COLLATE\\s+'[^']*'",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses (sequences, CURRENT_TIMESTAMP(), literals).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag semi-structured VARIANT / OBJECT columns: mapped to dict.",
      "options": {
        "pattern": "\\b(?:VARIANT|OBJECT)\\b",
        "comment": "#",
        "tag": "TODO",
        "message": "Snowflake semi-structured column; the connector hands back raw JSON unless you parse it.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag ARRAY columns: Snowflake arrays are untyped.",
      "options": {
        "pattern": "\\bARRAY\\b",
        "comment": "#",
        "tag": "TODO",
        "message": "Snowflake list column has no declared element type; narrow it yourself.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag fixed-point columns (NUMBER(p,s) with s > 0): mapped to Decimal, not float.",
      "options": {
        "pattern": "\\bNUMBER\\(\\d+\\s*,\\s*[1-9]\\d*\\)",
        "comment": "#",
        "tag": "TODO",
        "message": "Snowflake fixed-point column; enable the connector's exact-value option so it does not approximate.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP_NTZ / DATETIME (wall-clock, no zone) -> datetime.",
      "options": {
        "find": "(?i)\\b(?:TIMESTAMP_NTZ|DATETIME)(?:\\(\\d+\\))?",
        "replace_with": "datetime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIMESTAMP_TZ / TIMESTAMP_LTZ (zone-aware) -> datetime.",
      "options": {
        "find": "(?i)\\bTIMESTAMP_(?:L?TZ)(?:\\(\\d+\\))?",
        "replace_with": "datetime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare TIMESTAMP (the session default, normally NTZ) -> datetime.",
      "options": {
        "find": "(?i)\\bTIMESTAMP(?:\\(\\d+\\))?",
        "replace_with": "datetime"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "TIME -> time.",
      "options": {
        "find": "(?i)\\bTIME(?:\\(\\d+\\))?",
        "replace_with": "time"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "DATE -> date.",
      "options": {
        "find": "(?i)\\bDATE\\b",
        "replace_with": "date"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,s) / DECIMAL(p,s) with s > 0 -> Decimal (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\s*,\\s*[1-9]\\d*\\)",
        "replace_with": "@@NUMS@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p <= 9 -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\([1-9]\\s*,\\s*0\\)",
        "replace_with": "@@NUMI@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p between 10 and 18 -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(1[0-8]\\s*,\\s*0\\)",
        "replace_with": "@@NUMM@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p,0) with p >= 19, including Snowflake's NUMBER(38,0) default -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\s*,\\s*0\\)",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "NUMBER(p) with no scale -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\(\\d+\\)",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare NUMBER / DECIMAL / NUMERIC (defaults to NUMBER(38,0)) -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:NUMBER|DECIMAL|NUMERIC)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BIGINT / INT / INTEGER (all aliases of NUMBER(38,0) in Snowflake) -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:BIGINT|INTEGER|INT)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "SMALLINT / TINYINT / BYTEINT (also NUMBER(38,0) in Snowflake) -> int (via sentinel).",
      "options": {
        "find": "(?i)\\b(?:SMALLINT|TINYINT|BYTEINT)\\b",
        "replace_with": "@@NUMB@@"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "FLOAT / FLOAT4 / FLOAT8 / DOUBLE PRECISION / DOUBLE / REAL -> float.",
      "options": {
        "find": "(?i)\\b(?:DOUBLE PRECISION|FLOAT8|FLOAT4|FLOAT|DOUBLE|REAL)\\b",
        "replace_with": "float"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BOOLEAN -> bool.",
      "options": {
        "find": "(?i)\\bBOOLEAN\\b",
        "replace_with": "bool"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "VARCHAR(n) / CHAR(n) / CHARACTER(n) -> str.",
      "options": {
        "find": "(?i)\\b(?:VARCHAR|CHARACTER VARYING|CHARACTER|NVARCHAR2|NVARCHAR|CHAR)\\(\\d+\\)",
        "replace_with": "str"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Bare VARCHAR / STRING / TEXT / CHAR -> str.",
      "options": {
        "find": "(?i)\\b(?:VARCHAR|CHARACTER VARYING|CHARACTER|STRING|TEXT|CHAR)\\b",
        "replace_with": "str"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "VARIANT -> dict (flagged above).",
      "options": {
        "find": "(?i)\\bVARIANT\\b",
        "replace_with": "dict"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "OBJECT -> dict (flagged above).",
      "options": {
        "find": "(?i)\\bOBJECT\\b",
        "replace_with": "dict"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "ARRAY -> list (flagged above).",
      "options": {
        "find": "(?i)\\bARRAY\\b",
        "replace_with": "list"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "GEOGRAPHY / GEOMETRY -> str (carry the GeoJSON/WKT text through).",
      "options": {
        "find": "(?i)\\b(?:GEOGRAPHY|GEOMETRY)\\b",
        "replace_with": "str"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "BINARY(n) / VARBINARY -> bytes (last, so it cannot be re-matched by an earlier rule).",
      "options": {
        "find": "(?i)\\b(?:VARBINARY|BINARY)(?:\\(\\d+\\))?",
        "replace_with": "bytes"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the fixed-point sentinel to Decimal.",
      "options": {
        "find": "@@NUMS@@",
        "replace_with": "Decimal"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the small-integer sentinel to int.",
      "options": {
        "find": "@@NUMI@@",
        "replace_with": "int"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the mid-integer sentinel to int.",
      "options": {
        "find": "@@NUMM@@",
        "replace_with": "int"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the wide-integer sentinel to int.",
      "options": {
        "find": "@@NUMB@@",
        "replace_with": "int"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a dataclass field with a 'type | None' annotation.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "${1}${2}: ${3} | None${4}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a dataclass field with a plain annotation.",
      "options": {
        "find": "(?m)^(    )(\\w+) (\\S+)( # .*)?$",
        "replace_with": "${1}${2}: ${3}${4}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": {
        "find": "@@N@@",
        "replace_with": ""
      }
    },
    {
      "section": "Naming",
      "action": "to_pascal",
      "description": "PascalCase each class name (the Snowflake table identifier).",
      "only_lines_matching": "^class ",
      "scope": {
        "field": {
          "index": 2,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Naming",
      "action": "to_lower",
      "description": "snake_case each field name; Snowflake returns UPPER_SNAKE_CASE identifiers.",
      "only_lines_matching": "^    \\w",
      "scope": {
        "field": {
          "index": 5,
          "delimiter": " "
        }
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between classes.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": {
        "find": "\\A\\n+",
        "replace_with": ""
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": {
        "find": "\\n\\s*\\z",
        "replace_with": "\n"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "Widen the bare dict annotation to dict[str, Any] so the output passes a strict type checker. Runs after nullability, and is anchored to the annotation so it never touches the word 'dict' inside a TODO comment.",
      "options": {
        "find": "(?m)^(    \\w+: )dict\\b",
        "replace_with": "${1}dict[str, Any]"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "Widen the bare list annotation to list[Any] so the output passes a strict type checker. The lookahead leaves an already-parameterised list[T] alone, and the anchor keeps the word 'list' in a TODO comment safe.",
      "options": {
        "find": "(?m)^(    \\w+: )list(?!\\[)\\b",
        "replace_with": "${1}list[Any]"
      }
    },
    {
      "section": "Header",
      "action": "replace_regex",
      "description": "Prepend the fixed stdlib import header (last, so the type-map regexes never touch 'date'/'time'/'Decimal' in the imports).",
      "options": {
        "find": "\\A",
        "replace_with": "from __future__ import annotations\nfrom dataclasses import dataclass\nfrom datetime import date, datetime, time\nfrom decimal import Decimal\nfrom typing import Any\n\n"
      }
    }
  ]
}
