{
  "name": "Alpaca to ShareGPT",
  "description": "Convert an Alpaca instruction dataset (JSONL, one record per line shaped {instruction, input, output}) into ShareGPT format ({conversations:[{from:human, value}, {from:gpt, value}]}). The instruction becomes the human turn and the output the gpt turn; a non-empty input is appended to the human turn after a blank line, and an empty input drops the trailing blank line. Assumes compact JSONL (no spaces after colons) with keys in canonical order instruction, input, output and an explicit input key (empty string when unused). Not handled: records missing the input key, extra fields (system, history), reordered keys, or multi-turn data.",
  "summary": "Convert Alpaca dataset to ShareGPT format",
  "tags": [
    "ml",
    "dataset",
    "fine-tuning",
    "convert",
    "jsonl"
  ],
  "steps": [
    { "section": "Empty-input records", "action": "replace_regex_multiline", "description": "instruction/output only -> human/gpt turns", "options": { "find": "^\\{\"instruction\":(\"(?:[^\"\\\\]|\\\\.)*\"),\"input\":\"\",\"output\":(\"(?:[^\"\\\\]|\\\\.)*\")\\}$", "replace_with": "{\"conversations\":[{\"from\":\"human\",\"value\":$1},{\"from\":\"gpt\",\"value\":$2}]}" } },
    { "section": "Records with input", "action": "replace_regex_multiline", "description": "merge instruction + input into the human turn", "options": { "find": "^\\{\"instruction\":\"((?:[^\"\\\\]|\\\\.)*)\",\"input\":\"((?:[^\"\\\\]|\\\\.)*)\",\"output\":(\"(?:[^\"\\\\]|\\\\.)*\")\\}$", "replace_with": "{\"conversations\":[{\"from\":\"human\",\"value\":\"$1\\n\\n$2\"},{\"from\":\"gpt\",\"value\":$3}]}" } }
  ]
}
