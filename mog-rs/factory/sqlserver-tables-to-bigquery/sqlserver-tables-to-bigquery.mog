{
  "name": "SQL Server (SSMS) to BigQuery table DDL",
  "summary": "Convert SQL Server table DDL to BigQuery",
  "description": "Convert a SQL Server SSMS 'Generate Scripts' / mssql-scripter table export to runnable BigQuery standard-SQL DDL. It (1) strips the SSMS server/session/DROP scaffolding (banners, SET options, CREATE/ALTER DATABASE, the DROP phase, constraint re-enables, and the sp_addextendedproperty MS_Description calls -- BigQuery column descriptions live in OPTIONS(), so the descriptions are dropped, not converted), (2) drops T-SQL [bracket] quoting and the dbo. schema qualifier, (3) maps T-SQL functions (newid/newsequentialid->GENERATE_UUID, sysdatetime/getdate->CURRENT_DATETIME, *utc*/sysdatetimeoffset->CURRENT_TIMESTAMP) and every T-SQL type to BigQuery (bigint/int/smallint/tinyint->INT64, bit->BOOL, decimal/numeric/money->NUMERIC, float/real->FLOAT64, nvarchar/varchar/nchar/char/text->STRING, uniqueidentifier/xml/hierarchyid/sql_variant->STRING, varbinary/binary/image->BYTES, datetime2->DATETIME, datetimeoffset->TIMESTAMP, datetime/smalldatetime->DATETIME, geography/geometry->GEOGRAPHY), (4) drops IDENTITY(seed,step) (BigQuery has no auto-increment) and flags each such column, and (5) flags every T-SQL construct with no runnable BigQuery form via -- TODO(mog): the PERSISTED computed column, the PRIMARY KEY (BigQuery only takes PRIMARY KEY ... NOT ENFORCED inside CREATE TABLE), separate DEFAULT constraints, CHECK and UNIQUE constraints, and secondary CREATE INDEX (BigQuery has none; use partitioning/clustering). Not a semantic transpiler. Assumes LF text.",
  "tags": [
    "sql",
    "mssql",
    "bigquery",
    "warehouse",
    "convert",
    "migration"
  ],
  "dependencies": [
    "mssql-strip-server-noise",
    "sql-finalize-whitespace"
  ],
  "steps": [
    {
      "section": "Normalize",
      "description": "Normalize to LF first so every later newline-sensitive regex is reliable.",
      "action": "eol_lf"
    },
    {
      "section": "Strip Export Noise",
      "description": "Remove SSMS server/session/DROP scaffolding (object banners, SET options, CREATE/ALTER DATABASE, the guarded DROP phase, ALTER TABLE CHECK CONSTRAINT re-enables, and the sp_addextendedproperty description calls). Shared fragment; runs on the raw SSMS text while GO batches are intact.",
      "action": "run_mog",
      "options": {
        "file": "mssql-strip-server-noise.mog"
      }
    },
    {
      "section": "Unsupported Objects",
      "description": "BigQuery has no secondary indexes: replace the whole CREATE [NON]CLUSTERED INDEX ... GO batch with a TODO. Runs before bracket-stripping so it can consume the full multi-line INCLUDE/WITH/ON PRIMARY batch in one match.",
      "action": "replace_regex",
      "options": {
        "find": "CREATE (?:UNIQUE )?(?:NONCLUSTERED |CLUSTERED )?INDEX \\[?(\\w+)\\]?[\\s\\S]*?\\nGO\\n",
        "replace_with": "-- TODO(mog): BigQuery has no secondary indexes; CREATE INDEX ${1} was dropped (use partitioning or clustering on the table instead).\n\n",
        "ignore_case": true
      }
    },
    {
      "section": "Quoting And Schema",
      "description": "Strip T-SQL square-bracket quoting: opening bracket.",
      "action": "replace",
      "options": { "find": "[", "replace_with": "" }
    },
    {
      "description": "Strip T-SQL square-bracket quoting: closing bracket.",
      "action": "replace",
      "options": { "find": "]", "replace_with": "" }
    },
    {
      "description": "Drop the dbo. schema qualifier so objects resolve in the active BigQuery dataset.",
      "action": "replace",
      "options": { "find": "dbo.", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "USE <db> + its GO -> a documenting comment (BigQuery selects a project/dataset on the job, not with USE <db> in DDL).",
      "action": "replace_regex",
      "options": {
        "find": "USE (\\w+)\\nGO\\n",
        "replace_with": "-- Dataset: ${1}\n\n",
        "ignore_case": true
      }
    },
    {
      "section": "Functions",
      "description": "Map T-SQL builtins to BigQuery. Runs before the type maps so a sys*datetime* function name is never corrupted. None of these keys is a substring of another (the trailing () differ), so replace_map is order-safe.",
      "action": "replace_map",
      "options": {
        "ignore_case": true,
        "map": {
          "newsequentialid()": "GENERATE_UUID()",
          "newid()": "GENERATE_UUID()",
          "sysdatetimeoffset()": "CURRENT_TIMESTAMP()",
          "sysutcdatetime()": "CURRENT_TIMESTAMP()",
          "sysdatetime()": "CURRENT_DATETIME()",
          "getutcdate()": "CURRENT_TIMESTAMP()",
          "getdate()": "CURRENT_DATETIME()"
        }
      }
    },
    {
      "section": "Identity",
      "description": "BigQuery has no auto-increment: flag every IDENTITY column, then drop the IDENTITY(seed,step) token. Flag first so the marker survives the strip.",
      "action": "flag_matching",
      "options": {
        "pattern": "IDENTITY\\(",
        "message": "BigQuery has no auto-increment; assign this key with GENERATE_UUID() or from the application",
        "comment": "--",
        "tag": "TODO",
        "ignore_case": true
      }
    },
    {
      "description": "Drop the IDENTITY(seed,step) token now that the column is flagged.",
      "action": "replace_regex",
      "options": {
        "find": "\\s*IDENTITY\\(\\d+,\\s*\\d+\\)",
        "replace_with": "",
        "ignore_case": true
      }
    },
    {
      "section": "Types",
      "description": "datetimeoffset(n) / bare -> TIMESTAMP (BigQuery TIMESTAMP has no precision argument).",
      "action": "replace_regex",
      "options": { "find": "\\bdatetimeoffset(\\(\\d+\\))?", "replace_with": "TIMESTAMP", "ignore_case": true }
    },
    {
      "description": "datetime2(n) / bare -> DATETIME (wall-clock; BigQuery DATETIME has no precision argument).",
      "action": "replace_regex",
      "options": { "find": "\\bdatetime2(\\(\\d+\\))?", "replace_with": "DATETIME", "ignore_case": true }
    },
    {
      "description": "smalldatetime -> DATETIME (run before datetime; it contains 'datetime').",
      "action": "replace",
      "options": { "find": "smalldatetime", "replace_with": "DATETIME", "ignore_case": true }
    },
    {
      "description": "datetime (wall-clock) -> DATETIME (whole word, so it never bites an identifier or a residual function name).",
      "action": "replace",
      "options": { "find": "datetime", "replace_with": "DATETIME", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "uniqueidentifier -> STRING (BigQuery has no native GUID type).",
      "action": "replace",
      "options": { "find": "uniqueidentifier", "replace_with": "STRING", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "bit -> BOOL (whole word). Any 0/1 default is carried in the DEFAULT-constraint TODO below.",
      "action": "replace",
      "options": { "find": "bit", "replace_with": "BOOL", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "nvarchar(max) -> STRING (run before varchar(max), which it contains).",
      "action": "replace",
      "options": { "find": "nvarchar(max)", "replace_with": "STRING", "ignore_case": true }
    },
    {
      "description": "varchar(max) -> STRING (BigQuery STRING is unbounded by default).",
      "action": "replace",
      "options": { "find": "varchar(max)", "replace_with": "STRING", "ignore_case": true }
    },
    {
      "description": "nvarchar(n) -> STRING(n) (BigQuery STRING is Unicode; the length limit is valid parameterized-STRING syntax).",
      "action": "replace",
      "options": { "find": "nvarchar", "replace_with": "STRING", "ignore_case": true }
    },
    {
      "description": "varchar(n) -> STRING(n).",
      "action": "replace",
      "options": { "find": "varchar", "replace_with": "STRING", "ignore_case": true }
    },
    {
      "description": "nchar -> STRING.",
      "action": "replace",
      "options": { "find": "nchar", "replace_with": "STRING", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "ntext -> STRING (LOB text type).",
      "action": "replace",
      "options": { "find": "ntext", "replace_with": "STRING", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "text -> STRING.",
      "action": "replace",
      "options": { "find": "text", "replace_with": "STRING", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "char(n) / bare char -> STRING.",
      "action": "replace",
      "options": { "find": "char", "replace_with": "STRING", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "smallmoney -> NUMERIC (run before money).",
      "action": "replace",
      "options": { "find": "smallmoney", "replace_with": "NUMERIC", "ignore_case": true }
    },
    {
      "description": "money -> NUMERIC (BigQuery fixed-point; 38,9).",
      "action": "replace",
      "options": { "find": "money", "replace_with": "NUMERIC", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "decimal -> NUMERIC (precision/scale preserved and valid in BigQuery).",
      "action": "replace",
      "options": { "find": "decimal", "replace_with": "NUMERIC", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "numeric -> NUMERIC (canonicalize the keyword spelling/case).",
      "action": "replace",
      "options": { "find": "numeric", "replace_with": "NUMERIC", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "varbinary(max) -> BYTES (run before varbinary(n)/binary).",
      "action": "replace",
      "options": { "find": "varbinary(max)", "replace_with": "BYTES", "ignore_case": true }
    },
    {
      "description": "varbinary(n) / bare varbinary -> BYTES.",
      "action": "replace_regex",
      "options": { "find": "\\bvarbinary(\\(\\d+\\))?", "replace_with": "BYTES", "ignore_case": true }
    },
    {
      "description": "binary(n) / bare binary -> BYTES.",
      "action": "replace_regex",
      "options": { "find": "\\bbinary(\\(\\d+\\))?", "replace_with": "BYTES", "ignore_case": true }
    },
    {
      "description": "image -> BYTES (legacy LOB).",
      "action": "replace",
      "options": { "find": "image", "replace_with": "BYTES", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "Remaining scalar type renames to BigQuery: integer family -> INT64, float/real -> FLOAT64, date/time keep, xml/hierarchyid/sql_variant -> STRING (no native type; review), geography/geometry -> GEOGRAPHY.",
      "action": "replace_map",
      "options": {
        "whole_word": true,
        "ignore_case": true,
        "map": {
          "bigint": "INT64",
          "int": "INT64",
          "smallint": "INT64",
          "tinyint": "INT64",
          "float": "FLOAT64",
          "real": "FLOAT64",
          "date": "DATE",
          "time": "TIME",
          "xml": "STRING",
          "hierarchyid": "STRING",
          "sql_variant": "STRING",
          "geography": "GEOGRAPHY",
          "geometry": "GEOGRAPHY"
        }
      }
    },
    {
      "section": "Computed Columns",
      "description": "A T-SQL computed/PERSISTED column has no runnable BigQuery column form: drop the column and leave a TODO in its place (the trailing comma goes with it; the preceding column keeps its own comma).",
      "action": "replace_regex",
      "options": {
        "find": "(?m)^(\\s*)(\\w+)\\s+AS \\((.+?)\\)\\s+PERSISTED,?\\s*$",
        "replace_with": "${1}-- TODO(mog): computed column ${2} = (${3}) [PERSISTED] has no BigQuery column form; recreate it as a view or a downstream derived column.",
        "ignore_case": true
      }
    },
    {
      "section": "Drop Storage Markers",
      "description": "Drop any index/constraint storage-option clause: WITH (PAD_INDEX = ...).",
      "action": "replace_regex",
      "options": { "find": "WITH \\(PAD_INDEX[^)]*\\)", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "Drop the CREATE TABLE filegroup placement 'ON PRIMARY TEXTIMAGE_ON PRIMARY'.",
      "action": "replace",
      "options": { "find": "ON PRIMARY TEXTIMAGE_ON PRIMARY", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "Drop remaining ' ON PRIMARY' filegroup placement.",
      "action": "replace",
      "options": { "find": " ON PRIMARY", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "Drop ' ASC' from inline key-column lists.",
      "action": "replace",
      "options": { "find": " ASC", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "Drop ' NONCLUSTERED' (no BigQuery equivalent).",
      "action": "replace",
      "options": { "find": " NONCLUSTERED", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "Drop ' CLUSTERED' (BigQuery clustering is a table option, not a constraint keyword).",
      "action": "replace",
      "options": { "find": " CLUSTERED", "replace_with": "", "ignore_case": true }
    },
    {
      "section": "Constraints",
      "description": "BigQuery only accepts PRIMARY KEY ... NOT ENFORCED inside a CREATE TABLE, not via ALTER ADD CONSTRAINT: flag the whole PK batch (fold it into the CREATE TABLE with NOT ENFORCED).",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+ ADD\\s+CONSTRAINT (\\w+) PRIMARY KEY\\s*\\(\\s*(\\w+)\\s*\\)\\s*\\nGO\\n",
        "replace_with": "-- TODO(mog): BigQuery takes PRIMARY KEY (${2}) NOT ENFORCED only inside CREATE TABLE; fold constraint ${1} into the table (dropped).\n\n",
        "ignore_case": true
      }
    },
    {
      "description": "BigQuery has no UNIQUE constraint: flag the ALTER TABLE ADD CONSTRAINT ... UNIQUE batch.",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+ ADD\\s+CONSTRAINT (\\w+) UNIQUE\\s*\\(\\s*(\\w+)\\s*\\)\\s*\\nGO\\n",
        "replace_with": "-- TODO(mog): BigQuery has no UNIQUE constraint; enforce uniqueness of (${2}) in ELT or a check query (constraint ${1} dropped).\n\n",
        "ignore_case": true
      }
    },
    {
      "description": "CHECK constraints are unsupported in BigQuery: flag the ALTER ... WITH CHECK ADD CONSTRAINT ... CHECK batch.",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+\\s+WITH CHECK ADD\\s+CONSTRAINT (\\w+) CHECK\\s+(\\(.+\\))\\nGO\\n",
        "replace_with": "-- TODO(mog): BigQuery does not support CHECK constraints; enforce ${1} ${2} in ELT or a view (dropped).\n\n",
        "ignore_case": true
      }
    },
    {
      "description": "SSMS scripts column defaults as separate ALTER TABLE ADD CONSTRAINT DEFAULT batches. Flag each with the (already BigQuery-flavored) default expression to fold inline into the CREATE TABLE column as DEFAULT.",
      "action": "replace_regex",
      "options": {
        "find": "ALTER TABLE \\w+ ADD\\s+CONSTRAINT \\w+\\s+DEFAULT \\((.+)\\) FOR (\\w+)\\nGO\\n",
        "replace_with": "-- TODO(mog): fold DEFAULT ${1} inline onto column ${2} in the table definition (BigQuery has no ALTER ADD DEFAULT-constraint form).\n\n",
        "ignore_case": true
      }
    },
    {
      "section": "Finalize",
      "description": "BigQuery redeploy idiom: CREATE TABLE -> CREATE OR REPLACE TABLE (idempotent).",
      "action": "replace",
      "options": { "find": "CREATE TABLE ", "replace_with": "CREATE OR REPLACE TABLE ", "ignore_case": true }
    },
    {
      "description": "Turn each remaining GO batch separator into a statement terminator plus a blank line.",
      "action": "replace_regex",
      "options": { "find": "\\nGO\\n", "replace_with": ";\n\n", "ignore_case": true }
    },
    {
      "description": "Canonical whitespace finalize via the shared fragment: collapse double spaces left by dropped markers, tidy spaces before ';', strip trailing whitespace, and collapse blank-line runs.",
      "action": "run_mog",
      "options": {
        "file": "sql-finalize-whitespace.mog",
        "with": { "tidy_chars": ";" }
      }
    }
  ]
}
