{
  "name": "Redshift DDL to Postgres",
  "summary": "Convert a Redshift v_generate_tbl_ddl export to PostgreSQL DDL",
  "description": "Convert Redshift v_generate_tbl_ddl (or SHOW TABLE) output to PostgreSQL DDL. Redshift SQL is Postgres-derived, so the work is mostly removal: strips the --DROP/--WARNING comments and the ALTER TABLE ... owner to trailer, and removes ENCODE compression and the DISTSTYLE/DISTKEY/SORTKEY physical clauses (flagged), which have no Postgres equivalent. Types (BIGINT, VARCHAR, NUMERIC, CHAR, TIMESTAMP WITHOUT/WITH TIME ZONE) and quoted identifiers pass straight through. Dropped physical clauses are flagged inline as TODO(mog). Validated by executing the result in a real PostgreSQL engine.",
  "tags": ["sql", "redshift", "postgres", "convert", "migration"],
  "steps": [
    { "action": "eol_lf", "description": "Normalize to LF." },
    { "section": "Strip noise", "action": "replace_regex", "description": "Drop --DROP / --WARNING comment lines.",
      "options": { "find": "(?m)^--(?:DROP TABLE|WARNING).*$", "replace_with": "" } },
    { "section": "Strip noise", "action": "replace_regex", "description": "Drop the ALTER TABLE ... owner to trailer.",
      "options": { "find": "(?mi)^ALTER TABLE .* owner to .*$", "replace_with": "" } },
    { "section": "Physical clauses", "action": "replace_regex", "description": "Remove per-column ENCODE compression.",
      "options": { "find": "(?i) ENCODE \\w+", "replace_with": "" } },
    { "section": "Physical clauses", "action": "replace_regex", "description": "Drop DISTSTYLE (flagged).",
      "options": { "find": "(?mi)^DISTSTYLE \\w+.*$", "replace_with": "-- TODO(mog): dropped Redshift DISTSTYLE (no Postgres equivalent)" } },
    { "section": "Physical clauses", "action": "replace_regex", "description": "Drop DISTKEY (flagged).",
      "options": { "find": "(?mi)^\\s*DISTKEY\\s*\\([^)]*\\).*$", "replace_with": "-- TODO(mog): dropped Redshift DISTKEY" } },
    { "section": "Physical clauses", "action": "replace_regex", "description": "Drop the (multi-line) SORTKEY (flagged).",
      "options": { "find": "(?is)\\s*SORTKEY\\s*\\(.*?\\)", "replace_with": "\n-- TODO(mog): dropped Redshift SORTKEY" } },
    { "section": "Finalize", "action": "replace_regex", "description": "Collapse blank lines left behind.",
      "options": { "find": "\\n[ \\t]*(?:\\n[ \\t]*)+", "replace_with": "\n\n" } }
  ]
}
