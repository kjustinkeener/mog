{
  "name": "Databricks SHOW CREATE TABLE to Redshift",
  "summary": "Convert a Databricks/Spark table export to Redshift DDL",
  "description": "Convert Databricks 'SHOW CREATE TABLE' output to Redshift. Strips Delta/Spark export noise, reduces catalog.schema.table to the bare table, collapses nested ARRAY/MAP/STRUCT to SUPER (flagged), maps Spark scalars (STRING->VARCHAR(65535), LONG->BIGINT, SHORT->SMALLINT, BYTE->SMALLINT) and TIMESTAMP->TIMESTAMP.",
  "tags": [
    "sql",
    "databricks",
    "spark",
    "redshift",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-databricks-export-noise"
  ],
  "steps": [
    {
      "section": "Strip export noise",
      "action": "run_mog",
      "options": {
        "file": "strip-databricks-export-noise.mog"
      }
    },
    {
      "section": "Identifiers",
      "action": "replace_regex",
      "description": "Reduce catalog.schema.table to the bare table.",
      "options": {
        "find": "(?im)^(CREATE(?: OR REPLACE)? TABLE )\\w+\\.\\w+\\.(\\w+)",
        "replace_with": "$1$2"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "Collapse nested ARRAY/MAP/STRUCT<...> to SUPER (flagged).",
      "options": {
        "find": "\\b(?:ARRAY|MAP|STRUCT)\\s*<[^<>]*>",
        "replace_with": "SUPER"
      }
    },
    {
      "section": "Types",
      "action": "flag_matching",
      "description": "Flag SUPER columns collapsed from a nested type.",
      "options": {
        "pattern": "\\bSUPER\\b",
        "message": "collapsed from a Databricks nested type; element/field types were lost",
        "comment": "--",
        "tag": "TODO",
        "position": "inline"
      }
    },
    {
      "section": "Types",
      "action": "replace_regex",
      "description": "Spark TIMESTAMP -> TIMESTAMP.",
      "options": {
        "find": "\\bTIMESTAMP\\b",
        "replace_with": "TIMESTAMP"
      }
    },
    {
      "section": "Types",
      "action": "replace_map",
      "description": "Map Spark scalar types to Redshift.",
      "options": {
        "whole_word": true,
        "map": {
          "STRING": "VARCHAR(65535)",
          "LONG": "BIGINT",
          "SHORT": "SMALLINT",
          "BYTE": "SMALLINT"
        }
      }
    },
    {
      "section": "Comments",
      "action": "replace_regex",
      "description": "Drop the trailing table COMMENT.",
      "options": {
        "find": "(?m)^COMMENT '[^']*'",
        "replace_with": "-- TODO(mog): table comment dropped (use COMMENT ON in Redshift)"
      }
    }
  ]
}
