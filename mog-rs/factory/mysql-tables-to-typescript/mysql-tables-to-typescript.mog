{
  "name": "MySQL SHOW CREATE TABLE to TypeScript interfaces",
  "summary": "Generate TypeScript interfaces from MySQL SHOW CREATE TABLE output",
  "description": "Turn real MySQL 'SHOW CREATE TABLE' output into idiomatic TypeScript 'export interface' declarations, one interface per table, 2-space indented. Strips the MySQL storage rendering (backticks, ENGINE/CHARSET/COLLATE, DEFAULT NULL, ON UPDATE), drops the inline index and constraint lines (PRIMARY KEY, KEY, UNIQUE KEY, FULLTEXT KEY, CONSTRAINT, FOREIGN KEY), then rewrites each CREATE TABLE into an 'export interface' with one member per column. Member names keep the DB's snake_case exactly; only the interface name is PascalCased. MySQL types map to TypeScript types (tinyint(1)->boolean before the generic tinyint rule; tinyint/smallint/mediumint/int/integer/bigint with or without ' unsigned'->number; year->number; decimal/numeric/float/double/real->number; bit->boolean; char/varchar/tinytext/text/mediumtext/longtext->string; date/datetime/timestamp/time->string as ISO-8601 strings; binary/varbinary/tinyblob/blob/mediumblob/longblob->Uint8Array; json->unknown). Nullability is inferred: MySQL columns are nullable unless declared NOT NULL, so any column line lacking NOT NULL gets a '<type> | null' union (no optional '?'). The ' unsigned', CHARACTER SET, COLLATE, AUTO_INCREMENT and DEFAULT clauses are dropped. enum(...) and set(...) map to string and are flagged with a // TODO(mog): comment because their value set is lost. The TypeScript sibling of mysql-tables-to-csharp. Assumes LF.",
  "tags": [
    "sql",
    "mysql",
    "typescript",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-mysql-ddl-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove MySQL storage noise: backticks, ENGINE/CHARSET/COLLATE, DEFAULT NULL, ON UPDATE.",
      "options": {
        "file": "strip-mysql-ddl-noise.mog"
      }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop the SQL-comment TODO the strip fragment stamped for ON UPDATE (not valid TS).",
      "options": {
        "find": "(?m) *-- TODO\\(mog\\):[^\\n]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop per-column CHARACTER SET clause.",
      "options": {
        "find": "(?i) CHARACTER SET \\w+",
        "replace_with": ""
      }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop per-column COLLATE clause.",
      "options": {
        "find": "(?i) COLLATE \\w+",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only columns",
      "action": "replace_regex",
      "description": "Drop the inline PRIMARY KEY / UNIQUE KEY / FULLTEXT KEY / KEY / CONSTRAINT / FOREIGN KEY lines (whole line).",
      "options": {
        "find": "(?im)^\\s*(?:PRIMARY KEY|UNIQUE KEY|FULLTEXT KEY|KEY|CONSTRAINT|FOREIGN KEY)\\b.*\\n",
        "replace_with": ""
      }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Drop the MySQL AUTO_INCREMENT flag.",
      "options": {
        "find": "(?i) AUTO_INCREMENT\\b",
        "replace_with": ""
      }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Drop UNSIGNED / ZEROFILL numeric modifiers.",
      "options": {
        "find": "(?i) (?:unsigned|zerofill)\\b",
        "replace_with": ""
      }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Drop an explicit NULL nullability marker (leave NOT NULL intact).",
      "options": {
        "find": "(?i)(?<!NOT) NULL\\b",
        "replace_with": ""
      }
    },
    {
      "section": "Interface shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE TABLE <tbl> (' into a TypeScript interface header + opening brace.",
      "options": {
        "find": "(?m)^CREATE TABLE (?:\\w+\\.)?(\\w+) \\($",
        "replace_with": "export interface ${1} {"
      }
    },
    {
      "section": "Interface shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ')' into a closing brace.",
      "options": {
        "find": "(?m)^\\)$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines (literals, CURRENT_TIMESTAMP).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(  \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL enum columns (mapped to string; value set lost).",
      "options": {
        "pattern": "(?i)\\benum\\(",
        "comment": "//",
        "tag": "TODO",
        "message": "MySQL enum; consider a TS string-literal union.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL set columns (mapped to string; multi-value set lost).",
      "options": {
        "pattern": "(?i)\\bset\\(",
        "comment": "//",
        "tag": "TODO",
        "message": "MySQL set; comma-joined values, consider string[].",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tinyint(1) is MySQL's boolean -> boolean.",
      "options": { "find": "(?i)\\btinyint\\(1\\)", "replace_with": "boolean" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "integer family (tinyint/smallint/mediumint/int/integer/bigint) -> number.",
      "options": { "find": "(?i)\\b(?:tinyint|smallint|mediumint|integer|int|bigint)\\b(?:\\(\\d+\\))?", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "year -> number.",
      "options": { "find": "(?i)\\byear\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "decimal(p,s) / numeric(p,s) -> number.",
      "options": { "find": "(?i)\\b(?:decimal|numeric)\\(\\d+,\\s*\\d+\\)", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare decimal / numeric -> number.",
      "options": { "find": "(?i)\\b(?:decimal|numeric)(?:\\(\\d+\\))?", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "double / double precision -> number.",
      "options": { "find": "(?i)\\bdouble(?:\\s+precision)?(?:\\(\\d+,\\s*\\d+\\))?", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "float -> number.",
      "options": { "find": "(?i)\\bfloat(?:\\(\\d+(?:,\\s*\\d+)?\\))?", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "real -> number.",
      "options": { "find": "(?i)\\breal\\b", "replace_with": "number" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bit -> boolean.",
      "options": { "find": "(?i)\\bbit(?:\\(\\d+\\))?", "replace_with": "boolean" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "varchar(n) / char(n) -> string.",
      "options": { "find": "(?i)\\b(?:varchar|char)\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare varchar / char -> string.",
      "options": { "find": "(?i)\\b(?:varchar|char)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text family (tinytext/mediumtext/longtext/text) -> string.",
      "options": { "find": "(?i)\\b(?:tinytext|mediumtext|longtext|text)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "datetime -> string (ISO-8601).",
      "options": { "find": "(?i)\\bdatetime\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamp -> string (ISO-8601).",
      "options": { "find": "(?i)\\btimestamp\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "date -> string (ISO-8601, runs after datetime).",
      "options": { "find": "(?i)\\bdate\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "time -> string (ISO-8601, runs after datetime/timestamp).",
      "options": { "find": "(?i)\\btime\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "enum(...) -> string (flagged above).",
      "options": { "find": "(?i)\\benum\\([^)]*\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "set(...) -> string (flagged above).",
      "options": { "find": "(?i)\\bset\\([^)]*\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "varbinary(n) / binary(n) / bare -> Uint8Array.",
      "options": { "find": "(?i)\\b(?:varbinary|binary)(?:\\(\\d+\\))?", "replace_with": "Uint8Array" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "blob family (tinyblob/mediumblob/longblob/blob) -> Uint8Array.",
      "options": { "find": "(?i)\\b(?:tinyblob|mediumblob|longblob|blob)\\b", "replace_with": "Uint8Array" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "json -> unknown.",
      "options": { "find": "(?i)\\bjson\\b", "replace_with": "unknown" }
    },
    {
      "section": "Members",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a TypeScript member with a '| null' union.",
      "options": {
        "find": "(?m)^(  )(\\w+) (\\S+)@@N@@( // .*)?$",
        "replace_with": "${1}${2}: ${3} | null;${4}"
      }
    },
    {
      "section": "Members",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a TypeScript member.",
      "options": {
        "find": "(?m)^(  )(\\w+) (\\S+)( // .*)?$",
        "replace_with": "${1}${2}: ${3};${4}"
      }
    },
    {
      "section": "Members",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": { "find": "@@N@@", "replace_with": "" }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each interface name (the table identifier); members keep snake_case.",
      "only_lines_matching": "^export interface ",
      "scope": { "field": { "index": 3, "delimiter": " " } }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between interfaces.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": { "find": "\\A\\n+", "replace_with": "" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": { "find": "\\n\\s*\\z", "replace_with": "\n" }
    }
  ]
}
