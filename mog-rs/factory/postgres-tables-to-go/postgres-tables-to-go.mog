{
  "name": "pg_dump (Postgres) tables to Go structs",
  "summary": "Generate Go structs (with db tags) from pg_dump --schema-only output",
  "description": "Generate idiomatic Go type declarations from a real 'pg_dump --schema-only' export, one 'type <Table> struct' per table. Discards every non-table statement (sequences, indexes, triggers, views, ALTERs), then rewrites each CREATE TABLE into a struct with one exported field per column. Field names are PascalCased for export, with the exact database column name preserved losslessly in a `db:\"...\"` struct tag (compatible with sqlx / pgx). Postgres types map to Go types (smallint->int16, integer/serial->int32, bigint/bigserial->int64, real->float32, double precision->float64, boolean->bool, character varying/char/text/uuid->string, timestamp/timestamptz/date/time->time.Time, bytea->[]byte, json/jsonb->json.RawMessage). numeric/decimal map to string (Go has no native decimal) and are flagged. Nullable columns (no NOT NULL) become pointer types (*T); nilable types (slices, json.RawMessage) stay as-is. Types with no clean Go equivalent (enum -> string, text[] -> []string, tsvector -> string) map to a best-effort type flagged inline with a // TODO(mog): comment. Emits the struct declarations only: add your own 'package' clause and imports (time, encoding/json), then run gofmt to align fields. Assumes LF.",
  "tags": [
    "sql",
    "postgres",
    "go",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-pgdump-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Remove pg_dump banners, SET block, restrict directives and object comments.",
      "options": {
        "file": "strip-pgdump-noise.mog"
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE SEQUENCE statements (multi-line, to the first ';').",
      "options": {
        "find": "(?ms)^CREATE SEQUENCE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER SEQUENCE statements.",
      "options": {
        "find": "(?ms)^ALTER SEQUENCE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop ALTER TABLE statements (constraints, defaults, foreign keys).",
      "options": {
        "find": "(?ms)^ALTER TABLE\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE INDEX statements.",
      "options": {
        "find": "(?m)^CREATE (?:UNIQUE )?INDEX\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE TRIGGER statements.",
      "options": {
        "find": "(?m)^CREATE TRIGGER\\b.*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Drop CREATE VIEW / MATERIALIZED VIEW statements.",
      "options": {
        "find": "(?ms)^CREATE (?:MATERIALIZED )?VIEW\\b.*?;[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Keep only tables",
      "action": "replace_regex",
      "description": "Collapse the blank lines the removals left behind.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Struct shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE TABLE public.<tbl> (' into a Go struct header + opening brace.",
      "options": {
        "find": "(?m)^CREATE TABLE (?:public\\.)?(\\w+) \\($",
        "replace_with": "type ${1} struct {"
      }
    },
    {
      "section": "Struct shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ');' into a closing brace.",
      "options": {
        "find": "(?m)^\\);$",
        "replace_with": "}"
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines (nextval, now(), literals).",
      "options": {
        "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)",
        "replace_with": ""
      }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": {
        "find": "(?m),[ \\t]*$",
        "replace_with": ""
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (any column line NOT ending in NOT NULL) with a sentinel.",
      "options": {
        "find": "(?m)^(    \\w[^\\n]*?)(?<! NOT NULL)$",
        "replace_with": "${1}@@N@@"
      }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": {
        "find": "(?m) NOT NULL$",
        "replace_with": ""
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres enum columns (public.<type>): mapped to string.",
      "options": {
        "pattern": "\\bpublic\\.\\w+",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres enum; represented as string in Go (define a named type + constants if you need type safety).",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres array columns: mapped to a Go slice.",
      "options": {
        "pattern": "\\w\\[\\]",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres array; mapped to a Go slice -- verify the element type.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres tsvector columns: mapped to string.",
      "options": {
        "pattern": "\\btsvector\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres full-search vector; stored as string, not searchable in Go.",
        "position": "inline"
      }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag Postgres numeric/decimal columns: mapped to string.",
      "options": {
        "pattern": "\\b(?:numeric|decimal)\\b",
        "comment": "//",
        "tag": "TODO",
        "message": "Postgres exact-precision column; mapped to a Go string (no native fixed-point) -- parse with a fixed-point library for arithmetic.",
        "position": "inline"
      }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character varying(n) -> string.",
      "options": { "find": "(?i)\\bcharacter varying\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character varying / varchar -> string.",
      "options": { "find": "(?i)\\b(?:character varying|varchar)(?:\\(\\d+\\))?", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "character(n) / char(n) -> string.",
      "options": { "find": "(?i)\\b(?:character|char|bpchar)\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare character / char / bpchar -> string.",
      "options": { "find": "(?i)\\b(?:character|bpchar|char)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamp with/without time zone -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\btimestamp(?: with(?:out)? time zone| without time zone)?\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamptz -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\btimestamptz\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "time with/without time zone / timetz / time -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\b(?:time(?: with(?:out)? time zone)?|timetz)\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "double precision -> float64.",
      "options": { "find": "(?i)\\bdouble precision\\b", "replace_with": "float64" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "numeric(p,s) / decimal(p,s) -> string (flagged above).",
      "options": { "find": "(?i)\\b(?:numeric|decimal)\\(\\d+,\\s*\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare numeric / decimal -> string (flagged above).",
      "options": { "find": "(?i)\\b(?:numeric|decimal)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bigserial / bigint -> int64.",
      "options": { "find": "(?i)\\b(?:bigserial|bigint)\\b", "replace_with": "int64" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "smallserial / smallint -> int16.",
      "options": { "find": "(?i)\\b(?:smallserial|smallint)\\b", "replace_with": "int16" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "serial / integer / int -> int32.",
      "options": { "find": "(?i)\\b(?:serial|integer|int)\\b", "replace_with": "int32" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "boolean / bool -> bool.",
      "options": { "find": "(?i)\\b(?:boolean|bool)\\b", "replace_with": "bool" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "real -> float32.",
      "options": { "find": "(?i)\\breal\\b", "replace_with": "float32" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare double -> float64.",
      "options": { "find": "(?i)\\bdouble\\b", "replace_with": "float64" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Postgres enum reference (public.<type>) -> string (flagged above).",
      "options": { "find": "(?i)\\bpublic\\.\\w+", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text[] array -> []string (flagged above).",
      "options": { "find": "(?i)\\btext\\[\\]", "replace_with": "[]string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tsvector -> string (flagged above).",
      "options": { "find": "(?i)\\btsvector\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text -> string.",
      "options": { "find": "(?i)\\btext\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "uuid -> string.",
      "options": { "find": "(?i)\\buuid\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bytea -> []byte.",
      "options": { "find": "(?i)\\bbytea\\b", "replace_with": "[]byte" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "date -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\bdate\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "jsonb / json -> json.RawMessage.",
      "options": { "find": "(?i)\\bjsonb?\\b", "replace_with": "json.RawMessage" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the time sentinel to time.Time (kept separate to avoid re-matching the 'time' keyword).",
      "options": { "find": "@@GODT@@", "replace_with": "time.Time" }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a pointer-typed Go field carrying a db tag placeholder.",
      "options": {
        "find": "(?m)^    (\\w+) (\\S+)@@N@@(.*)$",
        "replace_with": "    ${1} *${2} @@DB@@${1}@@${3}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a Go field carrying a db tag placeholder.",
      "options": {
        "find": "(?m)^    (\\w+) (\\S+)( // .*)?$",
        "replace_with": "    ${1} ${2} @@DB@@${1}@@${3}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Nilable types (slices, json.RawMessage) don't need a pointer for nullability -- drop it.",
      "options": {
        "find": "\\*(\\[\\]\\w+|json\\.RawMessage)",
        "replace_with": "${1}"
      }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": { "find": "@@N@@", "replace_with": "" }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each struct name (the table identifier).",
      "only_lines_matching": "^type ",
      "scope": { "field": { "index": 2, "delimiter": " " } }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each field name (the column identifier); the db tag keeps the exact column name.",
      "only_lines_matching": "^    \\w",
      "scope": { "field": { "index": 5, "delimiter": " " } }
    },
    {
      "section": "Tags",
      "action": "replace_regex",
      "description": "Resolve the db tag placeholder into a real Go struct tag.",
      "options": {
        "find": "@@DB@@(\\w+)@@",
        "replace_with": "`db:\"${1}\"`"
      }
    },
    {
      "section": "Tags",
      "action": "replace_regex",
      "description": "Convert the 4-space column indent to a tab (Go convention).",
      "options": {
        "find": "(?m)^    ",
        "replace_with": "\t"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between structs.",
      "options": {
        "find": "\\n[ \\t]*(?:\\n[ \\t]*)+",
        "replace_with": "\n\n"
      }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": { "find": "\\A\\n+", "replace_with": "" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": { "find": "\\n\\s*\\z", "replace_with": "\n" }
    }
  ]
}
