{
  "name": "kebab-case to snake_case",
  "description": "Convert kebab-case identifiers to snake_case by turning each hyphen between two alphanumerics into an underscore. A spaced dash (a - b) or a leading/standalone hyphen is left alone. Best on a list or column of identifiers.",
  "summary": "Convert kebab-case identifiers to snake_case",
  "tags": [
    "case",
    "identifier",
    "codemod",
    "convert"
  ],
  "steps": [
    {
      "action": "replace_regex",
      "description": "Hyphen between alphanumerics -> underscore (pass 1)",
      "options": {
        "find": "([A-Za-z0-9])-([A-Za-z0-9])",
        "replace_with": "${1}_${2}"
      }
    },
    {
      "action": "replace_regex",
      "description": "Again, to catch adjacent segments the first pass skipped",
      "options": {
        "find": "([A-Za-z0-9])-([A-Za-z0-9])",
        "replace_with": "${1}_${2}"
      }
    }
  ]
}
