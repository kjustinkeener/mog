{
  "name": "De-duplicate multi-line records",
  "summary": "Drop duplicate blank-line-separated blocks, keep first",
  "description": "Remove duplicate multi-line records (blocks separated by a blank line), keeping the first occurrence of each. Compares whole blocks by default; here it keys on the first line so records with the same header collapse.",
  "tags": [
    "line",
    "dedupe",
    "fragment",
    "records"
  ],
  "steps": [
    {
      "action": "dedupe_blocks",
      "description": "Drop duplicate blocks, key on first line",
      "options": {
        "by": "first_line"
      }
    }
  ]
}
