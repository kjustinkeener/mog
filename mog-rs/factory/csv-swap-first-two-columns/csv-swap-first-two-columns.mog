{
  "name": "Swap the first two CSV columns",
  "description": "Reorder a CSV so column 2 comes before column 1, keeping columns 3+ in place (quote-aware). Handy for fixing a last-name,first-name vs first-name,last-name mismatch. Change the fields option on the step for a different reorder.",
  "summary": "Swap the first two CSV columns",
  "tags": [
    "csv",
    "column",
    "sort",
    "replace",
    "data"
  ],
  "steps": [
    {
      "action": "cut_fields",
      "description": "Emit columns in the order 2, 1, 3",
      "options": { "fields": "2,1,3" }
    }
  ]
}
