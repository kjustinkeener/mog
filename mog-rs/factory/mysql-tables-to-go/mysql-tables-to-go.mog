{
  "name": "MySQL SHOW CREATE tables to Go structs",
  "summary": "Generate Go structs (with db tags) from MySQL SHOW CREATE TABLE output",
  "description": "Turn real 'SHOW CREATE TABLE' / mysqldump DDL into idiomatic Go type declarations, one 'type <Table> struct' per table. Strips the MySQL plumbing (ENGINE/CHARSET/COLLATE, backtick quoting, AUTO_INCREMENT, unsigned/zerofill), drops key and constraint lines, then rewrites each CREATE TABLE into a struct with one exported field per column. Field names are PascalCased for export, and the EXACT database column name is preserved losslessly in a `db:\"...\"` struct tag (compatible with sqlx / pgx). MySQL types map to Go types (tinyint(1)->bool, tinyint->int8, smallint/year->int16, mediumint/int->int32, bigint->int64, float->float32, double->float64, char/varchar/text->string, datetime/timestamp/date/time->time.Time, blob/binary->[]byte, json->json.RawMessage). decimal/numeric map to string (Go has no native decimal) and are flagged. Nullable columns become pointer types (*T); nilable types (slices, json.RawMessage) stay as-is. enum/set map to a best-effort string and are flagged inline with a // TODO(mog): comment. Emits the struct declarations only -- add your own 'package' clause and imports (time, encoding/json), then run gofmt to align fields. The Go sibling of mysql-tables-to-typescript. Assumes LF.",
  "tags": [
    "sql",
    "mysql",
    "go",
    "codegen",
    "convert",
    "migration"
  ],
  "dependencies": [
    "strip-mysql-ddl-noise"
  ],
  "steps": [
    {
      "section": "Strip",
      "action": "run_mog",
      "description": "Strip mysqldump / SHOW CREATE noise (ENGINE, backtick quoting, AUTO_INCREMENT, unsigned).",
      "options": { "file": "strip-mysql-ddl-noise.mog" }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Remove any leftover mog TODO markers from the strip fragment.",
      "options": { "find": "(?m) *-- TODO\\(mog\\):[^\\n]*$", "replace_with": "" }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop column-level CHARACTER SET clauses.",
      "options": { "find": "(?i) CHARACTER SET \\w+", "replace_with": "" }
    },
    {
      "section": "Strip",
      "action": "replace_regex",
      "description": "Drop column-level COLLATE clauses.",
      "options": { "find": "(?i) COLLATE \\w+", "replace_with": "" }
    },
    {
      "section": "Keep only columns",
      "action": "replace_regex",
      "description": "Drop key / constraint lines (PRIMARY KEY, UNIQUE KEY, KEY, FOREIGN KEY, CONSTRAINT).",
      "options": { "find": "(?im)^\\s*(?:PRIMARY KEY|UNIQUE KEY|FULLTEXT KEY|KEY|CONSTRAINT|FOREIGN KEY)\\b.*\\n", "replace_with": "" }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Remove AUTO_INCREMENT.",
      "options": { "find": "(?i) AUTO_INCREMENT\\b", "replace_with": "" }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Remove unsigned / zerofill numeric modifiers.",
      "options": { "find": "(?i) (?:unsigned|zerofill)\\b", "replace_with": "" }
    },
    {
      "section": "Column cleanup",
      "action": "replace_regex",
      "description": "Remove a bare NULL marker (keep NOT NULL).",
      "options": { "find": "(?i)(?<!NOT) NULL\\b", "replace_with": "" }
    },
    {
      "section": "Struct shell",
      "action": "replace_regex",
      "description": "Rewrite each 'CREATE TABLE <tbl> (' into a Go struct header + opening brace.",
      "options": { "find": "(?m)^CREATE TABLE (?:\\w+\\.)?(\\w+) \\($", "replace_with": "type ${1} struct {" }
    },
    {
      "section": "Struct shell",
      "action": "replace_regex",
      "description": "Rewrite each table-closing ')' into a closing brace.",
      "options": { "find": "(?m)^\\)$", "replace_with": "}" }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop DEFAULT clauses from column lines.",
      "options": { "find": "(?im)\\s+DEFAULT\\s+.+?(?=(?:\\s+NOT\\s+NULL)?,?\\s*$)", "replace_with": "" }
    },
    {
      "section": "Columns",
      "action": "replace_regex",
      "description": "Drop trailing commas that separated columns.",
      "options": { "find": "(?m),[ \\t]*$", "replace_with": "" }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Mark nullable columns (2-space indent, NOT ending in NOT NULL) with a sentinel.",
      "options": { "find": "(?m)^(  \\w[^\\n]*?)(?<! NOT NULL)$", "replace_with": "${1}@@N@@" }
    },
    {
      "section": "Nullability",
      "action": "replace_regex",
      "description": "Remove the NOT NULL constraint marker from non-nullable columns.",
      "options": { "find": "(?m) NOT NULL$", "replace_with": "" }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL enum columns.",
      "options": { "pattern": "(?i)\\benum\\(", "comment": "//", "tag": "TODO", "message": "MySQL enum; represented as a Go string (define named constants if you need type safety).", "position": "inline" }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL set columns.",
      "options": { "pattern": "(?i)\\bset\\(", "comment": "//", "tag": "TODO", "message": "MySQL set; comma-joined values in one Go string -- split on ',' or model as a slice.", "position": "inline" }
    },
    {
      "section": "Flag exotic types",
      "action": "flag_matching",
      "description": "Flag MySQL decimal/numeric columns.",
      "options": { "pattern": "(?i)\\b(?:decimal|numeric)\\b", "comment": "//", "tag": "TODO", "message": "MySQL exact-precision column; mapped to a Go string (no native fixed-point) -- parse with a fixed-point library for arithmetic.", "position": "inline" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tinyint(1) -> bool.",
      "options": { "find": "(?i)\\btinyint\\(1\\)", "replace_with": "bool" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bigint -> int64.",
      "options": { "find": "(?i)\\bbigint\\b(?:\\(\\d+\\))?", "replace_with": "int64" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "smallint -> int16.",
      "options": { "find": "(?i)\\bsmallint\\b(?:\\(\\d+\\))?", "replace_with": "int16" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "mediumint -> int32.",
      "options": { "find": "(?i)\\bmediumint\\b(?:\\(\\d+\\))?", "replace_with": "int32" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "tinyint -> int8.",
      "options": { "find": "(?i)\\btinyint\\b(?:\\(\\d+\\))?", "replace_with": "int8" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "integer / int -> int32.",
      "options": { "find": "(?i)\\b(?:integer|int)\\b(?:\\(\\d+\\))?", "replace_with": "int32" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "year -> int16.",
      "options": { "find": "(?i)\\byear\\b", "replace_with": "int16" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "decimal/numeric(p,s) -> string (flagged above).",
      "options": { "find": "(?i)\\b(?:decimal|numeric)\\(\\d+,\\s*\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare decimal/numeric -> string (flagged above).",
      "options": { "find": "(?i)\\b(?:decimal|numeric)(?:\\(\\d+\\))?", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "double / double precision -> float64.",
      "options": { "find": "(?i)\\bdouble(?:\\s+precision)?(?:\\(\\d+,\\s*\\d+\\))?", "replace_with": "float64" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "float -> float32.",
      "options": { "find": "(?i)\\bfloat(?:\\(\\d+(?:,\\s*\\d+)?\\))?", "replace_with": "float32" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "real -> float64.",
      "options": { "find": "(?i)\\breal\\b", "replace_with": "float64" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bit -> []byte.",
      "options": { "find": "(?i)\\bbit(?:\\(\\d+\\))?", "replace_with": "[]byte" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "varchar/char(n) -> string.",
      "options": { "find": "(?i)\\b(?:varchar|char)\\(\\d+\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "bare varchar/char -> string.",
      "options": { "find": "(?i)\\b(?:varchar|char)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "text family -> string.",
      "options": { "find": "(?i)\\b(?:tinytext|mediumtext|longtext|text)\\b", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "datetime -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\bdatetime\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "timestamp -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\btimestamp\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "date -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\bdate\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "time -> time.Time (via sentinel).",
      "options": { "find": "(?i)\\btime\\b", "replace_with": "@@GODT@@" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "enum(...) -> string (flagged above).",
      "options": { "find": "(?i)\\benum\\([^)]*\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "set(...) -> string (flagged above).",
      "options": { "find": "(?i)\\bset\\([^)]*\\)", "replace_with": "string" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "varbinary/binary -> []byte.",
      "options": { "find": "(?i)\\b(?:varbinary|binary)(?:\\(\\d+\\))?", "replace_with": "[]byte" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "blob family -> []byte.",
      "options": { "find": "(?i)\\b(?:tinyblob|mediumblob|longblob|blob)\\b", "replace_with": "[]byte" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "json -> json.RawMessage.",
      "options": { "find": "(?i)\\bjson\\b", "replace_with": "json.RawMessage" }
    },
    {
      "section": "Type map",
      "action": "replace_regex",
      "description": "Resolve the time sentinel to time.Time (kept separate to avoid re-matching the 'time' keyword).",
      "options": { "find": "@@GODT@@", "replace_with": "time.Time" }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite nullable columns into a pointer-typed Go field carrying a db tag placeholder.",
      "options": { "find": "(?m)^(  )(\\w+) (\\S+)@@N@@( // .*)?$", "replace_with": "${1}${2} *${3} @@DB@@${2}@@${4}" }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Rewrite non-nullable columns into a Go field carrying a db tag placeholder.",
      "options": { "find": "(?m)^(  )(\\w+) (\\S+)( // .*)?$", "replace_with": "${1}${2} ${3} @@DB@@${2}@@${4}" }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Nilable types (slices, json.RawMessage) don't need a pointer for nullability -- drop it.",
      "options": { "find": "\\*(\\[\\]\\w+|json\\.RawMessage)", "replace_with": "${1}" }
    },
    {
      "section": "Fields",
      "action": "replace_regex",
      "description": "Safety: strip any leftover nullability sentinel.",
      "options": { "find": "@@N@@", "replace_with": "" }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each struct name (the table identifier).",
      "only_lines_matching": "^type ",
      "scope": { "field": { "index": 2, "delimiter": " " } }
    },
    {
      "section": "PascalCase",
      "action": "to_pascal",
      "description": "PascalCase each field name (the column identifier); the db tag keeps the exact column name.",
      "only_lines_matching": "^  \\w",
      "scope": { "field": { "index": 3, "delimiter": " " } }
    },
    {
      "section": "Tags",
      "action": "replace_regex",
      "description": "Resolve the db tag placeholder into a real Go struct tag.",
      "options": { "find": "@@DB@@(\\w+)@@", "replace_with": "`db:\"${1}\"`" }
    },
    {
      "section": "Tags",
      "action": "replace_regex",
      "description": "Convert the 2-space column indent to a tab (Go convention).",
      "options": { "find": "(?m)^  ", "replace_with": "\t" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Collapse multiple blank lines to a single blank between structs.",
      "options": { "find": "\\n[ \\t]*(?:\\n[ \\t]*)+", "replace_with": "\n\n" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim leading blank lines.",
      "options": { "find": "\\A\\n+", "replace_with": "" }
    },
    {
      "section": "Tidy",
      "action": "replace_regex",
      "description": "Trim trailing blank lines to a single final newline.",
      "options": { "find": "\\n\\s*\\z", "replace_with": "\n" }
    }
  ]
}
