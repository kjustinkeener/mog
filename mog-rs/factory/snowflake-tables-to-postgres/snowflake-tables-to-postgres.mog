{
  "name": "Snowflake GET_DDL to Postgres",
  "summary": "Convert a Snowflake GET_DDL table export to PostgreSQL DDL",
  "description": "Convert Snowflake GET_DDL('TABLE', ...) output to PostgreSQL DDL. Drops the trailing semicolon and the Snowflake-only cluster-by (flagged), table-comment, and column-comment renderings, rewrites autoincrement to a Postgres identity column, maps types (NUMBER(38,0)->BIGINT, NUMBER(p,s)->NUMERIC(p,s), VARIANT->JSONB, TIMESTAMP_NTZ->TIMESTAMP, TIMESTAMP_TZ/LTZ->TIMESTAMPTZ), and rewrites CREATE OR REPLACE TABLE to CREATE TABLE (Postgres has none). Not a semantic transpiler; leaves TODO(mog) markers where a construct needs manual review.",
  "tags": ["sql", "snowflake", "postgres", "warehouse", "convert", "migration"],
  "steps": [
    { "action": "eol_lf", "description": "Normalize to LF." },
    { "action": "replace", "description": "Drop statement terminators.", "options": { "find": ";", "replace_with": "" } },
    { "section": "Physical clauses", "action": "replace_regex", "description": "Snowflake cluster by -> flag (Postgres CLUSTER is a maintenance command).",
      "options": { "find": "(?mi)^cluster by \\(([^)]*)\\)", "replace_with": "-- TODO(mog): dropped Snowflake CLUSTER BY ($1) (no direct Postgres table-DDL equivalent)" } },
    { "section": "Columns", "action": "replace_regex", "description": "Snowflake autoincrement -> Postgres identity.",
      "options": { "find": "(?i)autoincrement start \\d+ increment \\d+", "replace_with": "GENERATED BY DEFAULT AS IDENTITY" } },
    { "section": "Columns", "action": "replace_regex", "description": "Drop inline column COMMENT 'x' (Postgres uses COMMENT ON).",
      "options": { "find": " COMMENT '[^']*'", "replace_with": "" } },
    { "section": "Columns", "action": "replace_regex", "description": "Drop the glued table )COMMENT='x'.",
      "options": { "find": "\\)COMMENT='[^']*'", "replace_with": ")" } },
    { "section": "Types", "action": "replace_regex", "description": "VARIANT -> JSONB.",
      "options": { "find": "\\bVARIANT\\b", "replace_with": "JSONB" } },
    { "section": "Types", "action": "replace_regex", "description": "NUMBER(38,0) -> BIGINT.",
      "options": { "find": "\\bNUMBER\\(38,\\s*0\\)", "replace_with": "BIGINT" } },
    { "section": "Types", "action": "replace_regex", "description": "NUMBER(p,s) -> NUMERIC(p,s).",
      "options": { "find": "\\bNUMBER\\(", "replace_with": "NUMERIC(" } },
    { "section": "Types", "action": "replace_regex", "description": "Bare NUMBER -> BIGINT.",
      "options": { "find": "\\bNUMBER\\b", "replace_with": "BIGINT" } },
    { "section": "Types", "action": "replace_regex", "description": "TIMESTAMP_NTZ(n) -> TIMESTAMP.",
      "options": { "find": "\\bTIMESTAMP_NTZ(\\(\\d+\\))?", "replace_with": "TIMESTAMP" } },
    { "section": "Types", "action": "replace_regex", "description": "TIMESTAMP_TZ / TIMESTAMP_LTZ -> TIMESTAMPTZ.",
      "options": { "find": "\\bTIMESTAMP_(?:LTZ|TZ)(\\(\\d+\\))?", "replace_with": "TIMESTAMPTZ" } },
    { "section": "Statement", "action": "replace", "description": "Postgres has no CREATE OR REPLACE TABLE.",
      "options": { "find": "create or replace TABLE ", "replace_with": "CREATE TABLE " } }
  ]
}
