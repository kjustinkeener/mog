{
  "name": "MySQL (mysqldump) to PostgreSQL",
  "description": "Convert a mysqldump table-DDL export into PostgreSQL DDL. Strips dump scaffolding, rewrites backtick quoting, MySQL types, AUTO_INCREMENT, ENUM/SET, and lifts inline KEY/UNIQUE/FULLTEXT indexes into standalone CREATE INDEX statements. Text/regex based; views, routines, triggers, and data are stripped (out of scope). See docs/mysql-to-pgsql.md for limits.",
  "steps": [
    {
      "description": "Strip mysqldump scaffolding (comments, DELIMITER/LOCK/view blocks, SET/USE/DROP). Leaves CREATE TABLE blocks.",
      "action": "run_mog",
      "options": { "file": "mysql-strip-dump-noise.mog" }
    },
    {
      "description": "Remove backtick identifier quoting.",
      "action": "replace",
      "options": { "find": "`", "replace_with": "" }
    },
    {
      "description": "Drop the table-options tail: ) ENGINE=... AUTO_INCREMENT=... CHARSET=... COLLATE... COMMENT... ; -> );",
      "action": "replace_regex",
      "options": { "find": "\\) ENGINE=[^;]*;", "replace_with": ");", "ignore_case": true }
    },
    {
      "description": "Drop MySQL charset introducers on literals (e.g. in generated-column expressions).",
      "action": "replace",
      "options": { "find": "_utf8mb4", "replace_with": "" }
    },
    {
      "description": "Drop ON UPDATE CURRENT_TIMESTAMP (no Postgres equivalent; needs a trigger, see docs).",
      "action": "replace",
      "options": { "find": " ON UPDATE CURRENT_TIMESTAMP", "replace_with": "", "ignore_case": true }
    },
    {
      "description": "AUTO_INCREMENT column -> GENERATED BY DEFAULT AS IDENTITY.",
      "action": "replace",
      "options": { "find": "AUTO_INCREMENT", "replace_with": "GENERATED BY DEFAULT AS IDENTITY", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "Drop 'unsigned' (Postgres has no unsigned integers; the range widens, see docs).",
      "action": "replace",
      "options": { "find": "unsigned", "replace_with": "", "whole_word": true, "ignore_case": true }
    },
    {
      "description": "Type: tinyint(1) -> boolean.",
      "action": "replace",
      "options": { "find": "tinyint(1)", "replace_with": "boolean", "ignore_case": true }
    },
    {
      "description": "Type: bare tinyint -> smallint.",
      "action": "replace_regex",
      "options": { "find": "\\btinyint\\b", "replace_with": "smallint", "ignore_case": true }
    },
    {
      "description": "Type: mediumtext/longtext/tinytext -> text.",
      "action": "replace_regex",
      "options": { "find": "\\b(?:medium|long|tiny)text\\b", "replace_with": "text", "ignore_case": true }
    },
    {
      "description": "Type: blob family -> bytea.",
      "action": "replace_regex",
      "options": { "find": "\\b(?:medium|long|tiny)?blob\\b", "replace_with": "bytea", "ignore_case": true }
    },
    {
      "description": "Type: double -> double precision.",
      "action": "replace_regex",
      "options": { "find": "\\bdouble\\b", "replace_with": "double precision", "ignore_case": true }
    },
    {
      "description": "Type: datetime -> timestamp.",
      "action": "replace_regex",
      "options": { "find": "\\bdatetime\\b", "replace_with": "timestamp", "ignore_case": true }
    },
    {
      "description": "Type: json -> jsonb.",
      "action": "replace_regex",
      "options": { "find": "\\bjson\\b", "replace_with": "jsonb", "ignore_case": true }
    },
    {
      "description": "ENUM -> varchar with an inline CHECK (the column name is captured and reused).",
      "action": "replace_regex",
      "options": { "find": "(\\w+) enum\\(([^)]*)\\)", "replace_with": "${1} varchar CHECK (${1} IN (${2}))", "ignore_case": true }
    },
    {
      "description": "SET -> text (Postgres has no SET type; multi-value semantics are lost, see docs).",
      "action": "replace_regex",
      "options": { "find": "\\bset\\(([^)]*)\\)", "replace_with": "text", "ignore_case": true }
    },
    {
      "description": "Lift inline UNIQUE KEY definitions out to standalone CREATE UNIQUE INDEX after the table.",
      "action": "hoist_from_block",
      "options": {
        "block_start": "CREATE TABLE (\\w+) \\(",
        "block_end": "^\\);",
        "extract": "^\\s*UNIQUE KEY (\\w+) \\(([^)]*)\\),?",
        "emit_after": "CREATE UNIQUE INDEX ${1} ON ${b1} (${2});"
      }
    },
    {
      "description": "Lift inline KEY / FULLTEXT KEY definitions out to standalone CREATE INDEX after the table (FULLTEXT becomes a plain index; use GIN/tsvector by hand, see docs).",
      "action": "hoist_from_block",
      "options": {
        "block_start": "CREATE TABLE (\\w+) \\(",
        "block_end": "^\\);",
        "extract": "^\\s*(?:FULLTEXT )?KEY (\\w+) \\(([^)]*)\\),?",
        "emit_after": "CREATE INDEX ${1} ON ${b1} (${2});"
      }
    },
    {
      "description": "Flag STORED generated columns: Postgres requires an IMMUTABLE expression, and MySQL functions like concat_ws are only STABLE.",
      "action": "flag_matching",
      "options": { "pattern": "GENERATED ALWAYS AS .* STORED", "message": "generated expression must be IMMUTABLE for Postgres (e.g. rewrite concat_ws with ||)", "comment": "--" }
    },
    {
      "description": "Collapse the double spaces left by dropping 'unsigned' etc. (keeps indentation).",
      "action": "squeeze_spaces"
    },
    {
      "description": "Tidy any space before a comma or semicolon.",
      "action": "replace_regex",
      "options": { "find": " +([,;])", "replace_with": "${1}" }
    },
    {
      "description": "Remove trailing whitespace.",
      "action": "trim_whitespace_right"
    },
    {
      "description": "Collapse runs of blank lines.",
      "action": "squeeze_blank_lines"
    }
  ]
}
